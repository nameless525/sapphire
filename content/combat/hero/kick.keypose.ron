                LeftIndexDistal: (z: -50),
                LeftMiddleProximal: (z: -72),
                LeftMiddleIntermediate: (z: -82),
                LeftMiddleDistal: (z: -50),
                LeftRingProximal: (z: -74),
                LeftRingIntermediate: (z: -82),
