// The proving hub's character light rigs (M5 M6): the look-dev stage's (`content/lookdev/lookdev_light_rigs.ron`,
// which says what each field does), with the gameplay rig's camera rim taking all of the rim's gating and the
// rim itself a little stronger, as dusk's backlit silhouettes read in the reference games. A `LightRigLibrary`
// document (`sapphire_world::light_rig`) that `proving_hub.zone.ron` names. The cooker reads it through the
// zone: no importer reads a bare `.ron`.
//
// Every number is a starting point for art direction, not a measurement.
(
    type: "sapphire::world::LightRigLibrary",
    version: 1,
    data: (
        rigs: [
            (
                name: "gameplay",
                rig: (
                    key: (
                        min_elevation: 5.0,
                        max_elevation: 65.0,
                        max_azimuth: 120.0,
                    ),
                    gi: (
                        camera_bias: 0.3,
                        max_saturation: 0.6,
                        max_value: Some(0.5),
                        skin_tint: (1.12, 0.96, 0.86),
                    ),
                    rim: 1.2,
                    camera_rim: (share: 1.0, direction: (azimuth: 180.0, elevation: 30.0)),
                ),
            ),
            (
                name: "portrait",
                rig: (
                    key: (
                        camera_follow: 1.0,
                        camera_direction: (azimuth: -35.0, elevation: 30.0),
                    ),
                    gi: (
                        camera_bias: 0.6,
                        max_saturation: 0.5,
                        max_value: Some(0.5),
                        skin_tint: (1.12, 0.96, 0.86),
                    ),
                    rim: 0.8,
                    local_light_ceiling: 1.5,
                    camera_rim: (share: 0.75, direction: (azimuth: 180.0, elevation: 30.0)),
                ),
            ),
        ],
    ),
)
