// An ambient figure of the benchmark's crowd (M5 B3): a dock hand in a short ochre jacket over a shirt, rolled trousers and a flat cap. One material, at the
// crowd's row of about 3,000 triangles.
// It lists no joints: it shares `ambient_a`'s skeleton (`skeleton` in `bench/cast/cast.ron`), so one
// pose serves the crowd.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_b",
        name: "ambient_b",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [],
        regions: [
            (name: "skin", albedo: [(0.0, "#eccab0"), (1.0, "#c89c80")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#2a2a30"), (1.0, "#0e0e12")], specular: 0.35, specular_size: 0.4),
            (name: "jacket", albedo: [(0.0, "#d49a40"), (1.0, "#7a4e18")], shadow_bias: 0.55),
            (name: "trousers", albedo: [(0.0, "#5a6470"), (1.0, "#262c34")]),
            (name: "shirt", albedo: [(0.0, "#f4f0e4"), (1.0, "#c4bca8")]),
            (name: "cap", albedo: [(0.0, "#6a4a3a"), (1.0, "#2a1a12")], specular: 0.25),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "jacket", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "jacket", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "jacket", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "trousers", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "trousers", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "cap", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 12, arc: Some((-15.0, 195.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The shirt's collar, the jacket's hem, a satchel on its strap and the cap.
            Loft((
                region: "shirt", bones: ["chest", "head"], sides: 14, thickness: 0.012,
                from: (0.0, 1.17, 0.0), to: (0.0, 1.29, 0.01),
                rings: [(at: 0.0, radius: (0.085, 0.075)), (at: 1.0, radius: (0.065, 0.06))],
            )),
            Loft((
                region: "jacket", bones: ["hips", "upperleg.l", "upperleg.r"], sides: 16, blend: 0.08, thickness: 0.012,
                from: (0.0, 0.84, 0.0), to: (0.0, 0.66, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.106)), (at: 1.0, radius: (0.17, 0.13))],
            )),
            Loft((
                region: "cap", bones: ["chest", "hips"], sides: 6, blend: 0.08,
                from: (-0.13, 1.18, 0.07), to: (0.13, 0.84, -0.09),
                rings: [(at: 0.0, radius: (0.012, 0.004)), (at: 1.0, radius: (0.012, 0.004))],
            )),
            Loft((
                region: "cap", bones: ["hips"], sides: 12,
                from: (0.15, 0.86, -0.02), to: (0.15, 0.7, -0.02),
                rings: [(at: 0.0, radius: (0.03, 0.09)), (at: 1.0, radius: (0.03, 0.09))],
            )),
            Loft((
                region: "cap", bones: ["head"], sides: 18,
                from: (0.0, 1.41, 0.02), to: (0.0, 1.5, 0.0),
                rings: [(at: 0.0, radius: (0.106, 0.112), shift: (0.0, -0.02)), (at: 0.5, radius: (0.104, 0.11), shift: (0.0, -0.01)), (at: 1.0, radius: (0.04, 0.04))],
            )),
        ],
    ),
)
