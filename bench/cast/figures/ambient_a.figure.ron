// An ambient figure of the benchmark's crowd (M5 B3): a pilgrim in a long teal robe split front and back, a sash, and a wide conical straw hat. One material, at the
// crowd's row of about 3,000 triangles.
// The crowd's skeleton is this figure's: the Lancer's 23 joints (24 with the model's root), which
// every other ambient figure shares (`skeleton` in `bench/cast/cast.ron`), so one pose serves them all.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_a",
        name: "ambient_a",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [
            (name: "root", at: (0.0, 0.0, 0.0), aim: Some((0.0, 1.0, 0.0))),
            (name: "hips", parent: Some("root"), at: (0.0, 0.8, 0.0)),
            (name: "spine", parent: Some("hips"), at: (0.0, 0.9, 0.0)),
            (name: "chest", parent: Some("spine"), at: (0.0, 1.05, 0.0)),
            (name: "head", parent: Some("chest"), at: (0.0, 1.27, 0.01), aim: Some((0.0, 1.45, 0.01))),
            (name: "upperarm.l", parent: Some("chest"), at: (0.16, 1.2, -0.01)),
            (name: "lowerarm.l", parent: Some("upperarm.l"), at: (0.41, 1.2, -0.01)),
            (name: "wrist.l", parent: Some("lowerarm.l"), at: (0.63, 1.2, -0.01)),
            (name: "hand.l", parent: Some("wrist.l"), at: (0.68, 1.2, -0.01)),
            (name: "handslot.l", parent: Some("hand.l"), at: (0.72, 1.2, 0.0), aim: Some((0.72, 1.2, 1.0))),
            (name: "upperarm.r", parent: Some("chest"), at: (-0.16, 1.2, -0.01)),
            (name: "lowerarm.r", parent: Some("upperarm.r"), at: (-0.41, 1.2, -0.01)),
            (name: "wrist.r", parent: Some("lowerarm.r"), at: (-0.63, 1.2, -0.01)),
            (name: "hand.r", parent: Some("wrist.r"), at: (-0.68, 1.2, -0.01)),
            (name: "handslot.r", parent: Some("hand.r"), at: (-0.72, 1.2, 0.0), aim: Some((-0.72, 1.2, 1.0))),
            (name: "upperleg.l", parent: Some("hips"), at: (0.085, 0.78, 0.0)),
            (name: "lowerleg.l", parent: Some("upperleg.l"), at: (0.085, 0.43, 0.01)),
            (name: "foot.l", parent: Some("lowerleg.l"), at: (0.085, 0.075, -0.01)),
            (name: "toes.l", parent: Some("foot.l"), at: (0.085, 0.02, 0.11), aim: Some((0.085, 0.015, 0.17))),
            (name: "upperleg.r", parent: Some("hips"), at: (-0.085, 0.78, 0.0)),
            (name: "lowerleg.r", parent: Some("upperleg.r"), at: (-0.085, 0.43, 0.01)),
            (name: "foot.r", parent: Some("lowerleg.r"), at: (-0.085, 0.075, -0.01)),
            (name: "toes.r", parent: Some("foot.r"), at: (-0.085, 0.02, 0.11), aim: Some((-0.085, 0.015, 0.17))),
        ],
        regions: [
            (name: "skin", albedo: [(0.0, "#f6e2d2"), (1.0, "#e0c0aa")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#4a3a32"), (1.0, "#1e1612")], specular: 0.35, specular_size: 0.4),
            (name: "robe", albedo: [(0.0, "#4a9a94"), (1.0, "#22504e")], shadow_bias: 0.55),
            (name: "under", albedo: [(0.0, "#e8e0cc"), (1.0, "#a89e88")]),
            (name: "straw", albedo: [(0.0, "#e8cc84"), (1.0, "#9a7a3a")], specular: 0.2),
            (name: "sash", albedo: [(0.0, "#c84a3a"), (1.0, "#6a1c18")], specular: 0.4, matcap: 0.2),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "robe", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "robe", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "robe", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "under", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "under", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "sash", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 12, arc: Some((-15.0, 195.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The robe's panels, front and back, the sash and the hat.
            Loft((
                region: "robe", bones: ["hips", "upperleg.l", "upperleg.r"], sides: 12, blend: 0.08, v: (0.3, 1.0), arc: Some((30.0, 150.0)), thickness: 0.012,
                from: (0.0, 0.86, 0.0), to: (0.0, 0.18, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.11)), (at: 0.5, radius: (0.2, 0.17)), (at: 1.0, radius: (0.25, 0.21))],
            )),
            Loft((
                region: "robe", bones: ["hips", "upperleg.l", "upperleg.r"], sides: 12, blend: 0.08, v: (0.3, 1.0), arc: Some((210.0, 330.0)), thickness: 0.012,
                from: (0.0, 0.86, 0.0), to: (0.0, 0.18, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.11)), (at: 0.5, radius: (0.2, 0.17)), (at: 1.0, radius: (0.25, 0.21))],
            )),
            Loft((
                region: "sash", bones: ["hips", "spine"], sides: 16,
                from: (0.0, 0.83, 0.0), to: (0.0, 0.92, 0.0),
                rings: [(at: 0.0, radius: (0.136, 0.106)), (at: 1.0, radius: (0.124, 0.096))],
            )),
            Loft((
                region: "straw", bones: ["head"], sides: 20,
                from: (0.0, 1.4, 0.01), to: (0.0, 1.6, 0.01),
                rings: [(at: 0.0, radius: (0.34, 0.34)), (at: 0.1, radius: (0.3, 0.3)), (at: 0.55, radius: (0.13, 0.13)), (at: 1.0, radius: (0.006, 0.006))],
            )),
        ],
    ),
)
