            graph: "cdb951df-80e4-46ab-b488-b082dc1d305b",
            // Its staff is skinned to its right hand's slot, so it holds nothing else.
            // Built at its own size: 3.18 m to its helm and 3.52 m to its crown's finial, against the
            // character's 1.62 m.
            scale: 1.0,
            height: 3.52,
            // Its glowing eyes, under the helm's brow.
            eyes_below_crown: 0.6,
            // Its flared shoulders, for what a camera frames.
            framed_radius: 1.1,
        ),
    ),
)
