// A small wood for the tests of placement and of the cook (M6 G1a): oaks in patches, ferns that keep off their
// trunks and out of a clearing, and grass under both. No shipped zone names it. Its meshes' IDs are the tests'.
(
    type: "sapphire::zone::FoliageDocument",
    version: 1,
    data: (
        kinds: [
            (name: "oak", model: Tree("2b0f0d43-6d4e-4b59-9b1f-5f3c6f0b8e21")),
            (name: "fern", model: Cover("8f5a7c1e-0c3d-4e1b-a2f6-3d9e4b7c5a10")),
            (name: "clump", model: Cover("4d2c6b8a-1e3f-4a5b-9c7d-0e1f2a3b4c5d")),
        ],
        layers: [
            // A wood with a pond in it: the inner outline is a hole.
            (name: "wood", outlines: [
                [(-40.0, -40.0), (40.0, -40.0), (40.0, 40.0), (-40.0, 40.0)],
                [(8.0, 8.0), (16.0, 8.0), (16.0, 16.0), (8.0, 16.0)],
            ]),
            (name: "meadow", outlines: [[(-40.0, -40.0), (0.0, -40.0), (0.0, 0.0), (-40.0, 0.0)]]),
        ],
        rules: [
            (
                name: "oaks",
                kind: "oak",
                on: ["wood"],
                per_100m2: 1.5,
                spacing: 4.0,
                slope_degrees: (0.0, 30.0),
                cluster: Some((scale: 24.0, contrast: 0.6)),
                scale: (0.8, 1.3),
                seed: 3,
            ),
            (
                name: "ferns",
                kind: "fern",
                on: ["wood"],
                per_100m2: 20.0,
                spacing: 1.0,
                height: Some((-1.0, 3.0)),
                avoid: [
                    Kinds(kinds: ["oak"], distance: 1.5),
                    Area(position: (-20.0, 0.0, 20.0), shape: Sphere(radius: 6.0)),
                ],
                scale: (0.7, 1.4),
            ),
        ],
        grass: [
            (
                name: "floor",
                kind: "clump",
                on: ["meadow"],
                per_m2: 1.5,
                slope_degrees: (0.0, 40.0),
                cluster: Some((scale: 6.0, contrast: 0.8)),
                avoid: [Kinds(kinds: ["oak"], distance: 0.8)],
                scale: (0.6, 1.2),
                seed: 11,
            ),
        ],
    ),
