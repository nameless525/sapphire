// The documents the game ships in place of Sapphire's (M3 S3), each a path under `content/`. The rest stay
// the compiled-in ones. The flow and its flags (M3 G1) and the screens (M3 U9) are the game's own: nothing
// compiles one in.
(
    type: "sapphire::assets::GameDocuments",
    version: 1,
    data: (
        flow: Some("game.flow.ron"),
        flags: Some("flags.ron"),
        menus: Some("ui/menus.ron"),
    ),
)
