// Remapping the pad's bindings (M4 A4): a tab for each device, a row for each binding a player may remap, showing
// the glyph of what it reads now, and a reset. A row's press waits for the device's next press
// (`remap_listen`), and `menus.ron` names each row's binding.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "menu.model.ron",
        styles: [
            (name: "title", role: "heading", size: 32, weight: 800),
            (name: "row", role: "body", size: 20, weight: 500),
            (name: "value", role: "body", size: 18, weight: 700),
            (name: "line", role: "body", size: 18, weight: 500),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, align: Center, justify: Center, safe_area: true),
                look: (fill: Color((6, 8, 14, 190))),
            ),
            (
                name: "panel",
                parent: "root",
                layout: (direction: Column, gap: 8, width: Points(600), max_width: Percent(92), max_height: Percent(96), padding: (left: 24, right: 24, top: 16, bottom: 16)),
                look: (shape: Slice(sprite: Button, corner: 16),
                    fill: Color((20, 26, 60, 255)),
                    outline: (color: (120, 190, 255, 255), width: 1.5),),
            ),
            (
                name: "title",
                parent: "panel",
                text: (
                    key: "remap-title",
                    style: "title",
                    color: (240, 246, 255, 255),
                    shadow: (color: (0, 0, 0, 180), offset: (2, 2)),
                ),
            ),
            (
                name: "tabs",
                parent: "panel",
                layout: (direction: Row, gap: 8, shrink: 0),
            ),
            (
                name: "tab-gamepad",
                parent: "tabs",
                layout: (direction: Row, align: Center, justify: Center, min_height: Points(48), padding: (left: 16, right: 16, top: 4, bottom: 4), shrink: 0, grow: 1),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((52, 78, 150, 255))),
            ),
            (
                name: "tab-gamepad-text",
                parent: "tab-gamepad",
                text: (
                    key: "remap-tab-gamepad",
                    style: "row",
                    color: (255, 192, 56, 255),
                ),
            ),
            (
                name: "tab-keyboard",
                parent: "tabs",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: Center,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                    grow: 1,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    down: "light",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "tab-keyboard-text",
                parent: "tab-keyboard",
                text: (
                    key: "remap-tab-keyboard",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "list",
                parent: "panel",
                layout: (direction: Column, gap: 8, shrink: 1, min_height: Points(112), padding: (left: 4, right: 4, top: 4, bottom: 4)),
                mask: true,
                scroll: Vertical,
            ),
            (
                name: "light",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    first: true,
                    up: "tab-keyboard",
                    down: "heavy",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "light-text",
                parent: "light",
                text: (
                    key: "remap-action-light",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "light-value",
                parent: "light",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.light")],
                ),
            ),
            (
                name: "heavy",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "light",
                    down: "dodge",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "heavy-text",
                parent: "heavy",
                text: (
                    key: "remap-action-heavy",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "heavy-value",
                parent: "heavy",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.heavy")],
                ),
            ),
            (
                name: "dodge",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "heavy",
                    down: "skill",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "dodge-text",
                parent: "dodge",
                text: (
                    key: "remap-action-dodge",
                    style: "row",
                    color: (240, 246, 255, 255),
