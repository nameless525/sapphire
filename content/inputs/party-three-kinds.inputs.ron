    type: "sapphire::gameplay::InputsDocument",
    version: 1,
    data: (
        about: "three kinds in one party against twelve Ember Lancers: the heroine's cuts, a swap to Aster and her punch and kick, a swap to Wren and the staff's string and skill, a swap back to the heroine and her cut, then nothing while the wave fells each in turn",
        ticks: 1200,
        tracks: [
            (
                presses: [
                    (at: [
