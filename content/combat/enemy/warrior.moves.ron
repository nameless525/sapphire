// The enemy's moves (M2 O4): the skeleton warrior, a head taller than the character, with a long
// blade in its right hand. Frame data in 60 Hz ticks, slower to come out than the player's, as the
// reference fights' common enemies are, so a dodge has something to read. Motion is keyed by hand
// until O2's and N3's clips bake in its place; the timing and the volumes are what this document
// owns. In root space +Z is forward and +X the warrior's left, and a blade's +Y runs grip to tip.
//
// A brain presses the attacks through `IntentRing::press` (M2 G6), so no intent has a button.
// M2 G3 forces the reactions through `MoveRunner::force`, by name, from any phase: `stagger_light`,
// `stagger_heavy`, `knockdown`, `recover` and `death`. E3 hangs effects on the cues: `telegraph` opens
// a long wind-up, on a move's first tick, and `swing` is the blade starting to cut.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A heavy beats a quick one when a brain presses two at one instant.
            (name: "swipe", buffer: 10, priority: 1),
            (name: "overhead", buffer: 10, priority: 2),
            (name: "lunge", buffer: 10, priority: 2),
            // Getting up from a knockdown once it has lain there. Nothing starts it from neutral.
            (name: "rise", buffer: 15),
        ],
        neutral: [
            (intent: "swipe", move: "swipe"),
            (intent: "overhead", move: "overhead"),
            (intent: "lunge", move: "lunge"),
        ],
        fighter: (
            // A common enemy, to G3's numbers: about eight of the player's three-hit strings to fell, and
            // two to break. Five seconds without a hit that takes poise, and the meter is full again.
            health: 240,
            poise: 60,
            poise_refill: 300,
            hurtboxes: [
                // From the ground to about its crown at 1.87 m: the horns aren't something to hit.
                (name: "body", offset: (0.0, 0.95, 0.0), shape: Capsule(radius: 0.4, length: 1.1)),
            ],
            reactions: (
                light: "stagger_light",
                medium: "stagger_light",
                heavy: "knockdown",
                poise_break: "stagger_heavy",
                defeat: "death",
            ),
        ),
        moves: [
            (
                // 1 s. A flat cut from its right to its left at chest height, reaching about 2 m from
                // where it started: 400 ms of wind-up with the blade drawn back, and open to a hit
                // for half a second after. A brain can string it late in the recovery.
                name: "swipe",
                startup: 24,
                active: 5,
                recovery: 31,
                motion: (
                    root: [
                        (at: 24, offset: (0.0, 0.0, 0.1)),
                        (at: 29, offset: (0.0, 0.0, 0.55)),
                        (at: 40, offset: (0.0, 0.0, 0.6)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.55, 1.0, 0.1), rotation: (0.4056, -0.5793, 0.5793, 0.4056)),
                                (at: 24, offset: (-0.94, 1.05, 0.34), rotation: (0.5793, -0.4056, 0.4056, 0.5793)),
                                (at: 26, offset: (-0.24, 1.0, 0.97), rotation: (0.7018, -0.0862, 0.0862, 0.7018)),
                                (at: 28, offset: (0.67, 0.95, 0.74), rotation: (0.6601, 0.2534, -0.2534, 0.6601)),
                                (at: 29, offset: (0.94, 0.9, 0.34), rotation: (0.5793, 0.4056, -0.4056, 0.5793)),
                                (at: 60, offset: (0.35, 0.6, 0.45)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swipe_hit",
                        from: 24,
                        to: 29,
                        path: "blade",
                        shape: Capsule(radius: 0.18, length: 0.9),
                        attack: (damage: 20, poise: 12, weight: Light, hitstop: 5, knockback: (distance: 0.4, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 46, to: 60, allow: [
                        (intent: "swipe", move: "swipe"),
                        (intent: "overhead", move: "overhead"),
                        (intent: "lunge", move: "lunge"),
                    ]),
                ],
                warps: [
                    // It tracks through the wind-up, and the cut itself commits.
                    (from: 0, to: 24, max_distance: 0.5, max_turn: 0.9, keep: 1.4),
                ],
                cues: [
                    (name: "swing_windup", at: 0),
                    (name: "swing", at: 24),
                ],
            ),
            (
                // 1.67 s. The telegraphed heavy: 800 ms with the blade raised over its head, turning
                // to follow, then a two-handed chop straight down its front, reaching about 2.3 m and
                // landing with the tip low. It can't get out of the recovery: this is the opening.
                name: "overhead",
                startup: 48,
                active: 6,
                recovery: 46,
                motion: (
                    root: [
                        (at: 40, offset: (0.0, 0.0, -0.1)),
                        (at: 48, offset: (0.0, 0.0, -0.1)),
                        (at: 54, offset: (0.0, 0.0, 0.7)),
                        (at: 62, offset: (0.0, 0.0, 0.8)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.3, 1.1, 0.25), rotation: (0.2588, 0.0, 0.0, 0.9659)),
                                (at: 40, offset: (-0.1, 2.15, -0.35), rotation: (-0.1736, 0.0, 0.0, 0.9848)),
                                (at: 48, offset: (0.0, 2.35, 0.0)),
                                (at: 50, offset: (0.0, 2.09, 0.71), rotation: (0.342, 0.0, 0.0, 0.9397)),
                                (at: 52, offset: (0.0, 1.44, 1.08), rotation: (0.6428, 0.0, 0.0, 0.766)),
                                (at: 54, offset: (0.0, 0.7, 0.95), rotation: (0.866, 0.0, 0.0, 0.5)),
                                (at: 100, offset: (0.2, 0.6, 0.5)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "overhead_hit",
                        from: 48,
                        to: 54,
                        path: "blade",
                        shape: Capsule(radius: 0.26, length: 0.9),
                        attack: (
                            damage: 60,
                            poise: 45,
                            weight: Heavy,
                            hitstop: 10,
                            knockback: (distance: 1.6, ticks: 18),
                            cue: "hit_heavy",
                        ),
                    ),
                ],
                warps: [
                    (from: 0, to: 48, max_distance: 0.8, max_turn: 1.6, keep: 1.6),
                ],
                cues: [
                    (name: "telegraph", at: 0),
                    (name: "swing", at: 48),
                    (name: "heavy_land", at: 53),
                ],
            ),
            (
                // 1.2 s. The gap closer: half a second gathered low with the blade held back, then a
                // thrust covering 3 m in 133 ms, which warp bends toward a target by up to 2.5 m
                // either way, stopping 1.4 m short of it. Without a target it reaches about 4.3 m.
                name: "lunge",
                startup: 30,
                active: 8,
                recovery: 34,
                motion: (
                    root: [
                        (at: 26, offset: (0.0, 0.0, -0.15)),
                        (at: 30, offset: (0.0, 0.0, -0.15)),
                        (at: 38, offset: (0.0, 0.0, 3.0)),
                        (at: 46, offset: (0.0, 0.0, 3.3)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.45, 1.0, -0.1), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 30, offset: (-0.4, 1.05, -0.25), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 32, offset: (-0.2, 1.05, 0.6), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 38, offset: (-0.1, 1.05, 1.05), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 46, offset: (-0.1, 1.0, 1.0), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 72, offset: (0.3, 0.6, 0.4)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "lunge_hit",
                        from: 30,
                        to: 38,
                        path: "blade",
                        shape: Capsule(radius: 0.24, length: 0.9),
                        attack: (damage: 35, poise: 25, weight: Medium, hitstop: 7, knockback: (distance: 1.0, ticks: 12)),
                    ),
                ],
                warps: [
                    (from: 6, to: 38, max_distance: 2.5, max_turn: 1.4, keep: 1.4),
                ],
                cues: [
                    (name: "telegraph", at: 0),
                    (name: "swing", at: 30),
                    (name: "lunge_land", at: 38),
                ],
            ),
            (
                // 333 ms: a flinch that gives ground, for a hit that doesn't break its poise.
                name: "stagger_light",
                startup: 0,
                active: 0,
                recovery: 20,
                motion: (
                    root: [
                        (at: 6, offset: (0.0, 0.0, -0.22)),
                        (at: 14, offset: (0.0, 0.0, -0.3)),
                    ],
                ),
                cues: [(name: "stagger", at: 0)],
            ),
            (
                // 700 ms: rocked back on its heels, for a hit that breaks it. A hit takes its numbers and
                // can't cut this short: it's the opening a break earns.
                name: "stagger_heavy",
                startup: 0,
                active: 0,
                recovery: 42,
                armour: [(from: 0, to: 42, threshold: 1000)],
                motion: (
                    root: [
                        (at: 10, offset: (0.0, 0.0, -0.55)),
                        (at: 24, offset: (0.0, 0.0, -0.75)),
                    ],
                ),
                cues: [(name: "stagger_heavy", at: 0)],
            ),
            (
                // 1.3 s: thrown back and down, landing at 467 ms and lying there. It gets up when
                // `rise` is pressed in the last third or `recover` is forced; left alone, it ends lying
                // down, which a brain or G3 won't leave it doing. A hit takes its numbers and can't flinch
                // it back onto its feet.
                name: "knockdown",
                startup: 0,
                active: 0,
                recovery: 78,
                armour: [(from: 0, to: 78, threshold: 1000)],
                motion: (
                    root: [
                        (at: 16, offset: (0.0, 0.0, -1.1)),
                        (at: 30, offset: (0.0, 0.0, -1.4)),
                    ],
                ),
                cancels: [
                    (from: 58, to: 78, allow: [(intent: "rise", move: "recover")]),
                ],
                cues: [
                    (name: "knockdown", at: 0),
                    (name: "body_land", at: 28),
                ],
            ),
            (
                // 667 ms: back on its feet, untouchable until it nearly is.
                name: "recover",
                startup: 0,
                active: 0,
                recovery: 40,
                motion: (
                    root: [
                        (at: 30, offset: (0.0, 0.0, 0.1)),
                    ],
                ),
                invulnerable: [(from: 0, to: 28)],
                cues: [(name: "recover", at: 0)],
            ),
            (
                // 2.5 s: it falls apart, and nothing can hit it any more.
                name: "death",
                startup: 0,
                active: 0,
                recovery: 150,
                motion: (
                    root: [
                        (at: 18, offset: (0.0, 0.0, -0.5)),
                        (at: 36, offset: (0.0, 0.0, -0.6)),
                    ],
                ),
                hurtboxes: [
                    (name: "body", from: 0, to: 150, state: Off),
                ],
                invulnerable: [(from: 0, to: 150)],
                cues: [
                    (name: "death", at: 0),
                    (name: "body_land", at: 40),
                    (name: "death_fade", at: 120),
                ],
            ),
        ],
    ),
)
