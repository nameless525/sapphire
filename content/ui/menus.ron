// The game's screens (M3 U9): each its document (`<name>.ui.ron`, by its sidecar's ID), the model it reads,
// whether it takes the presses a fight would, what back does on it beyond its machine, and what each of its
// focusable nodes does. A screen showing only what `Menu` holds (a way out, a run to continue, the player's
// settings) is documents alone: its `.ui.ron` and sidecar, its strings in `content/loc/`, and a row here.
// `game_ui`'s tests hold every focusable node to a row and every key to both languages. The code opens the
// title, the pause, the HUD and the dialogue itself, so a game has to have those. How to add one is in
// `docs/m4-handoff.md`.
(
    type: "sapphire::game::MenuDocument",
    version: 1,
    data: (
        screens: [
            (
                name: "title",
                document: "a733bc8e-d4f9-4e85-a8d5-7c7d30b5e30d",
                back: Some(Command(Leave)),
                rows: [
                    (node: "continue", does: Command(Continue)),
                    (node: "new", does: Command(NewGame)),
                    (node: "settings", does: Open("settings")),
                    (node: "leave", does: Command(Leave)),
                ],
            ),
            (
                name: "pause",
                document: "2be53fec-1a42-4f0b-a6b4-f2781357c0fb",
                back: Some(Command(Resume)),
                rows: [
                    (node: "resume", does: Command(Resume)),
                    // A playtest build's alone (M4 F1): it keeps the tick, and the run goes on.
                    (node: "mark", does: Command(Mark)),
                    (node: "character", does: Open("character")),
                    (node: "settings", does: Open("settings")),
                    (node: "to-title", does: Command(ToTitle)),
                    (node: "leave", does: Command(Leave)),
                ],
            ),
            (
                name: "settings",
                document: "cf52ef55-199e-426f-adea-52940c953a9f",
                rows: [
                    (node: "language", does: Step(Language)),
                    (node: "display", does: Open("display")),
                    (node: "graphics", does: Open("graphics")),
                    (node: "sound", does: Open("sound")),
                    (node: "subtitles", does: Open("subtitles")),
                    (node: "controls", does: Open("controls")),
                    (node: "privacy", does: Open("privacy")),
                    (node: "back", does: Nothing),
                ],
            ),
            // The privacy policy (M4 Z3b): what the game collects, which is nothing, and where the whole policy is.
            (
                name: "privacy",
                document: "322f7643-af51-4371-9a3b-bbca91acbe8e",
                rows: [(node: "back", does: Nothing)],
            ),
            // The settings' pages (M4 A1): each row steps one of `PlayerSettings`, which the app keeps.
            (
                name: "display",
                document: "decb2022-9967-4038-ab1e-71e298dc33cf",
                rows: [
                    (node: "size", does: Step(Size)),
                    (node: "text", does: Step(TextSize)),
                    (node: "shake", does: Step(Shake)),
                    (node: "flashes", does: Step(Flashes)),
                    (node: "camera", does: Step(CameraMotion)),
                    (node: "timing", does: Step(TimingAssist)),
                    (node: "back", does: Nothing),
                ],
            ),
            // M4 T3's: the quality tier, the frame cap, dynamic resolution and the battery saver.
            (
                name: "graphics",
                document: "5b0e7c61-2d4a-4f3b-9e8d-1a6c3f7b9d24",
                rows: [
                    (node: "quality", does: Step(Quality)),
                    (node: "cap", does: Step(FrameCap)),
                    (node: "dynamic", does: Step(DynamicResolution)),
                    (node: "saver", does: Step(BatterySaver)),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "sound",
                document: "41584242-98b0-4c12-ab10-d10edf5146b4",
                rows: [
                    (node: "volume", does: Step(Sound)),
                    (node: "music", does: Step(Music)),
                    (node: "effects", does: Step(Effects)),
                    (node: "voice", does: Step(Voice)),
                    (node: "mono", does: Step(Mono)),
                    (node: "rumble", does: Step(Rumble)),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "subtitles",
                document: "70145fa4-94b6-4bdc-be5c-7c7c1442a887",
                rows: [
                    (node: "shown", does: Step(Subtitles)),
                    (node: "size", does: Step(SubtitleSize)),
                    (node: "background", does: Step(SubtitleBackground)),
                    (node: "speakers", does: Step(Speakers)),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "controls",
                document: "7df9cdb9-a0bc-4f32-8a1c-070beaf0f8d9",
                rows: [
                    (node: "auto-target", does: Step(AutoTarget)),
                    (node: "hold-light", does: Step(Hold(Light))),
                    (node: "hold-heavy", does: Step(Hold(Heavy))),
                    (node: "hold-dodge", does: Step(Hold(Dodge))),
                    (node: "hold-skill", does: Step(Hold(Skill))),
                    (node: "hold-lock-on", does: Step(Hold(LockOn))),
                    (node: "remap", does: Open("remap_pad")),
                    (node: "back", does: Nothing),
                ],
            ),
            // Remapping (M4 A4): a tab for each device, and a row for each binding a player may remap, by its
            // name in the bindings. A row waits on `remap_listen` for the device's next press, and a press
            // another binding has asks on `remap_taken` whether to swap the two. Code opens those two.
            (
                name: "remap_pad",
                document: "78c83893-13a1-4b74-8329-417dae508998",
                rows: [
                    (node: "tab-keyboard", does: Switch("remap_keys")),
                    (node: "light", does: Remap("light.gamepad")),
                    (node: "heavy", does: Remap("heavy.gamepad")),
                    (node: "dodge", does: Remap("dodge.gamepad")),
                    (node: "skill", does: Remap("skill.gamepad")),
                    (node: "ultimate", does: Remap("ultimate.gamepad")),
                    (node: "swap", does: Remap("swap.gamepad")),
                    (node: "lock-on", does: Remap("lock_on.gamepad")),
                    (node: "jump", does: Remap("jump.gamepad")),
                    (node: "reset", does: Reset(Gamepad)),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "remap_keys",
                document: "11596e58-286f-42c6-ae64-47bd104572f5",
                rows: [
                    (node: "tab-gamepad", does: Switch("remap_pad")),
                    (node: "move-forward", does: Remap("move_forward.keyboard")),
                    (node: "move-back", does: Remap("move_back.keyboard")),
                    (node: "move-left", does: Remap("move_left.keyboard")),
                    (node: "move-right", does: Remap("move_right.keyboard")),
                    (node: "light", does: Remap("light.keyboard")),
                    (node: "heavy", does: Remap("heavy.keyboard")),
                    (node: "dodge", does: Remap("dodge.keyboard")),
                    (node: "skill", does: Remap("skill.keyboard")),
                    (node: "ultimate", does: Remap("ultimate.keyboard")),
                    (node: "swap", does: Remap("swap.keyboard")),
                    (node: "lock-on", does: Remap("lock_on.keyboard")),
                    (node: "jump", does: Remap("jump.keyboard")),
                    (node: "reset", does: Reset(Keyboard)),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "remap_listen",
                document: "8ad0ab83-a7a5-444c-9f53-2d5fd1782652",
                back: Some(Keep),
                rows: [(node: "cancel", does: Keep)],
            ),
            (
                name: "remap_taken",
                document: "a6985a91-3e75-467d-94df-8eba8438dc1f",
                back: Some(Keep),
                rows: [
                    (node: "swap", does: Swap),
                    (node: "keep", does: Keep),
                ],
            ),
            (
                name: "character",
                document: "014b8262-3dda-4d77-a391-9ee209740962",
                model: Character,
                rows: [
                    (node: "skill-attack", does: Nothing),
                    (node: "skill-dodge", does: Nothing),
                    (node: "skill-art", does: Nothing),
                    (node: "back", does: Nothing),
                ],
            ),
            (
                name: "dialogue",
                document: "1c4f98ba-d58a-46d3-b8df-8be091d9e5dc",
                model: Dialogue,
                rows: [
                    (node: "next", does: Command(DialogueNext)),
                    (node: "first", does: Command(DialogueChose(0))),
                    (node: "second", does: Command(DialogueChose(1))),
                    (node: "third", does: Command(DialogueChose(2))),
                    (node: "fourth", does: Command(DialogueChose(3))),
                ],
            ),
            (
                name: "hud",
                document: "a86b3aa5-faf3-4fb2-ab2c-27e9b0dae713",
                model: Hud,
                modal: false,
                rows: [
                    (node: "pause", does: Command(Pause)),
                    (node: "skip", does: Command(Skip)),
                ],
            ),
            // The photosensitivity notice (M4 A3), which a launch with a player at it opens over the title
            // until it's read. Going on, by its row or by back, marks it read in the settings.
            (
                name: "notice",
                document: "521e00ba-31a9-42e4-9268-be74ecfcbdd6",
                back: Some(Command(FlashNoticeRead)),
                rows: [
                    (node: "flashes", does: Step(Flashes)),
                    (node: "continue", does: Command(FlashNoticeRead)),
                ],
            ),
        ],
    ),
)
