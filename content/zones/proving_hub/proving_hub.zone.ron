// The proving hub (M3 W4): a square a test can leave and come back to, so a transition has somewhere to go
// until M3 C1's zone. It leads to the proving ground, whose pack comes in ahead of time while anyone's here:
// what makes a zone a hub. Its pack is `zone_proving_hub`: its materials are the town's, which stay shared, and
// its pieces are its own, so that no piece two zones share leaves their packs for `shared`.
//
// It has a look of its own (M5 M6), which a trip into it brings and one out of it takes away: the blue hour
// after sunset at every hour (`proving_hub_day.ron`), its rigs' stronger camera rim (`proving_hub_rigs.ron`), a
// probe grid of its posts and ground (`proving_hub.probes.ron`, whose meshes are the prefabs, cooked for it),
// a gustier breeze than the stage's, wet paving after rain (which no shader draws until M5 L4's wet surfaces),
// and haze half again as thick as the day's, its height layer on the paving. The `zone-trip-hub` golden shows it.
// One reflection probe (M5 L2) stands in the open square among the posts, its box the paving's whole square.
(
    type: "sapphire::zone::ZoneDocument",
    version: 2,
    data: (
        grid: (cell_size: 16.0),
        placements: [
            (id: "placement-0", prefab: "a84f0b37-2d61-4e9c-b7f5-c93e16d2708a", at: (-6.0, 0.0, -6.0)),
            (id: "placement-1", prefab: "a84f0b37-2d61-4e9c-b7f5-c93e16d2708a", at: (6.0, 0.0, -6.0)),
            (id: "placement-2", prefab: "a84f0b37-2d61-4e9c-b7f5-c93e16d2708a", at: (-6.0, 0.0, 6.0)),
            (id: "placement-3", prefab: "a84f0b37-2d61-4e9c-b7f5-c93e16d2708a", at: (6.0, 0.0, 6.0)),
            // The ground.
            (id: "placement-4", prefab: "3c9d1f62-8e47-4ab3-a1d6-60f2b57e9c18", at: (0.0, 0.0, 0.0), backdrop: true),
        ],
        colliders: Some("b27e4d19-63a8-4c55-8e0f-12d9f7a6c340"),
        probes: Some("3d0efdb0-bb5d-4245-92a2-367504ef1ac8"),
        reflections: [
            (name: "square", position: (0.0, 1.6, 0.0), parallax: (min: (-24.0, 0.0, -24.0), max: (24.0, 12.0, 24.0))),
        ],
        day: Some("proving_hub_day.ron"),
        rigs: Some("proving_hub_rigs.ron"),
        wind: Some((direction: (-0.6, 0.0, 0.8), strength: 1.6, gustiness: 0.5)),
        weather: Some((wetness: 0.7, puddles: 0.3)),
        fog: Some((density: 1.5, height_base: Some(0.0))),
        // The ground's whole square.
        navigation: Some((min: (-24.0, -24.0), max: (24.0, 24.0))),
        spawners: [
            (name: "player_start", position: (0.0, 0.0, 0.0), yaw_degrees: 0.0, spawns: "player"),
            (name: "from_ground", position: (0.0, 0.0, 10.0), yaw_degrees: 180.0, spawns: "player"),
        ],
        triggers: [
            (
                name: "ground_door",
                position: (0.0, 1.0, -14.0),
                volume: Box(half_extents: (3.0, 2.0, 1.0)),
                event: "to_proving_ground",
            ),
        ],
        exits: [
            (name: "to_proving_ground", to: "e8c21831-7d98-4a79-b592-912b806cf3e2", arrive: "player_start", prefetch: true),
        ],
        // People about the square (M5 C10), as its presentation alone: two by the posts, a pair talking
        // on the north side, one watching the door's road, and three walking a lap outside the posts.
        // The cast is `content/ambient/`'s; nothing here reaches the simulation or the zone's digest.
        ambient: Some((
            seed: 11,
            graph: "9fb02cf8-5a3d-4ed9-9651-c89bc8ccfecd",
            cast: [
                (name: "lady", mesh: "39c1b8aa-15aa-5345-b654-309b4acbefb8"),
                (name: "dockhand", mesh: "db819d3f-6470-5a18-b07a-5da4af03919b"),
                (name: "porter", mesh: "834df6ef-6b41-5841-8746-8fd871250ded"),
            ],
            posts: [
                (name: "west_post", position: (-7.5, 0.0, 4.5), yaw_degrees: 121.0, gestures: ["shift", "look_around"]),
                (name: "east_post", position: (8.0, 0.0, 7.5), yaw_degrees: 227.0, who: Some("porter"), gestures: ["shift"]),
                (name: "talker_west", position: (-3.0, 0.0, 12.0), yaw_degrees: 70.0, who: Some("lady"),
                 gestures: ["shift"], every: (6.0, 12.0)),
                (name: "talker_east", position: (-1.8, 0.0, 12.4), yaw_degrees: 250.0, who: Some("dockhand"),
                 gestures: ["shift", "look_around"], every: (6.0, 12.0)),
                (name: "door_watch", position: (12.5, 0.0, -3.0), yaw_degrees: 270.0, gestures: ["look_around"]),
            ],
            walks: [
                (name: "lap", points: [(-10.0, 0.0, -10.0), (10.0, 0.0, -10.0), (10.0, 0.0, 10.0), (-10.0, 0.0, 10.0)],
                 closed: true, pace: 1.25, count: 3),
            ],
        )),
    ),
