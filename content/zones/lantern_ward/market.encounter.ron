// The Market Court's fight (M3 C2): a warrior and a Lancer as someone comes through its gate, and another
// pair when one is left. Two tokens between them, so the warriors hold the front while a Lancer goes round.
(
    type: "sapphire::zone::EncounterDocument",
    version: 1,
    data: (
        starts_on: "market_entered",
        faction: 2,
        tokens: 2,
        token_rest: 40,
        waves: [
            (when: Start, gap: 20, spawners: ["market_spawn_a", "market_spawn_b"]),
            (when: Remaining(1), gap: 30, spawners: ["market_spawn_c", "market_spawn_d"]),
        ],
    ),
)
