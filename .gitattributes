# Text files are stored and checked out with LF on every OS. Tests compare `include_str!`
# output against `\n`, and gradlew and other shell scripts must keep LF to run.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never normalize, diff or merge. Git LFS (spec §7.1) is deferred until art outgrows
# plain Git: the generated samples and M1's third-party look-dev content (about 13 MB) don't,
# and every CI checkout would spend LFS bandwidth.
# Source art and media.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
*.hdr binary
*.psd binary
*.blend binary
*.fbx binary
*.glb binary
*.vrm binary
*.bin binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
# Cooked or GPU-ready formats.
*.ktx2 binary
*.dds binary
*.astc binary
*.smesh binary
*.bank binary
# Platform packaging.
*.jar binary
*.icns binary
*.ico binary

# Third-party content stays byte for byte as downloaded (content/third_party/README.md); only
# the project's own provenance notes and sidecars there are normalized.
content/third_party/** -text
content/third_party/**/*.md text
content/third_party/**/*.meta text
