// The look-dev town (M1 X1): a town square and a street out of it in the style of Wuthering
// Waves' Jinzhou (X1 part 2b): white plaster on grey stone plinths, charcoal tile roofs sweeping
// up at their corners, warm timber, paper lanterns. The buildings are the assembly's parametric
// builtins (`#hall`, `#roof`, `#wall`, `#column`, `#lantern`) in the groups below, and so are
// its market's stalls and cart (`#stall`, `#cart`, X1 part 2f); the Chinese pavilion is a piece
// of the town's own (`pieces/`); Kenney's Fantasy Town Kit gives the hills beyond the town,
// re-materialed. The far mountains are meshes of their own (`../mountains/`, X1 part 2d). See
// `sapphire_pipeline::assembly` for the format and `apps/sapphire_sandbox/src/lookdev.rs` for the
// stage that draws it.
//
// World space: meters, +Y up. The character stands at the origin facing +Z, where the cameras
// are; the square opens behind her toward -Z, and the street leaves it through the gate wall's
// moon gate at x 3.2. Buildings are built in meters inside their groups, each on its footprint's
// middle with its front toward +Z: a row facing +X turns 90, one facing -X turns -90.
//
// Faces that meet in one plane z-fight wherever they draw differently. The cook fails on any it
// finds between placements, naming both and where: keep neighboring roofs apart (or at other
// heights), as two roofs of one height overlapping in plan share planes. `allow_coplanar`, at
// the end, lets through only the ones no camera can see, each entry saying why; an entry that
// lets nothing through fails the cook too.
(
    type: "sapphire::pipeline::Assembly",
    version: 1,
    data: (
        kits: {
            "kenney": "../../third_party/kenney_fantasy_town_kit/glb",
            // Pieces derived for the town: the Chinese pavilion (`pieces/pavilion.glb`, converted
            // from VVayToyek's FBX by `tools/blender/pavilion_to_gltf.py`).
            "pieces": "pieces",
        },
        palette: (columns: 16, rows: 4, gradient_columns: [1, 3, 5, 7, 9, 11, 13, 15]),
        slots: [
            (name: "timber", tile: (1.0, 1.0)),
            (name: "stone_trim", tile: (1.0, 1.0), projection: Box),
            (name: "grass", tile: (6.0, 6.0)),
            (name: "cloth_red", tile: (1.0, 1.0)),
            (name: "cloth_blue", tile: (1.0, 1.0)),
            (name: "canvas", tile: (1.0, 1.0)),
            (name: "iron", tile: (1.0, 1.0), projection: Box),
            // Jinzhou (X1 part 2b): the parametric builtins' parts, sent here by the rules below.
            (name: "whitewash", tile: (3.2, 3.2)),
            (name: "plinth_stone", tile: (2.0, 2.0)),
            (name: "stone_pale", tile: (1.0, 1.0)),
            (name: "roof_tile", tile: (1.0, 1.2)),
            (name: "roof_ridge", tile: (1.0, 1.0)),
            (name: "roof_tile_plain", tile: (1.0, 1.0)),
            (name: "eaves", tile: (1.2, 1.2)),
            (name: "wood", tile: (1.0, 1.0)),
            (name: "wood_dark", tile: (1.0, 1.0)),
            (name: "paper_window", tile: (1.0, 1.0)),
            (name: "paper_lantern", tile: (1.0, 1.0)),
            (name: "lacquer", tile: (1.0, 1.0)),
            (name: "paving", tile: (4.0, 4.0)),
            // The market (X1 part 2f): its goods.
            (name: "wicker", tile: (1.0, 1.0)),
            (name: "pottery", tile: (1.0, 1.0)),
            (name: "greens", tile: (1.0, 1.0)),
            (name: "fruit", tile: (1.0, 1.0)),
        ],
        surfaces: [
            // Jinzhou: the parametric builtins' parts (`#roof`, `#hall`, `#wall`, `#column`,
            // `#lantern`), by part name. White plaster and gables on cool grey stone, charcoal tiles
            // and ridges, warm timber, amber paper.
            (pieces: ["#*"], material: Some("plaster"), slot: "whitewash"),
            (pieces: ["#*"], material: Some("gable"), slot: "whitewash"),
            (pieces: ["#*"], material: Some("plinth"), slot: "plinth_stone"),
            (pieces: ["#*"], material: Some("trim"), slot: "stone_pale"),
            (pieces: ["#*"], material: Some("tiles"), slot: "roof_tile"),
            (pieces: ["#*"], material: Some("ridge"), slot: "roof_ridge"),
            (pieces: ["#*"], material: Some("eaves"), slot: "eaves"),
            (pieces: ["#*"], material: Some("timber"), slot: "wood"),
            (pieces: ["#*"], material: Some("lattice"), slot: "wood_dark"),
            (pieces: ["#*"], material: Some("window"), slot: "paper_window"),
            (pieces: ["#*"], material: Some("door"), slot: "wood_dark"),
            (pieces: ["#*"], material: Some("paper"), slot: "paper_lantern"),
            (pieces: ["#*"], material: Some("frame"), slot: "lacquer"),
            // The market (`#stall`, `#cart`): counters, crates and beds in warm boards, stalls'
            // backs in their frames' timber, signs in red lacquer, iron tyres; awnings' cloth
            // red (or blue, by variant) with cream valances, and bolts of cloth for sale in both.
            (pieces: ["#*"], material: Some("boards"), slot: "timber"),
            (pieces: ["#*"], material: Some("back"), slot: "wood"),
            (pieces: ["#*"], material: Some("sign"), slot: "lacquer"),
            (pieces: ["#*"], material: Some("iron"), slot: "iron"),
            (pieces: ["#*"], material: Some("cloth"), slot: "cloth_red"),
            (pieces: ["#*"], material: Some("cloth"), variant: Some("blue"), slot: "cloth_blue"),
            (pieces: ["#*"], material: Some("valance"), slot: "canvas"),
            (pieces: ["#*"], material: Some("wicker"), slot: "wicker"),
            (pieces: ["#*"], material: Some("pottery"), slot: "pottery"),
            (pieces: ["#*"], material: Some("produce"), slot: "greens"),
            (pieces: ["#*"], material: Some("fruit"), slot: "fruit"),
            // The pavilion's six materials: red lacquer columns and benches as its accent, warm
            // timber, charcoal tiles in plain color (its tiles are modeled), dark ridges, pale
            // stone bases, dark boards.
            (pieces: ["pavilion"], material: Some("lacquer"), slot: "lacquer"),
            (pieces: ["pavilion"], material: Some("timber"), slot: "wood"),
            (pieces: ["pavilion"], material: Some("tiles"), slot: "roof_tile_plain"),
            (pieces: ["pavilion"], material: Some("ridge"), slot: "roof_ridge"),
            (pieces: ["pavilion"], material: Some("stone"), slot: "stone_trim"),
            (pieces: ["pavilion"], material: Some("boards"), slot: "wood_dark"),
        ],
        occlusion: (ground: 0.35, ground_height: 2.5, gradient: 0.3),
        groups: {
            // Jinzhou's buildings (X1 part 2b), in meters, each standing on its footprint's middle
