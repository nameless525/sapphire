// The settings' graphics page (M4 T3): the quality tier, the frame cap, dynamic resolution and the battery
// saver. Each row steps what it shows on a press, which a pad, a key and a finger all have; the app hands what
// they say to the stage's quality and the platform's pacing. A phone's cap steps between 30 and 60 only.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "menu.model.ron",
        styles: [
            (name: "title", role: "heading", size: 32, weight: 800),
            (name: "row", role: "body", size: 20, weight: 500),
            (name: "value", role: "body", size: 18, weight: 700),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, align: Center, justify: Center, safe_area: true),
                look: (fill: Color((6, 8, 14, 190))),
            ),
            (
                name: "panel",
                parent: "root",
                layout: (direction: Column, gap: 8, width: Points(560), max_width: Percent(92), max_height: Percent(96), padding: (left: 24, right: 24, top: 16, bottom: 16)),
                look: (shape: Slice(sprite: Button, corner: 16),
                    fill: Color((20, 26, 60, 255)),
                    outline: (color: (120, 190, 255, 255), width: 1.5),),
            ),
            (
                name: "title",
                parent: "panel",
                text: (
                    key: "graphics-title",
                    style: "title",
                    color: (240, 246, 255, 255),
                    shadow: (color: (0, 0, 0, 180), offset: (2, 2)),
                ),
            ),
            (
                name: "list",
                parent: "panel",
                layout: (direction: Column, gap: 8, shrink: 1, min_height: Points(112), padding: (left: 4, right: 4, top: 4, bottom: 4)),
                mask: true,
                scroll: Vertical,
            ),
            (
                name: "quality",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    down: "cap",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "quality-text",
                parent: "quality",
                text: (
                    key: "graphics-quality",
                    style: "row",
                    color: (240, 246, 255, 255),
                    wrap: true,
                ),
            ),
            (
                name: "quality-value",
                parent: "quality",
                text: (
                    key: "graphics-quality-automatic",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "quality", prefix: "graphics-quality-"),
                ),
            ),
            (
                name: "cap",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "quality",
                    down: "dynamic",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "cap-text",
                parent: "cap",
                text: (
                    key: "graphics-cap",
                    style: "row",
                    color: (240, 246, 255, 255),
                    wrap: true,
                ),
            ),
            (
                name: "cap-value",
                parent: "cap",
                text: (
                    key: "graphics-cap-unlimited",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "frame_cap", prefix: "graphics-cap-"),
                ),
            ),
            (
                name: "dynamic",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "cap",
                    down: "saver",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "dynamic-text",
                parent: "dynamic",
                text: (
                    key: "graphics-dynamic",
                    style: "row",
                    color: (240, 246, 255, 255),
                    wrap: true,
                ),
            ),
            (
                name: "dynamic-value",
                parent: "dynamic",
                text: (
                    key: "settings-switch-off",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "dynamic_resolution", prefix: "settings-switch-"),
                ),
            ),
            (
                name: "saver",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "dynamic",
                    down: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "saver-text",
                parent: "saver",
                text: (
                    key: "graphics-saver",
                    style: "row",
                    color: (240, 246, 255, 255),
                    wrap: true,
                ),
            ),
            (
                name: "saver-value",
                parent: "saver",
                text: (
                    key: "settings-switch-off",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "battery_saver", prefix: "settings-switch-"),
                ),
            ),
            (
                name: "foot",
                parent: "panel",
                layout: (direction: Column, shrink: 0, padding: (left: 4, right: 4)),
            ),
            (
                name: "back",
                parent: "foot",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "saver",
                    fires: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "back-text",
                parent: "back",
                text: (
                    key: "graphics-back",
                    style: "row",
                    color: (240, 246, 255, 255),
                    wrap: true,
                ),
            ),
        ],
        timelines: [
            (name: "gone", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 0)])]),
            (
                name: "enter",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 0), (at: 0.22, value: 1, ease: Out)]),
                    (node: "panel", property: Y, keys: [(at: 0, value: 24), (at: 0.22, value: 0, ease: Back)]),
                ],
            ),
            (
                name: "leave",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 1), (at: 0.16, value: 0, ease: In)]),
                ],
            ),
            (
                name: "focus-quality",
                tracks: [(node: "quality", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-cap",
                tracks: [(node: "cap", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-dynamic",
                tracks: [(node: "dynamic", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-saver",
                tracks: [(node: "saver", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-back",
                tracks: [(node: "back", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
        ],
        states: [
            (name: "hidden", play: "gone"),
            (name: "entering", play: "enter", then: "open"),
            (name: "open", input: true),
            (name: "leaving", play: "leave", then: "hidden"),
        ],
        transitions: [
            (from: "hidden", on: "open", to: "entering"),
            (from: "open", on: "back", to: "leaving"),
            (from: "open", on: "close", to: "leaving"),
        ],
    ),
)
