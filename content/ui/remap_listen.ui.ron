// What a remap shows while it waits for the press (M4 A4): which binding, what to press, and what ends it.
// A press a binding no player remaps has (the pause's, the camera's) is shown as kept for it, and the wait
// goes on. Code opens and closes it (`MenuScreen::REMAP_LISTEN`).
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "menu.model.ron",
        styles: [
            (name: "title", role: "heading", size: 32, weight: 800),
            (name: "row", role: "body", size: 20, weight: 500),
            (name: "value", role: "body", size: 18, weight: 700),
            (name: "line", role: "body", size: 18, weight: 500),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, align: Center, justify: Center, safe_area: true),
                look: (fill: Color((6, 8, 14, 190))),
            ),
            (
                name: "panel",
                parent: "root",
                layout: (direction: Column, gap: 8, width: Points(520), max_width: Percent(92), max_height: Percent(96), padding: (left: 24, right: 24, top: 16, bottom: 16)),
                look: (shape: Slice(sprite: Button, corner: 16),
                    fill: Color((20, 26, 60, 255)),
                    outline: (color: (120, 190, 255, 255), width: 1.5),),
            ),
            (
                name: "title",
                parent: "panel",
                text: (
                    key: "remap-press-gamepad",
                    style: "title",
                    color: (240, 246, 255, 255),
                    shadow: (color: (0, 0, 0, 180), offset: (2, 2)),
                    key_from: (path: "remap.press", prefix: "remap-press-"),
                ),
            ),
            (
                name: "binding",
                parent: "panel",
                text: (
                    key: "remap-action-light",
                    style: "title",
                    color: (255, 192, 56, 255),
                    key_from: (path: "remap.binding", prefix: "remap-action-"),
                ),
            ),
            (
                name: "cancel-hint",
                parent: "panel",
                text: (
                    key: "remap-cancel",
                    style: "line",
                    color: (170, 200, 240, 255),
                    args: [(name: "glyph", path: "remap.cancel")],
                ),
            ),
            (
                name: "kept",
                parent: "panel",
                layout: (direction: Row, gap: 8, wrap: true, shrink: 0),
                binds: [(to: Shown, path: "remap.kept")],
            ),
            (
                name: "kept-text",
                parent: "kept",
                text: (
                    key: "remap-kept",
                    style: "line",
                    color: (255, 150, 130, 255),
                    args: [(name: "glyph", path: "remap.pressed")],
                ),
            ),
            (
                name: "kept-action",
                parent: "kept",
                text: (
                    key: "remap-action-pause",
                    style: "line",
                    color: (255, 150, 130, 255),
                    key_from: (path: "remap.taken_by", prefix: "remap-action-"),
                ),
            ),
            (
                name: "cancel",
                parent: "panel",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    first: true,
                    fires: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "cancel-text",
                parent: "cancel",
                text: (
                    key: "remap-cancel-row",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
        ],
        timelines: [
            (name: "gone", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 0)])]),
            (
                name: "enter",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 0), (at: 0.22, value: 1, ease: Out)]),
                    (node: "panel", property: Y, keys: [(at: 0, value: 24), (at: 0.22, value: 0, ease: Back)]),
                ],
            ),
            (
                name: "leave",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 1), (at: 0.16, value: 0, ease: In)]),
                ],
            ),
            (
                name: "focus-cancel",
                tracks: [(node: "cancel", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
        ],
        states: [
            (name: "hidden", play: "gone"),
            (name: "entering", play: "enter", then: "open"),
            (name: "open", input: true),
            (name: "leaving", play: "leave", then: "hidden"),
        ],
        transitions: [
            (from: "hidden", on: "open", to: "entering"),
            (from: "open", on: "back", to: "leaving"),
            (from: "open", on: "close", to: "leaving"),
        ],
    ),
)
