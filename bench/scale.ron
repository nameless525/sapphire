// The benches at scale (M5 Z1): every run of the batch that measures what exit tests 1, 2, 5, 6 and 7 ask
// for (m5-plan §1), and the packages' costs on and off beside exit test 3, on each tier.
// `cargo xtask bench-scale prepare|plan|run|report` runs it through `sapphire_testkit scale`;
// docs/development-iteration.md says how to run the batch and read its report.
//
// Each run is one line of data. Its fields, as `sapphire_testkit::scale::manifest::Run` takes them:
//
// - `name`: its logs' stem, lowercase letters, digits and hyphens; `about`: what it measures, in the report.
// - `args`: the sandbox's, after the runner's own `--bench <frames> --tier <tier> --size <size>` (and
//   `--bench-trace` when `trace`); `{replays}` is the prepared replays' folder. `tier_args` adds a tier's own.
// - `frames`: `Lap` (a lap of the 756 m tour at the tier's steps a frame) or `Count(n)`; `phases`: 3 for a walk
//   or a fight (cold, CPU, GPU), 1 for a plain bench, which is how long the planner thinks it takes.
// - `tiers`: the tiers it runs on, all when empty; `size`: its own `--size`, for a package's script that drew
//   at another; `rounds`: in place of the manifest's.
// - `read`: the report's tables it fills (Cpu, Gpu, Counts, Memory, Streaming, Trips, Cast, Pipelines).
// - `variants`: a pair's sides, each a name and the arguments it adds; their order turns each round, and
//   `rows` are the rows the pair's table shows (a bench row, a count row or a plain bench's field).
// - `timed: false`: a run of counts alone (`--draw-every`), run in an ordinary slot by `run --counts`, whose
//   rounds must count the same.
// - `beside`: the baseline's run it stands beside; `serves`: the exit tests it's read for, by m5-plan §1's
//   numbers, whose verdicts read it (a pair serving 3 is a cost read beside its other side, judged by none);
//   `stands_in`: what it stands in for, where the exit test's own run can't be made yet, which the report never
//   reads as a pass.
// - `settles`: the packages (docs/m6-plan.md's IDs) whose "Measure first" or "Kill if" reads it (M6 B9), which the
//   report lists and spec §3.9 gives a go or kill from; `bench/probes.ron` holds M6's probes, the runs no exit test
//   reads, which `cargo xtask bench-scale --probes` runs apart from this batch.
// - `devices`: the devices it walks on in place of this Mac, by the `devices` list's names: a run of counts
//   alone, run only by `cargo xtask bench-scale device --platform <name>` (M5 Z2), whose logs are
//   `<run>.<tier>.<device>.r<n>.log` and whose verdicts are lines of their own.
// - A tier's `memory_mib` is spec §3.1's memory budget in MiB (a GB taken as 1,024 MiB, as §3.4's pools are), and
//   `crowd` the ambient characters exit test 6 asks for on it.
//
// The district has a probe grid, reflection probes and a midday key since M6 B4: every run M5 measured in it pins
// the grid and the probes off (`--no-probe-grid --no-reflection-probes`) and stands between 19:45 and 23:00, whose
// keys are M5's, so it draws the frame M5 measured; M6 B4's day runs (`tour-day`, `district-fight-day`, their arms
// and `counted-day`) draw the district as a shipped zone would be, at midday with the grid and the probes, and M6
// B5's (`fight-ships`, its cut-in's pair and `counted-ships`) fight there as a game does, cues, effects and ultimate.
//
// Planning figures (`frames_a_second`, `startup_seconds`) are B4's walks on the M5 Mac: about 265 s a desktop
// walk of three phases and 147 s a phone one. They size the sittings and measure nothing.
(
    type: "sapphire::testkit::ScaleBench",
    version: 1,
    data: (
        preset: "budget",
        rounds: 2,
        sitting_seconds: 600,
        load_bound: 8.0,
        gaps: [],
        // Where the batch measures an exit test otherwise than its words, by the orchestrator's rulings (M5 Z2).
        deviations: [
            "Exit test 1: three runs stand for the plan's one walk. exit-walk walks dusk into night with the crowd about, night-weather holds the night wet against dry (weather doesn't move along one walk), and district-fight is the encounter of twelve against the party of three; the counting walks count draws and lights at dusk, at night dry and wet, and through the fight.",
            "Exit test 2: a trip from the district: the district has no exits, so the counting walk under a binding pool closes it at its end, as a trip leaves a zone, and the mesh pool's floor is judged there; trip plays the ward's zone-trip beside it.",
            "Exit test 7: zero_hitches plays the ward, since a shipping build can't stand a zone code builds: the counting walks' pipeline counts (no first use, none rebuilt, none on the frame's thread, no frame waiting) and B5's fight test stand in on the district.",
        ],
        // The phones draw onto a phone's panel, 2532x1170, and their tier caps the scene at 740 and 590 rows and
        // upscales it, as spec §3.1's "~1600×740 → native" ships: the upscale, the interface at the panel's size and
        // the levels and size culling a panel's rows pick are all in the frame. B4's baseline drew them at
        // 1600x740 and 1280x590, the scenes' sizes, so a phone row's baseline column isn't the same frame.
        tiers: [
            (name: "desktop-high", size: "2560x1440", cook: desktop, lap: 7600, frames_a_second: 90, startup_seconds: 12, memory_mib: Some(10240), crowd: Some(60)),
            (name: "desktop-low", size: "1920x1080", cook: desktop, lap: 7600, frames_a_second: 90, startup_seconds: 12, memory_mib: Some(6144), crowd: Some(60)),
            (name: "mobile-high", size: "2532x1170", cook: mobile, lap: 7600, frames_a_second: 170, startup_seconds: 12, memory_mib: Some(2867), crowd: Some(30)),
            (name: "mobile-low", size: "2532x1170", cook: mobile, lap: 3800, frames_a_second: 85, startup_seconds: 12, memory_mib: Some(1638), crowd: Some(30)),
        ],
        runs: [
            // B4's baseline, by its exact flags and M6 B4's pins, which keep the district as it walked it: the tour at
            // dusk and at night.
            (
                name: "tour-dusk",
                about: "the tour at dusk, as B4 walked it",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--no-probe-grid",
                    "--no-reflection-probes",
                ],
                frames: Lap,
                read: [Cpu, Gpu, Counts, Memory],
                beside: Some("tour-dusk"),
                serves: [1],
            ),
            (
                name: "tour-night",
                about: "the tour at night, as B4 walked it",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "23", "--no-probe-grid",
                    "--no-reflection-probes",
                ],
                frames: Lap,
                read: [Cpu, Gpu, Counts, Memory],
                beside: Some("tour-night"),
                serves: [1],
            ),
            // Exit test 1's walk: dusk into night along the lap (3.25 hours over 126.67 s), the crowd about.
            (
                name: "exit-walk",
                about: "exit test 1's walk: dusk into night along the tour, the crowd about",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--day-length", "935",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Lap,
                read: [Cpu, Gpu, Counts, Memory, Pipelines],
                trace: true,
                beside: Some("tour-dusk"),
                serves: [1, 7],
            ),
            (
                name: "night-weather",
                about: "the night lap held dry against held wet",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "23", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu],
                variants: [(name: "dry", args: ["--weather", "dry"]), (name: "wet", args: ["--weather", "0.8,0.4"])],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu post", "draw calls"],
                serves: [1],
            ),
            // Exit test 2: the streamer under a pool that binds, the district's textures twice it: exactly half of
            // what each cook's walk holds whole, in whole MiB, rounded down (M5 Z2). That whole is the `texture pool
            // bytes` the counting walk with whole textures (`counted`) holds at the tour's end, the same on both
            // tiers of a cook: the desktop cook's 2,733,906,860 bytes, half 1,366,953,430, so 1303 MiB, which holds
            // the views' worst ask (`texture bytes wanted`) of 1,263,504,874 bytes on Desktop-High, 8% under it; the mobile cook's 699,285,048, half
            // 349,642,524, so 333 MiB. Read on B7's district (thirteen materials a desktop cell, whose palette draws
            // from the same texture sets as sixteen did, so the desktop whole didn't move; the mobile cook's pack is
            // unchanged). The mobile cook's sets are 1K (`MOBILE_SET_SIZE`), so against the phones' own 600 and
            // 400 MiB its whole is only ×1.1 and ×1.66.
            (
                name: "streaming",
                about: "memory and streaming along the tour, the pool binding",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--texture-streaming", "on",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                tier_args: {
                    "desktop-high": ["--texture-pool", "1303"],
                    "desktop-low": ["--texture-pool", "1303"],
                    "mobile-high": ["--texture-pool", "333"],
                    "mobile-low": ["--texture-pool", "333"],
                },
                frames: Lap,
                read: [Memory, Streaming],
                trace: true,
                serves: [2],
            ),
            (
                name: "trip",
                about: "a zone trip and the mesh pool's floor after it",
                args: ["--arena", "--replay", "{replays}/zone-trip.sreplay", "--no-hot-reload", "--live-link", "off"],
                frames: Count(1200),
                read: [Trips, Memory],
                trace: true,
                serves: [2],
                stands_in: Some("a trip from the district to another zone and back"),
            ),
            // The crowd: its densest stretch held still (313.7 m along the tour, heading west), and the tour.
            (
                name: "crowd-hold",
                about: "the crowd's densest stretch of the tour, held still, ambient characters on against off",
                args: [
                    "--zone", "district:122.3,0,-64,270", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(1200),
                phases: 1,
                read: [Cpu, Gpu],
                variants: [(name: "on", args: ["--ambient", "on"]), (name: "off", args: ["--ambient", "off"])],
                rows: ["cpu_us_p50", "cpu_us_p99", "anim_us_p50", "spring_us_p50", "gpu_frame_us", "gpu_main_us", "gpu_skinning_us", "surface_draws"],
                serves: [6],
            ),
            (
                name: "crowd-tour",
                about: "the tour with the crowd about, ambient characters on against off",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Cast],
                variants: [(name: "on", args: ["--ambient", "on"]), (name: "off", args: ["--ambient", "off"])],
                rows: ["cpu frame", "animation and ik", "secondary motion", "gpu frame", "gpu main", "gpu skinning", "ambient characters in view", "skinned vertices"],
                serves: [5, 6],
            ),
            // Exit tests 1 and 5 at once: the district's encounter (M5 B5), its party of three kinds up the avenue
            // into the plaza's twelve Ember Lancers at night, the hub's people about. Its scenario stands on a zone
            // code builds, which the `dev` sandbox hands over.
            (
                name: "district-fight",
                about: "the district's encounter at night: the heroine, Aster and Wren up the avenue into twelve Ember Lancers, the crowd about",
                args: [
                    "--arena", "--replay", "{replays}/district-encounter.sreplay", "--party", "--time-of-day", "23",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu, Counts, Cast, Pipelines],
                trace: true,
                beside: Some("tour-night"),
                serves: [1, 5, 7],
            ),
            // The district's fight with CPU and GPU overlapped (M6 B7, `--bench-overlap`): each frame waits for the
            // frame two back rather than for everything, as behind a swapchain of two, beside the batch's way. Its
            // `bench overlap` line says whether the tier is CPU- or GPU-limited so: a CPU-limited tier reopens a
            // render thread (m6-plan §3, "What not to do"). The arms compare on `cpu frame` and `gpu wait` alone:
            // overlapped, consecutive frames' GPU work can overlap (as Metal's command buffers do), so the GPU phase's
            // pass rows and `gpu frame` are taken on other frames than the waiting arm's, and are not set side by
            // side; `bench overlap` is the overlapped arm's alone.
            (
                name: "fight-overlap",
                about: "the district's fight waiting for the frame two back, CPU and GPU overlapped, beside waiting for every frame",
                args: [
                    "--arena", "--replay", "{replays}/district-encounter.sreplay", "--party", "--time-of-day", "23",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu],
                variants: [(name: "waits", args: []), (name: "overlaps", args: ["--bench-overlap"])],
                rows: ["cpu frame", "gpu wait"],
                serves: [3],
                settles: ["B7"],
            ),
            // Exit test 5's fight (M5 C12b): the heroine, Aster and Wren against twelve Ember Lancers on the arena,
            // from the root that holds the kinds at the preset's rows (`bench/kinds.ron`): Aster at 80,000
            // triangles, Wren at 83,808 (4.8% over the row), the heroine at her model's 36,470: 200,278 of 240,000.
            (
                name: "party-kinds",
                about: "the party of three kinds against twelve Ember Lancers, the kinds at the preset's rows",
                args: [
                    "--arena", "--party", "--replay", "{replays}/party-three-kinds.sreplay", "--no-hot-reload",
                    "--live-link", "off",
                ],
                frames: Count(600),
                read: [Cpu, Gpu, Counts, Cast, Pipelines],
                serves: [5],
            ),
            // A conversation's close-up (M6 B8): the heroine speaking at close range on the arena, her face filling
            // the frame, her mouth and expression moving as her idle breathes, from `dialogue_closeup`'s
            // cutscene (8 s held, about 500 frames a fight at 60 Hz). Beside "skinned vertices" and `gpu skinning`,
            // its count rows "vertices skinned again with the same pose" price appearance levels and "skinned
            // vertices that held still" deformation blocks (m6-plan B8: built only past 0.2 ms on a tier). A probe
            // for no exit test: B9's manifest takes it.
            (
                name: "dialogue-closeup",
                about: "the heroine speaking at close range, her face filling the frame: a conversation's close-up",
                args: ["--arena", "--replay", "{replays}/dialogue-closeup.sreplay", "--no-hot-reload", "--live-link", "off"],
                frames: Count(1000),
                read: [Cpu, Gpu, Counts],
                settles: ["B8"],
            ),
            // Each package's own on/off pair.
            (
                name: "lods",
                about: "levels of detail (D4, D5), on against off",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [(name: "on", args: ["--lods", "on"]), (name: "off", args: ["--lods", "off"])],
                rows: ["gpu frame", "gpu main", "gpu shadows", "gpu prepasses", "triangles", "lod1+ draws", "level switches"],
                serves: [3],
            ),
            // D6's pair (M5 Z2): the district's cells cooked with their levels against cooked with one, the second
            // the content `prepare` puts beside each cook's (`content/<preset>/<cook>-no-cell-levels/`).
            (
                name: "cell-levels",
                about: "the district's cells' levels (D6), cooked with them against with one",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [(name: "on", args: []), (name: "off", args: [], content: Some("no-cell-levels"))],
                rows: [
                    "gpu frame", "gpu main", "gpu shadows", "main triangles", "shadow triangles", "mesh pool capacity",
                    "mesh pool floor",
                ],
                serves: [3],
            ),
            (
                name: "character-lods",
                about: "characters' levels (D5) on the crowd's tour, on against off",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Gpu, Cast],
                variants: [(name: "on", args: ["--character-lods", "on"]), (name: "off", args: ["--character-lods", "off"])],
                rows: ["gpu main", "gpu skinning", "gpu prepasses", "skinned vertices", "skinned instances"],
                serves: [3],
            ),
            (
                name: "character-lods-crowd",
                about: "characters' levels (D5) among sixty chasers, on against off",
                args: ["--arena", "--replay", "{replays}/crowd-60.sreplay", "--no-hot-reload", "--live-link", "off"],
                frames: Count(1800),
                read: [Gpu, Cast],
                variants: [(name: "on", args: ["--character-lods", "on"]), (name: "off", args: ["--character-lods", "off"])],
                rows: ["gpu main", "gpu skinning", "animation and ik", "skinned vertices", "skinned instances"],
                serves: [3],
            ),
            (
                name: "draw-runs",
                about: "instanced runs (D2): a call a draw against the shadow views' runs",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--no-hot-reload",
                    "--live-link", "off", "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [(name: "off", args: ["--draw-runs", "off"]), (name: "shadows", args: ["--draw-runs", "shadows"])],
                rows: ["cpu frame", "render", "gpu frame", "gpu shadows", "draw calls", "draw instances"],
                serves: [3],
            ),
            (
                name: "shadow-cache",
                about: "kept and held cascades (D8) on the tour, held against drawn in turns",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--no-hot-reload",
                    "--live-link", "off", "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [(name: "held", args: ["--shadow-cache", "held"]), (name: "turns", args: ["--shadow-cache", "turns"])],
                rows: ["cpu frame", "render", "gpu frame", "gpu shadows", "shadow triangles", "cascades drawn"],
                serves: [3],
            ),
            (
                name: "capsule-bins",
                about: "the characters' capsules by cluster (L18) on the crowd's tour, on against off",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75", "--mount", "zone_proving_hub",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(3800),
                read: [Gpu],
                variants: [(name: "on", args: ["--capsule-bins", "on"]), (name: "off", args: ["--capsule-bins", "off"])],
                rows: ["gpu frame", "gpu main", "gpu clustering and ao"],
                serves: [3],
            ),
            (
                name: "capsule-bins-hub",
                about: "the characters' capsules by cluster (L18) at the proving hub's start, as L18 measured it",
                args: ["--zone", "proving_hub:player_start", "--no-hot-reload", "--live-link", "off"],
                frames: Count(1200),
                phases: 1,
                read: [Gpu],
                variants: [(name: "on", args: ["--capsule-bins", "on"]), (name: "off", args: ["--capsule-bins", "off"])],
                rows: ["gpu_frame_us", "gpu_main_us", "gpu_clustering_ao_us"],
                serves: [3],
            ),
            (
                name: "upscaler",
                about: "the phones' upscaler (L14), along edges against bilinear, on the street at L14's size",
                args: ["--look-dev", "street", "--no-hot-reload", "--live-link", "off"],
                tiers: ["mobile-high", "mobile-low"],
                size: Some("2532x1170"),
                frames: Count(300),
                phases: 1,
                read: [Gpu],
                variants: [(name: "edge", args: ["--upscaler", "edge"]), (name: "bilinear", args: ["--upscaler", "bilinear"])],
                rows: ["gpu_frame_us", "gpu_upscale_us", "gpu_post_total_us"],
                serves: [3],
            ),
            // Exit test 7 by counts: a frame in seven drawn along the lap fails on any pipeline built after the
            // load, with whole textures and with the streamer binding, where a frame could wait on a level.
            (
                name: "counted",
                about: "the tour's counts, a frame in seven drawn, whole textures",
                // The crowd the timed walks draw (M5 Z3): the proving hub's mounted, the ambient characters on.
                args: [
                    "--draw-every", "7", "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Lap,
                phases: 1,
                read: [Counts, Pipelines],
                timed: false,
                serves: [1, 6, 7],
            ),
            (
                name: "counted-streaming",
                about: "the tour's counts, a frame in seven drawn, the streamer binding",
                args: [
                    "--draw-every", "7", "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--texture-streaming", "on", "--no-hot-reload",
                    "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                // `streaming`'s pools, half what each cook's walk holds whole, and paced at each tier's frame rate
                // (tiers.ron's `frame_rate`), so a wait's frames each last a frame's time, as a game's do (M5 Z2):
                // paced, it is timed work, planned into the sittings, though it reads counts.
                tier_args: {
                    "desktop-high": ["--texture-pool", "1303", "--bench-pace", "60"],
                    "desktop-low": ["--texture-pool", "1303", "--bench-pace", "60"],
                    "mobile-high": ["--texture-pool", "333", "--bench-pace", "60"],
                    "mobile-low": ["--texture-pool", "333", "--bench-pace", "30"],
                },
                frames: Lap,
                phases: 1,
                read: [Counts, Streaming, Pipelines],
                timed: false,
                serves: [2, 7],
            ),
            // Exit test 1's draws and lights by counts where the timed runs go (M5 Z2): the tour at night, held dry
            // and held wet, and the district's fight, a frame in seven drawn. Each fails on a pipeline built after
            // the load, as `counted` does.
            (
                name: "counted-night",
                about: "the tour's counts at night, dry and wet, a frame in seven drawn",
                args: [
                    "--draw-every", "7", "--zone", "district", "--zone-walk", "tour", "--time-of-day", "23",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Lap,
                phases: 1,
                read: [Counts, Pipelines],
                variants: [(name: "dry", args: ["--weather", "dry"]), (name: "wet", args: ["--weather", "0.8,0.4"])],
                timed: false,
                serves: [1, 7],
            ),
            (
                name: "counted-fight",
                about: "the district's encounter at night by counts, a frame in seven drawn",
                args: [
                    "--draw-every", "7", "--arena", "--replay", "{replays}/district-encounter.sreplay", "--party",
                    "--time-of-day", "23", "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live",
                    "--no-hot-reload", "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                frames: Count(1600),
                phases: 1,
                read: [Counts, Pipelines],
                timed: false,
                serves: [1, 7],
            ),
            // Exit test 2 where §1 says its counters run beside this Mac (M5 Z2): `counted-streaming`'s walk on the
            // Simulator and the emulator, `cargo xtask bench-scale device --platform ios-sim|android`, one round a
            // phone tier, paced as it is. Their bundles carry the `ci` district (the budget's is gigabytes), whose
            // phone tree with the shipped mobile cook holds 28,932,504 bytes (27.6 MiB) of textures whole on both
            // phones (`texture pool bytes`, tests/counts/district-ci.txt). Its pool is 28 MiB, the orchestrator's
            // ruling (M5 Z2): it holds the views' worst ask, 28,903,381 bytes, and the whole too, so its walk proves
            // the streamer's waits and uploads on a device, not a binding pool, which the batch's walk proves on
            // this Mac.
            (
                name: "device-streaming",
                about: "the tour's counts on a device, a frame in seven drawn, the ci district's streamer binding",
                args: [
                    "--draw-every", "7", "--zone", "district", "--zone-walk", "tour", "--time-of-day", "19.75",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--texture-streaming", "on", "--no-hot-reload",
                    "--live-link", "off",
                    "--no-probe-grid", "--no-reflection-probes",
                ],
                tier_args: {
                    "mobile-high": ["--texture-pool", "28", "--bench-pace", "60"],
                    "mobile-low": ["--texture-pool", "28", "--bench-pace", "30"],
                },
                tiers: ["mobile-high", "mobile-low"],
                frames: Lap,
                phases: 1,
                rounds: Some(1),
                read: [Counts, Streaming, Pipelines],
                timed: false,
                serves: [2, 7],
                devices: ["ios-sim", "android"],
            ),
            // M6 B4: the district as a shipped zone would be, at midday (`district_day.ron`'s 13:00 key, the sun up)
            // with its probe grid (the environment's and characters' ambient by the grid, per pixel on the desktops)
            // and its reflection probes (24 on `ci`, 40 on the budget, along the avenues and over the plaza), beside
            // M5's dusk and night, which draw neither. Its arms read the grid's lookup and the probes' cost by taking
            // each away: `no-grid` (`--no-probe-grid`, the hemisphere's ambient, as M5's frame), `no-reflections`
            // (`--no-reflection-probes`, the sky's reflection alone) and `neither`, on the desktops, where E3 and E4
            // are judged. No exit test reads them yet: M6's fight that ships (B5) stands on them.
            (
                name: "tour-day",
                about: "the tour at midday, the sun up, with the probe grid and the reflection probes",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "13", "--mount", "zone_proving_hub",
                    "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                ],
                frames: Lap,
                read: [Cpu, Gpu, Counts, Memory],
            ),
            (
                name: "tour-day-probes",
                about: "the tour at midday: the probe grid and the reflection probes, each taken away",
                args: [
                    "--zone", "district", "--zone-walk", "tour", "--time-of-day", "13", "--mount", "zone_proving_hub",
                    "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                ],
                tiers: ["desktop-high", "desktop-low"],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [
                    (name: "both", args: []),
                    (name: "no-grid", args: ["--no-probe-grid"]),
                    (name: "no-reflections", args: ["--no-reflection-probes"]),
                    (name: "neither", args: ["--no-probe-grid", "--no-reflection-probes"]),
                ],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu clustering and ao", "gpu shadows", "ambient dispatches",
                    "probe dispatches"],
                settles: ["E3", "E4"],
            ),
            (
                name: "district-fight-day",
                about: "the district's encounter at midday with the probe grid and the reflection probes, the crowd about",
                args: [
                    "--arena", "--replay", "{replays}/district-encounter.sreplay", "--party", "--time-of-day", "13",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--no-hot-reload", "--live-link", "off",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu, Counts, Cast, Pipelines],
                trace: true,
            ),
            (
                name: "district-fight-day-probes",
                about: "the district's encounter at midday: the probe grid and the reflection probes, each taken away",
                args: [
                    "--arena", "--replay", "{replays}/district-encounter.sreplay", "--party", "--time-of-day", "13",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--no-hot-reload", "--live-link", "off",
                ],
                tiers: ["desktop-high", "desktop-low"],
                frames: Count(1600),
                read: [Cpu, Gpu, Counts],
                variants: [
                    (name: "both", args: []),
                    (name: "no-grid", args: ["--no-probe-grid"]),
                    (name: "no-reflections", args: ["--no-reflection-probes"]),
                    (name: "neither", args: ["--no-probe-grid", "--no-reflection-probes"]),
                ],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu clustering and ao", "gpu shadows", "ambient dispatches",
                    "probe dispatches"],
                settles: ["E3", "E4"],
            ),
            // M6 B4's day by counts: the tour at midday with the grid and the probes, a frame in seven drawn, failing on
            // any pipeline built after the load, as `counted` does.
            (
                name: "counted-day",
                about: "the tour's counts at midday with the probe grid and the reflection probes, a frame in seven drawn",
                args: [
                    "--draw-every", "7", "--zone", "district", "--zone-walk", "tour", "--time-of-day", "13",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--no-hot-reload", "--live-link", "off",
                ],
                frames: Lap,
                phases: 1,
                read: [Counts, Pipelines],
                timed: false,
            ),
            // M6 B5: the fight that ships, the unit M6's exit test 3 judges against each tier's GPU frame line (12, 14,
            // 13 and 26 ms). B4's district at midday with the probe grid and the reflection probes, and the fight as a
            // game plays it: its cues on (`--cues`), so its hits, trails, dust, decals and bends draw, its sounds mix
            // and its screen effects (the flashes, the impact frames and the effects pack) play over post, and the
            // heroine casts the ultimate as she comes to the plaza's twelve (`district-ultimate`: M5's encounter with
            // that one press), whose cinematic plays its cut-in. M5's `district-fight` stays as it was, at night with
            // neither, so M5's figures still compare; `district-fight-day` is this fight with no cue, its baseline.
            (
                name: "fight-ships",
                about: "the district's encounter as it ships: midday, the probe grid and the reflection probes, the cues' effects and screen effects, and the heroine's ultimate with its cut-in",
                args: [
                    "--arena", "--replay", "{replays}/district-ultimate.sreplay", "--party", "--time-of-day", "13",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--cues", "--no-hot-reload",
                    "--live-link", "off",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu, Counts, Cast, Pipelines],
                trace: true,
                settles: ["E1"],
            ),
            // The cut-in's own cost in that fight (spec §5.17 measured +1.02 ms of GPU and +1.05 ms of CPU on
            // Desktop-High in the arena): its frames alone (`--bench-ticks`, the 50 ticks a trace of the fight shows
            // its inset drawn on, from 5 ticks after the press), with cut-ins played against cut off, every other cue
            // the same.
            (
                name: "fight-ships-cutin",
                about: "the fight that ships over its cut-in's ticks, the cut-in played against cut off",
                args: [
                    "--arena", "--replay", "{replays}/district-ultimate.sreplay", "--party", "--time-of-day", "13",
                    "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--cues", "--no-hot-reload",
                    "--live-link", "off", "--bench-ticks", "415-464",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu],
                variants: [(name: "on", args: []), (name: "off", args: ["--cutins", "off"])],
                rows: ["cpu frame", "record", "animation and ik", "secondary motion", "gpu frame", "gpu main", "gpu ui",
                    "gpu post", "inset draws"],
                serves: [3],
                settles: ["E2", "J1"],
            ),
            // The fight that ships by counts, a frame in seven drawn, failing on any pipeline built after the load, as
            // `counted-fight` does: whatever its cues and cut-in draw is in its load's inventory.
            (
                name: "counted-ships",
                about: "the fight that ships by counts, a frame in seven drawn",
                args: [
                    "--draw-every", "7", "--arena", "--replay", "{replays}/district-ultimate.sreplay", "--party",
                    "--time-of-day", "13", "--mount", "zone_proving_hub", "--ambient", "on", "--hud", "live", "--cues",
                    "--no-hot-reload", "--live-link", "off",
                ],
                frames: Count(1600),
                phases: 1,
                read: [Counts, Pipelines],
                timed: false,
                settles: ["E1"],
            ),
            // M6 W1: the nature zone (`bench/nature/`, `--zone nature`), the unit every world-look, foliage, water,
            // weather and environment package is priced and judged on. Terrain as cell meshes, a lake and a river, grass
            // and trees, a dusk whose weather plan rains from 19:00, a probe grid and reflection probes; its named areas
            // (the forest block, the coast, the cave, the valley, the frozen pond) plain ground until their packages fill
            // them, each re-pinning the zone, and the orchestrator re-baselines the units they move. Each unit runs what
            // exists today and its `about` says what waits. All after M5's, B4's and B5's units, whose sittings and
            // order stay as they were.
            (
                name: "nature-walk",
                about: "the nature walk at dusk in the plan's rain, a lap at every tier: down the river, past the lake, toward the clearing (the water isn't drawn until W3; rain falls from W6 and W8b)",
                args: [
                    "--zone", "nature", "--zone-walk", "walk", "--time-of-day", "19.75", "--no-hot-reload", "--live-link",
                    "off",
                ],
                frames: Lap,
                read: [Cpu, Gpu, Counts, Memory],
            ),
            (
                name: "nature-rain",
                about: "the nature walk's first half with the storm's, the blizzard's and the sandstorm's look laid over the plan's rain (`--weather-state`, the tool's blend: the world's state and its shares stay the plan's rain, so no arm settles snow or sand; driving the world's state per arm waits on a bench override, and precipitation, lightning and cover on W6, W8b and V5; the water isn't drawn until W3)",
                args: [
                    "--zone", "nature", "--zone-walk", "walk", "--time-of-day", "19.75", "--no-hot-reload", "--live-link",
                    "off",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [
                    (name: "storm", args: ["--weather-state", "storm"]),
                    (name: "blizzard", args: ["--weather-state", "blizzard"]),
                    (name: "sandstorm", args: ["--weather-state", "sandstorm"]),
                ],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu post", "gpu shadows", "draw calls"],
            ),
            (
                name: "nature-fight",
                about: "the clearing's encounter at dusk in the rain: the party of three against six (the water isn't drawn until W3; rain falls from W6 and W8b)",
                args: [
                    "--arena", "--replay", "{replays}/nature-encounter.sreplay", "--party", "--time-of-day", "19.75",
                    "--hud", "live", "--no-hot-reload", "--live-link", "off",
                ],
                frames: Count(1600),
                read: [Cpu, Gpu, Counts, Cast, Pipelines],
                trace: true,
            ),
            (
                name: "nature-forest",
                about: "the forest block from its overlook at its east edge and walked into (today's trees on a grid until G2b's forest, G3's levels and W16's impostors)",
                args: ["--zone", "nature", "--time-of-day", "19.75", "--no-hot-reload", "--live-link", "off"],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [
                    (name: "overlook", args: ["--zone-walk", "overlook"]),
                    (name: "walk", args: ["--zone-walk", "forest"]),
                ],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu shadows", "draw calls", "main triangles"],
            ),
            (
                name: "nature-coast",
                about: "the coast walked, and walked down the beach (plain sand until H1b's ocean; the dive arm stays in the air until W4's under water)",
                args: ["--zone", "nature", "--time-of-day", "19.75", "--no-hot-reload", "--live-link", "off"],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts],
                variants: [
                    (name: "walk", args: ["--zone-walk", "coast"]),
                    (name: "dive", args: ["--zone-walk", "coast_dive"]),
                ],
                rows: ["cpu frame", "gpu frame", "gpu main", "gpu post", "draw calls"],
            ),
            (
                name: "nature-storm-effects",
                about: "the nature walk in the storm with its world effects (falling rain, lightning, motes and placed effects wait on W6, W8b, N8b and N10: the storm's look alone today)",
                args: [
                    "--zone", "nature", "--zone-walk", "walk", "--time-of-day", "19.75", "--weather-state", "storm",
                    "--no-hot-reload", "--live-link", "off",
                ],
                frames: Count(3800),
                read: [Cpu, Gpu, Counts, Pipelines],
            ),
            // The nature walk by counts, a frame in seven drawn, failing on any pipeline built after the load, as
            // `counted-day` does.
            (
                name: "counted-nature",
                about: "the nature walk's counts at dusk in the plan's rain, a lap at every tier, a frame in seven drawn (the water isn't drawn until W3; rain falls from W6 and W8b)",
                args: [
                    "--draw-every", "7", "--zone", "nature", "--zone-walk", "walk", "--time-of-day", "19.75",
                    "--no-hot-reload", "--live-link", "off",
                ],
                frames: Lap,
                phases: 1,
                read: [Counts, Pipelines],
                timed: false,
            ),
        ],
        // Where a run with `devices` walks (M5 Z2). Each device's bundle is the release `dev` sandbox with the
        // mobile cook and its preset's district beside it; its walks read counts only, never a time.
        devices: [
            (name: "ios-sim", about: "the iOS Simulator", preset: "ci"),
            (name: "android", about: "the Android emulator", preset: "ci"),
        ],
    ),
)
