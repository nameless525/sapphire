// The skeleton warrior as a kind of enemy (M3 B3): how it fights and how it's drawn. Its moves are
// `warrior.moves.ron`; its brain presses their intents, by name.
(
    type: "sapphire::moves::EnemyDocument",
    version: 1,
    data: (
        // `warrior.moves.ron`.
        moves: "c50887be-5ce3-498a-9f28-255e7e372b32",
        brains: {
            "steady": (
                // A first guess at Zenless Zone Zero's common enemies, for Feel review 3 to move. It stands where
                // a swipe just reaches and an overhead reaches well, and walks in from further: at the far
                // edge it arrives with only the overhead in reach, and has to come closer for a swipe.
                spacing: (near: 1.6, far: 2.6),
                // A body's width between two of them, so a crowd spreads round whoever it's after.
                apart: 1.2,
                pace: (
                    // About 4 m/s on the arena's profile, under a player's 6 m/s run: it can be outrun, which
                    // is what the lunge is for.
                    approach: 0.7,
                    // A step back at 1.2 m/s, and a slow circle at 1.4 m/s.
                    retreat: 0.3,
                    circle: 0.35,
                    circle_share: 0.7,
                    // A third of the player's turn: a big thing, slow to come round.
                    turn_rate_degrees: 300.0,
                ),
                // On a patrol, if it's given one: a walk of about 1.5 m/s, a foe noticed from 10 m with a clear
                // line, and given up on past 20 m.
                watch: (sight: 9.0, lose: 12.0, walk: 0.25),
                // 0.7 to 2.2 s of keeping its distance before it looks for an attack.
                patience: (min: 40, max: 130),
                // 0.4 to 1.25 s standing after an attack ends: the opening an attack's recovery started.
                rest: (min: 24, max: 75),
                // A short beat after a reaction, before its stick moves. It keeps the patience it had, so being hit
                // doesn't put off its next attack.
                recover: (min: 2, max: 10),
                attacks: [
                    (
                        // Quick and short: its answer to someone standing close or just finished swinging.
                        intent: "swipe",
                        reach: (near: 0.0, best: 1.5, far: 2.7),
                        against: (swinging: 0.7, opening: 1.6, reacting: 0.6, untouchable: 0.0),
                        recent: (ticks: 200, floor: 0.35),
                    ),
                    (
                        // The telegraphed heavy: rarely twice running, and best on someone already reeling.
                        intent: "overhead",
                        weight: 0.7,
                        reach: (near: 1.0, best: 2.3, far: 3.2),
                        against: (swinging: 0.4, reacting: 1.4, untouchable: 0.0),
                        recent: (ticks: 360, floor: 0.2),
                    ),
                    (
                        // The gap closer, from where nothing else reaches. Its warp gets it about 6.1 m on a
                        // target standing still, and less on one walking away.
                        intent: "lunge",
                        reach: (near: 3.0, best: 4.6, far: 6.0),
                        against: (swinging: 0.6, reacting: 0.7, untouchable: 0.0),
                        recent: (ticks: 240, floor: 0.3),
                    ),
                ],
                // Up in the knockdown's last third, not always at its first moment.
                rise: (intent: "rise", during: "knockdown", from: 58, to: 72),
            ),
        },
        brain: "steady",
        // Its health's quarters, as every fighter's were before enemies had documents: `on_phase` fires as
        // it crosses each, and none changes how it fights.
        phases: [(at: 750), (at: 500), (at: 250), (at: 0)],
        look: (
            // `warrior.glb`, derived from KayKit's skeleton (`sapphire_pipeline::combat::warrior`).
            mesh: "322aa57e-957d-45f1-8d51-0c1d80f5d1d6",
            // `warrior.animgraph.ron`.
            graph: "175de058-a4cd-4b75-8a04-4884914ac08f",
            // KayKit's blade (`content/third_party/kaykit_skeletons/assets/Skeleton_Blade.gltf`), in its
            // right hand.
            held: Some((mesh: "1a612690-4615-4346-86f0-c903784d2db5", joint: "handslot.r")),
            // The model stands 2.33 units to its crown and 2.59 to its horns' tips. This puts the crown at
            // 1.87 m and the horns at 2.07 m against the character's 1.62 m: a head taller, as the reference
            // fights' common enemies stand, with a blade whose reach, 1.8 m with the arm straight, is about
            // what its moves author.
            scale: 0.8,
            height: 2.33,
            // About where a face's eyes sit under a crown, for what a foe looks at.
            eyes_below_crown: 0.2,
            // Its shoulders and a blade held down, for what a camera frames.
            framed_radius: 0.45,
        ),
    ),
)
