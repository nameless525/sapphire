// The player's moves (M2 O3): frame data in 60 Hz ticks, for a character with a blade in its right
// hand. Zenless Zone Zero's rhythm is the target: a press moves the character within three ticks, a cut
// lands inside an eighth of a second, a string flows as fast as the player presses, and a dodge gets out
// of nearly anything. These are tuning values, made to be changed by the feel reviews.
//
// Each move plays the clip of its name beside this file (`light_1.keypose.ron`), and a cook bakes its
// root motion and its blade from that clip. One tick of a move is one tick of its clip, so a change to a
// move's length is a change to its clip's too. Windows move freely inside it.
//
// `blade` is a socket on the right hand: the middle of a 0.9 m blade leaving the fist on the thumb side,
// 22 degrees toward the fingers, its +Y running grip to tip. A hit is a capsule along it, and the sandbox
// draws `sword.glb` there. Written by tools/motion/moves.py, so edit it there.
//
// E3 hangs effects on the cues: `swing` is the blade starting to cut, and `step`, `skid` and
// `finisher_land` a foot taking the weight. The combat numbers are first guesses for Feel review 2, on
// the scale `warrior.moves.ron` was tuned to: the three-hit string does 28 damage and 36 poise.
//
// The five moves after those are what a hit forces (M2 G6). They have no clip of their own: the
// character's graph draws them from its reactions and deaths, and they stand still while it does.
//
// The last is a party's swap-in assist (M2 G7), on the dash attack's clip, and `swap` is the press that
// brings it. Only a party reads either: with no party, the button does nothing.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A dodge beats a skill beats an attack when two could fire at one instant. A press of
            // `light` lasts long enough to carry from anywhere in a cut into the next.
            (name: "light", button: Light, buffer: 14, priority: 1),
            (name: "skill", button: Skill, buffer: 10, priority: 2),
            (name: "dodge", button: Dodge, buffer: 8, priority: 3),
            (name: "swap", button: Swap, buffer: 12, priority: 4),
        ],
        neutral: [
            (intent: "light", move: "light_1"),
            (intent: "skill", move: "skill"),
            (intent: "dodge", move: "dodge"),
        ],
        fighter: (
            health: 300,
            poise: 60,
            // Four seconds without a hit that takes poise, and the meter is full again.
            poise_refill: 240,
            hurtboxes: [
                // From the ground to the crown of the head at 1.62 m. A dodge turns it off.
                (name: "body", offset: (0.0, 0.81, 0.0), shape: Capsule(radius: 0.3, length: 1.02)),
            ],
            reactions: (
                light: "flinch",
                medium: "stagger",
                heavy: "knockdown",
                poise_break: "dazed",
                defeat: "defeat",
            ),
        ),
        moves: [
            (
                // 567 ms. The first cut: 117 ms of wind-up, then a slash from high on the right to low
                // on the left on a step of the right foot, carrying about 0.7 m. The next press takes over
                // from tick 14, the blade just past its mark; left alone, the back foot steps through.
                name: "light_1",
                startup: 7,
                active: 4,
                recovery: 23,
                motion: (
                    clip: (
                        source: "6d321a52-1aed-4279-bc32-a177b8fd81d4",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "light_1_hit",
                        from: 7,
                        to: 11,
                        path: "blade",
                        shape: Capsule(radius: 0.22, length: 0.9),
                        attack: (damage: 6, poise: 8, weight: Light, hitstop: 3, knockback: (distance: 0.25, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 34, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 14, to: 28, allow: [
                        (intent: "light", move: "light_2"),
                        (intent: "skill", move: "skill"),
                    ]),
                ],
                warps: [
                    (from: 0, to: 7, max_distance: 0.6, max_turn: 0.8, keep: 1.0),
                ],
                cues: [
                    (name: "swing_windup", at: 0),
                    (name: "swing", at: 7),
                    (name: "step", at: 11),
                ],
            ),
            (
                // 600 ms. The second cut, a backhand rising from low on the left to high on the right on
                // a step of the left foot, carrying about 0.6 m. It starts where the first settles, and
                // ends where the finisher starts.
                name: "light_2",
                startup: 7,
                active: 4,
                recovery: 25,
                motion: (
                    clip: (
                        source: "0c4be2d4-4149-4852-80c5-109683aad3e1",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "light_2_hit",
                        from: 7,
                        to: 11,
                        path: "blade",
                        shape: Capsule(radius: 0.22, length: 0.9),
                        attack: (damage: 8, poise: 10, weight: Light, hitstop: 4, knockback: (distance: 0.3, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 36, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 14, to: 30, allow: [
                        (intent: "light", move: "light_3"),
                        (intent: "skill", move: "skill"),
                    ]),
                ],
                warps: [
                    (from: 0, to: 7, max_distance: 0.6, max_turn: 0.8, keep: 1.0),
                ],
                cues: [
                    (name: "swing", at: 7),
                    (name: "step", at: 11),
                ],
            ),
            (
                // 867 ms. The finisher commits: 267 ms gathering low and rising with the blade overhead,
                // then a two-handed chop on a long bound of 1.4 m. It holds the landing, with only a dodge
                // to get out early.
                name: "light_3",
                startup: 16,
                active: 4,
                recovery: 32,
                motion: (
                    clip: (
                        source: "5fe300c9-a4a3-4339-a556-7bc112f2bb59",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "light_3_hit",
                        from: 16,
                        to: 20,
                        path: "blade",
                        shape: Capsule(radius: 0.28, length: 0.9),
                        attack: (damage: 14, poise: 18, weight: Medium, hitstop: 7, finish_freeze: 16, knockback: (distance: 0.7, ticks: 12), cue: "hit_heavy"),
                    ),
                ],
                cancels: [
                    (from: 4, to: 52, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 44, to: 52, allow: [(intent: "light", move: "light_1")]),
                ],
                warps: [
                    (from: 0, to: 16, max_distance: 1.0, max_turn: 1.0, keep: 1.1),
                ],
                cues: [
                    (name: "swing_windup", at: 0),
                    (name: "swing", at: 16),
                    (name: "finisher_land", at: 19),
                ],
            ),
            (
                // 400 ms: a low leap straight back, 2.4 m in 14 ticks. Invulnerable for 217 ms, the first
                // 100 ms of them perfect: a swing reaching a body-sized volume then slows the world, and a
                // press answers with the dash attack. An attack out of its end is the dash attack too.
                name: "dodge",
                startup: 1,
                active: 13,
                recovery: 10,
                motion: (
                    clip: (
                        source: "9b5f353a-2c97-45c7-a70f-bcab216de811",
                    ),
                ),
                hurtboxes: [
                    (name: "body", from: 1, to: 14, state: Off),
                ],
                invulnerable: [(from: 1, to: 14)],
                perfect_dodge: [(
                    from: 1,
                    to: 7,
                    volume: (offset: (0.0, 0.9, 0.0), shape: Capsule(radius: 0.55, length: 1.0)),
                    slow_motion: (per_mille: 200, steps: 30),
                    counter: (ticks: 45, allow: [(intent: "light", move: "dash_attack")]),
                )],
                cancels: [
                    (from: 9, to: 24, allow: [
                        (intent: "light", move: "dash_attack"),
                        (intent: "skill", move: "skill"),
                    ]),
                    (from: 16, to: 24, allow: [(intent: "dodge", move: "dodge", when: Instant)]),
                ],
                cues: [
                    (name: "dodge_start", at: 0),
                    (name: "skid", at: 10),
                ],
            ),
            (
                // 567 ms: out of a dodge's end, thrown forward low with the blade trailing, cutting across
                // on the way past. It covers about 2.6 m and homes in on what it's aimed at.
                name: "dash_attack",
                startup: 5,
                active: 5,
                recovery: 24,
                motion: (
                    clip: (
                        source: "997ddfa0-e2bf-4887-94dd-e8f51cb6e958",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "dash_hit",
                        from: 5,
                        to: 10,
                        path: "blade",
                        shape: Capsule(radius: 0.26, length: 0.9),
                        attack: (damage: 10, poise: 12, weight: Medium, hitstop: 5, knockback: (distance: 0.5, ticks: 10)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 34, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 18, to: 34, allow: [(intent: "light", move: "light_1")]),
                ],
                warps: [
                    (from: 0, to: 10, max_distance: 2.0, max_turn: 1.2, keep: 1.1),
                ],
                cues: [
                    (name: "swing", at: 5),
                    (name: "skid", at: 10),
                ],
            ),
            (
                // 867 ms: a burst with two hits, safe to start and open to punishment after. A coiled
                // drop that takes a hit for free, a whole turn with the arm out, and a rising cut coming
                // out of the turn, ended by a flick of the blade.
                name: "skill",
                startup: 12,
                active: 14,
                recovery: 26,
                motion: (
                    clip: (
                        source: "9491f5d1-0c11-45c9-8139-8f54918b25f6",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "skill_hit_1",
                        from: 12,
                        to: 16,
                        path: "blade",
                        shape: Capsule(radius: 0.24, length: 0.9),
                        attack: (damage: 8, poise: 10, weight: Light, hitstop: 4, knockback: (distance: 0.2, ticks: 6)),
                    ),
                    (
                        name: "skill_hit_2",
                        from: 21,
                        to: 26,
                        path: "blade",
                        shape: Capsule(radius: 0.28, length: 0.9),
                        attack: (damage: 16, poise: 24, weight: Medium, hitstop: 8, knockback: (distance: 0.6, ticks: 10)),
                    ),
                ],
                invulnerable: [(from: 0, to: 12)],
                parry: [(from: 2, to: 6)],
                cancels: [
                    (from: 38, to: 52, allow: [
                        (intent: "dodge", move: "dodge"),
                        (intent: "light", move: "light_1"),
                    ]),
                ],
                warps: [
                    (from: 0, to: 12, max_distance: 1.0, max_turn: 1.2, keep: 1.0),
                ],
                cues: [
                    (name: "skill_flash", at: 0),
                    (name: "skill_hit", at: 12),
                    (name: "skill_hit", at: 21),
                    (name: "step", at: 31),
                ],
            ),
            (
                // 300 ms: a light hit's. A dodge gets out of its end.
                name: "flinch",
                startup: 0,
                active: 6,
                recovery: 12,
                cancels: [(from: 10, to: 18, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 500 ms: a medium hit's.
                name: "stagger",
                startup: 0,
                active: 10,
                recovery: 20,
                cancels: [(from: 22, to: 30, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 1,167 ms: a heavy hit's, down and up again, untouchable throughout.
                name: "knockdown",
                startup: 0,
                active: 30,
                recovery: 40,
                invulnerable: [(from: 0, to: 70)],
                cancels: [(from: 60, to: 70, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "knocked_down", at: 0)],
            ),
            (
                // 1,500 ms: a broken poise's, open to punishment: hits land and it stays dazed.
                name: "dazed",
                startup: 0,
                active: 60,
                recovery: 30,
                armour: [(from: 0, to: 90, threshold: 1000)],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 2 s, with no way out: the fight's over for this one.
                name: "defeat",
                startup: 0,
                active: 30,
                recovery: 90,
                cues: [(name: "falls", at: 0)],
            ),
            (
                // 567 ms: a party's next member arriving, on the dash attack's clip: a throw forward low that
                // cuts across on the way past, untouchable until it's about to land. Its aim is whoever left's.
                name: "swap_in",
                startup: 5,
                active: 5,
                recovery: 24,
                motion: (
                    clip: (
                        source: "997ddfa0-e2bf-4887-94dd-e8f51cb6e958",
                        paths: [(
                            name: "blade",
                            follows: Bone("RightHand"),
                            offset: (-0.234, -0.002, 0.417),
                            rotation: (0.5818, -0.5914, -0.3876, 0.4019),
                        )],
                    ),
                ),
                hitboxes: [
                    (
                        name: "swap_hit",
                        from: 5,
                        to: 10,
                        path: "blade",
                        shape: Capsule(radius: 0.26, length: 0.9),
                        attack: (damage: 12, poise: 14, weight: Medium, hitstop: 5, knockback: (distance: 0.5, ticks: 10)),
                    ),
                ],
                invulnerable: [(from: 0, to: 5)],
                cancels: [
                    (from: 18, to: 34, allow: [
                        (intent: "dodge", move: "dodge"),
                        (intent: "light", move: "light_1"),
                    ]),
