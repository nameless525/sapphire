                        (130, [Swap]), // Aster comes in on her `swap_in`.
                        (180, [Light]), // Her punch.
                        (194, [Light]), // Out of it, her kick.
                        (270, [Swap]), // Wren comes in on the staff's `swap_in`.
                        (320, [Light]), // The staff's `light_1`,
                        (336, [Light]), // `light_2`,
                        (352, [Light]), // and `light_1` again: the string is two, and goes round.
                        (420, [Skill]), // The skill's turn.
                        (500, [Swap]), // The heroine has rested: back to her.
