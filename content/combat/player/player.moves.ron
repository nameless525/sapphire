                warps: [
                    (from: 0, to: 10, max_distance: 2.0, max_turn: 1.2, keep: 1.1),
                ],
                cues: [
                    (name: "swap_in", at: 0),
                    (name: "swing", at: 5),
                    (name: "skid", at: 10),
                ],
            ),
        ],
    ),
)
