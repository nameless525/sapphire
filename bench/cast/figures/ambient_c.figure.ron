// An ambient figure of the benchmark's crowd (M5 B3): a lady in a long flared rose dress with a white shawl and her hair in a bun. One material, at the
// crowd's row of about 3,000 triangles.
// It lists no joints: it shares `ambient_a`'s skeleton (`skeleton` in `bench/cast/cast.ron`), so one
// pose serves the crowd.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_c",
        name: "ambient_c",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [],
        regions: [
            (name: "skin", albedo: [(0.0, "#fbe6da"), (1.0, "#e8c4b0")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#7a3a2a"), (1.0, "#3a1410")], specular: 0.45, specular_size: 0.35),
            (name: "dress", albedo: [(0.0, "#e88aa4"), (1.0, "#9a3a58")], shadow_bias: 0.55),
            (name: "shawl", albedo: [(0.0, "#fafafa"), (1.0, "#c8ccd8")]),
            (name: "lace", albedo: [(0.0, "#f8e4ec"), (1.0, "#d4a8b8")]),
            (name: "pin", albedo: [(0.0, "#f4e4a8"), (1.0, "#a8843a")], specular: 1.0, specular_size: 0.8, matcap: 1.0),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "dress", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "dress", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "dress", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "lace", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "lace", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "pin", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 14, arc: Some((-30.0, 210.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The bun and its pin, the dress's skirt to the ground and the shawl over the shoulders.
            Loft((
                region: "hair", bones: ["head"], sides: 12,
                from: (0.0, 1.42, -0.09), to: (0.0, 1.5, -0.13),
                rings: [(at: 0.0, radius: (0.03, 0.03)), (at: 0.5, radius: (0.055, 0.05)), (at: 1.0, radius: (0.02, 0.02))],
            )),
            Loft((
                region: "pin", bones: ["head"], sides: 6,
                from: (-0.07, 1.47, -0.11), to: (0.07, 1.47, -0.11),
                rings: [(at: 0.0, radius: (0.005, 0.005)), (at: 1.0, radius: (0.005, 0.005))],
            )),
            Loft((
                region: "dress", bones: ["hips", "upperleg.l", "upperleg.r", "lowerleg.l", "lowerleg.r"], sides: 22, blend: 0.1, v: (0.2, 1.0), thickness: 0.01,
                from: (0.0, 0.86, 0.0), to: (0.0, 0.03, 0.0),
                rings: [(at: 0.0, radius: (0.135, 0.105)), (at: 0.3, radius: (0.2, 0.17)), (at: 0.7, radius: (0.29, 0.26)), (at: 1.0, radius: (0.34, 0.31))],
            )),
            Loft((
                region: "lace", bones: ["hips", "lowerleg.l", "lowerleg.r"], sides: 22, blend: 0.1, thickness: 0.012,
                from: (0.0, 0.06, 0.0), to: (0.0, 0.03, 0.0),
                rings: [(at: 0.0, radius: (0.33, 0.3)), (at: 1.0, radius: (0.345, 0.315))],
            )),
            Loft((
                region: "shawl", bones: ["chest", "upperarm.l", "upperarm.r"], sides: 18, blend: 0.08, thickness: 0.01,
                from: (0.0, 1.27, 0.0), to: (0.0, 1.02, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.075)), (at: 0.4, radius: (0.2, 0.12)), (at: 1.0, radius: (0.22, 0.13))],
            )),
        ],
    ),
)
