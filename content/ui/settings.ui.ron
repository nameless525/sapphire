// The settings (M3 U7): each row steps through what it can be on a press, which a pad, a key and a finger all have.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "settings.model.ron",
        styles: [
            (name: "title", role: "display", size: 32, weight: 700),
            (name: "row", role: "body", size: 20, weight: 500),
            (name: "value", role: "body", size: 18, weight: 700),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, align: Center, justify: Center, safe_area: true),
                look: (fill: Color((6, 8, 14, 190))),
            ),
            (
                name: "panel",
                parent: "root",
                layout: (direction: Column, gap: 8, width: Points(560), max_width: Percent(92), max_height: Percent(96), padding: (left: 24, right: 24, top: 16, bottom: 16)),
                look: (shape: Slice(sprite: Button, corner: 16),
                    fill: Color((20, 26, 60, 255)),
                    outline: (color: (120, 190, 255, 255), width: 1.5),),
            ),
            (
                name: "title",
                parent: "panel",
                text: (
                    key: "settings-title",
                    style: "title",
                    color: (240, 246, 255, 255),
                    shadow: (color: (0, 0, 0, 180), offset: (2, 2)),
                ),
            ),
            (
                name: "list",
                parent: "panel",
                layout: (direction: Column, gap: 8, shrink: 1, min_height: Points(112), padding: (left: 4, right: 4, top: 4, bottom: 4)),
                mask: true,
                scroll: Vertical,
            ),
            (
                name: "language",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    down: "size",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "language-text",
                parent: "language",
                text: (
                    key: "settings-language",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "language-value",
                parent: "language",
                text: (
                    key: "settings-language-en",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "language", prefix: "settings-language-"),
                ),
            ),
            (
                name: "size",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "language",
                    down: "sound",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "size-text",
                parent: "size",
                text: (
                    key: "settings-size",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "size-value",
                parent: "size",
                text: (
                    key: "settings-size-normal",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "size", prefix: "settings-size-"),
                ),
            ),
            (
                name: "sound",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "size",
                    down: "rumble",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "sound-text",
                parent: "sound",
                text: (
                    key: "settings-sound",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "sound-value",
                parent: "sound",
                text: (
                    key: "settings-sound-value",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "percent", path: "sound")],
                ),
            ),
            (
                name: "rumble",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "sound",
                    down: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "rumble-text",
                parent: "rumble",
                text: (
                    key: "settings-rumble",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "rumble-value",
                parent: "rumble",
                text: (
                    key: "settings-rumble-on",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "rumble", prefix: "settings-rumble-"),
                ),
            ),
            (
                name: "back",
                parent: "panel",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "rumble",
                    fires: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "back-text",
                parent: "back",
                text: (
                    key: "settings-back",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
        ],
        timelines: [
            (name: "gone", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 0)])]),
            (
                name: "enter",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 0), (at: 0.22, value: 1, ease: Out)]),
                    (node: "panel", property: Y, keys: [(at: 0, value: 24), (at: 0.22, value: 0, ease: Back)]),
                ],
            ),
            (
                name: "leave",
                tracks: [
                    (node: "panel", property: Opacity, keys: [(at: 0, value: 1), (at: 0.16, value: 0, ease: In)]),
                ],
            ),
            (
                name: "focus-language",
                tracks: [(node: "language", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-size",
                tracks: [(node: "size", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-sound",
                tracks: [(node: "sound", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-rumble",
                tracks: [(node: "rumble", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
            (
                name: "focus-back",
                tracks: [(node: "back", property: Scale, keys: [(at: 0, value: 1.03), (at: 0.14, value: 1, ease: Out)])],
            ),
        ],
        states: [
            (name: "hidden", play: "gone"),
            (name: "entering", play: "enter", then: "open"),
            (name: "open", input: true),
            (name: "leaving", play: "leave", then: "hidden"),
        ],
        transitions: [
            (from: "hidden", on: "open", to: "entering"),
            (from: "open", on: "back", to: "leaving"),
            (from: "open", on: "close", to: "leaving"),
        ],
    ),
)
