    type: "sapphire::gameplay::InputsDocument",
    version: 1,
    data: (
        about: "two fighters close and trade: strings, heavies through armour, a knockdown, a poise break and a defeat with its finish freeze",
        ticks: 1500,
        tracks: [
            (
                who: Cast(0),
