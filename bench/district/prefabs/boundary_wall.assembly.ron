// A prefab: eight metres of the district's boundary wall, under a tiled coping, its middle at its origin.
// Its three slots, wood, stone and cloth, take the district's texture sets placement by placement.
(
    type: "sapphire::pipeline::Assembly",
    version: 1,
    data: (
        kits: {},
        slots: [
            (name: "wood", tile: (1.5, 1.5)),
            (name: "stone", tile: (2.0, 2.0), projection: Box),
            (name: "cloth", tile: (1.0, 1.0), projection: Box),
        ],
        surfaces: [
            (pieces: ["#*"], material: Some("timber"), slot: "wood"),
            (pieces: ["#*"], material: Some("lattice"), slot: "wood"),
            (pieces: ["#*"], material: Some("door"), slot: "wood"),
            (pieces: ["#*"], material: Some("boards"), slot: "wood"),
            (pieces: ["#*"], material: Some("back"), slot: "wood"),
            (pieces: ["#*"], material: Some("frame"), slot: "wood"),
            (pieces: ["#*"], material: Some("sign"), slot: "wood"),
            (pieces: ["#*"], material: Some("plaster"), slot: "wood"),
            (pieces: ["#*"], material: Some("gable"), slot: "wood"),
            (pieces: ["#*"], material: Some("plinth"), slot: "stone"),
            (pieces: ["#*"], material: Some("trim"), slot: "stone"),
            (pieces: ["#*"], material: Some("tiles"), slot: "stone"),
