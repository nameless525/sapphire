                    size: (6.4, 5.0, 3.6),
                    plinth: (height: 0.45, proud: 0.06),
                    posts: Some((width: 0.22, proud: 0.04, bays: (3, 1))),
                    beams: [(at: 3.6, height: 0.26, proud: 0.07)],
                    openings: [
                        (kind: Door, size: (1.3, 2.4)),
                        (kind: Window, at: (-2.13, 1.1), size: (1.2, 1.2), lattice: (3, 2)),
                        (kind: Window, at: (2.13, 1.1), size: (1.2, 1.2), lattice: (3, 2)),
                        (side: Right, kind: Moon, at: (0.0, 1.1), size: (1.3, 1.3), lattice: (2, 2)),
                        (side: Left, kind: Moon, at: (0.0, 1.1), size: (1.3, 1.3), lattice: (2, 2)),
