// What a menu's paths can read (M3 U9): the title's, the pause's, the settings' and any screen's whose row in
// `menus.ron` reads `Menu`. Generated from `game_ui::menus::MenuModel`, which a test holds this to. A cook
// refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "auto_target", kind: Text),
            (path: "camera_motion", kind: Number),
            (path: "can_continue", kind: Bool),
            (path: "can_leave", kind: Bool),
            (path: "effects", kind: Number),
            (path: "flashes", kind: Text),
            (path: "hold_dodge", kind: Text),
            (path: "hold_heavy", kind: Text),
            (path: "hold_light", kind: Text),
            (path: "hold_lock_on", kind: Text),
            (path: "hold_skill", kind: Text),
            (path: "language", kind: Text),
            (path: "mono", kind: Text),
            (path: "music", kind: Number),
            (path: "rumble", kind: Text),
            (path: "shake", kind: Number),
            (path: "size", kind: Text),
            (path: "sound", kind: Number),
            (path: "speakers", kind: Text),
            (path: "subtitle_background", kind: Text),
            (path: "subtitle_size", kind: Text),
            (path: "subtitles", kind: Text),
            (path: "text_size", kind: Text),
            (path: "voice", kind: Number),
        ],
    ),
)
