// Wren's moves (M5 C12): the third playable kind, with a staff. Frame data in 60 Hz ticks. A short set: a
// string of two for the attack button, which goes round again, one skill, a dodge, the swap-in assist a party's swap brings, and
// the five moves a hit forces. Only a party reads `swap` and `swap_in`. Nothing here is tuned: M5 tunes no
// fight, and the damage and poise are round numbers that say nothing about balance.
//
// Every move with a clip plays the heroine's (`content/combat/player/`), cooked for Wren's rig through its
// sidecar's `also`, so each move is as long as its clip. Her finisher, `light_3`, keys her sleeves' morph
// targets, which Wren's model hasn't, so it can't be borrowed and the string is two. Root keys are that clip's `root` and `root_turn`,
// copied key for key; the staff is keyed by hand, coarsely, from the clips at each move's own ticks, as
// Aster's fists are. In root space +Z is forward and +X the left. `staff` is a point on the staff's
// striking length, and a hit is a capsule there along its +Y, which the keys turn to point forward.
//
// The reactions have the heroine's names and lengths: a hit forces them, and the graph draws them from the
// heroine's reactions.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A dodge beats a skill beats an attack when two could fire at one instant.
            (name: "light", button: Light, buffer: 14, priority: 1),
            (name: "skill", button: Skill, buffer: 10, priority: 2),
            (name: "dodge", button: Dodge, buffer: 8, priority: 3),
            (name: "swap", button: Swap, buffer: 12, priority: 4),
        ],
        neutral: [
            (intent: "light", move: "light_1"),
            (intent: "skill", move: "skill"),
            (intent: "dodge", move: "dodge"),
        ],
        fighter: (
            health: 280,
            poise: 55,
            poise_refill: 240,
            hurtboxes: [
                // From the ground to the top of the hair at 1.66 m. A dodge turns it off.
                (name: "body", offset: (0.0, 0.83, 0.0), shape: Capsule(radius: 0.28, length: 1.1)),
            ],
            reactions: (
                light: "flinch",
                medium: "stagger",
                heavy: "knockdown",
                poise_break: "dazed",
                defeat: "defeat",
            ),
            // Aster's: with no run or jog of its own, the graph strides at the walk's pace. Metres, seconds
            // and degrees, and sapphire_moves' `MOVEMENT_LIMITS` says what each may be.
            movement: (
                run_speed: 3.6,
                walk_speed: 2.0,
                run_stick: 0.9,
                walk_stick: 0.5,
                acceleration: 40.0,
                deceleration: 42.0,
                turn_rate_degrees: 720.0,
                jump_speed: 7.0,
                gravity: 22.0,
                air_acceleration: 18.0,
                max_fall_speed: 30.0,
