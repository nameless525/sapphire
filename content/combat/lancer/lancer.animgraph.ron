// How the Lancer's clips play (M3 C2). Its guard and strides are KayKit's, retargeted onto its own
// lengths by the pack's sidecars; its attacks, hop back and reactions are its own key-pose documents,
// each as long as the move in `lancer.moves.ron` that plays it.
(
    type: "sapphire::assets::AnimGraph",
    version: 1,
    data: (
        clips: [
            // Rig_Medium_CombatMelee, Rig_Medium_MovementBasic and Rig_Medium_MovementAdvanced.
            (name: "guard", source: "aa00c3be-b36a-477a-95a2-deb148f75ff8", clip: "Melee_2H_Idle", target: "41e229ad-28a3-41f9-aeb8-ba214e06be6a"),
