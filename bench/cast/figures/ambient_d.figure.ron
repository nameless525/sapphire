// An ambient figure of the benchmark's crowd (M5 B3): a traveller in a grey-green coat to the knees, its hood up, with a satchel and a staff. One material, at the
// crowd's row of about 3,000 triangles.
// It lists no joints: it shares `ambient_a`'s skeleton (`skeleton` in `bench/cast/cast.ron`), so one
// pose serves the crowd.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_d",
        name: "ambient_d",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [],
        regions: [
            (name: "skin", albedo: [(0.0, "#f0d6c4"), (1.0, "#d4b098")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#c8c0b4"), (1.0, "#787068")], specular: 0.35, specular_size: 0.4),
            (name: "coat", albedo: [(0.0, "#7a8a74"), (1.0, "#323c30")], shadow_bias: 0.55),
            (name: "lining", albedo: [(0.0, "#b8a888"), (1.0, "#6a5a40")]),
            (name: "leather", albedo: [(0.0, "#6a4430"), (1.0, "#2a160c")], specular: 0.3),
            (name: "wood", albedo: [(0.0, "#a8784a"), (1.0, "#4a2c14")], specular: 0.2),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "coat", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "coat", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "coat", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "lining", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "lining", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "leather", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 10, arc: Some((-15.0, 195.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The coat's skirt, the hood, a belt and the staff in the right hand.
            Loft((
                region: "coat", bones: ["hips", "upperleg.l", "upperleg.r"], sides: 18, blend: 0.08, v: (0.3, 1.0), arc: Some((-75.0, 255.0)), thickness: 0.012,
                from: (0.0, 0.86, 0.0), to: (0.0, 0.42, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.11)), (at: 1.0, radius: (0.2, 0.17))],
            )),
            Loft((
                region: "coat", bones: ["head", "chest"], sides: 16, blend: 0.05, arc: Some((-40.0, 220.0)), thickness: 0.014,
                from: (0.0, 1.22, -0.02), to: (0.0, 1.52, -0.01),
                rings: [(at: 0.0, radius: (0.11, 0.1)), (at: 0.4, radius: (0.11, 0.12)), (at: 0.8, radius: (0.1, 0.11)), (at: 1.0, radius: (0.05, 0.05))],
            )),
            Loft((
                region: "leather", bones: ["hips", "spine"], sides: 16,
                from: (0.0, 0.85, 0.0), to: (0.0, 0.89, 0.0),
                rings: [(at: 0.0, radius: (0.142, 0.112)), (at: 1.0, radius: (0.138, 0.108))],
            )),
            Loft((
                region: "wood", bones: ["handslot.r"], sides: 8,
                from: (-0.72, 1.2, -0.7), to: (-0.72, 1.2, 0.9),
                rings: [(at: 0.0, radius: (0.014, 0.014)), (at: 0.9, radius: (0.016, 0.016)), (at: 1.0, radius: (0.024, 0.024))],
            )),
        ],
    ),
)
