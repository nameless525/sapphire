// The screen the tree's goldens hold (M3 U4): Japanese and Latin from keys, nine-slices, gradients, a
// mask and bound values, at any aspect. Not a game's: `title.ui.ron` and its neighbours are.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "test_screen.model.ron",
        styles: [
            (name: "title", role: "display", size: 48, weight: 700),
            (name: "subtitle", role: "display", size: 18, weight: 500),
            (name: "menu", role: "body", size: 20, weight: 500),
            (name: "body", role: "body", size: 16, line_height: 1.5),
            (name: "number", role: "display", size: 16, weight: 600),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, gap: 16, padding: (left: 40, right: 40, top: 28, bottom: 28), safe_area: true),
                look: (fill: Gradient(from: (12, 18, 44, 255), to: (58, 30, 92, 255), angle: 60)),
            ),
            (
                name: "header",
                parent: "root",
                layout: (direction: Row, align: End, justify: SpaceBetween),
            ),
            (
                name: "title",
                parent: "header",
                text: (key: "test-screen-title", style: "title", color: (245, 240, 255, 255)),
            ),
            (
                name: "subtitle",
                parent: "header",
                text: (
                    key: "test-screen-subtitle",
                    style: "subtitle",
                    color: (150, 215, 235, 255),
                    args: [(name: "level", path: "level")],
                ),
            ),
            (
                name: "body",
                parent: "root",
                layout: (direction: Row, gap: 24, grow: 1, min_height: Points(0)),
            ),
            (
                name: "menu",
                parent: "body",
                layout: (direction: Column, gap: 10, width: Percent(30), min_width: Points(180), shrink: 0),
            ),
            (
                name: "sound",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (
                    shape: Slice(sprite: Button, corner: 14),
                    fill: Gradient(from: (232, 92, 130, 255), to: (120, 70, 200, 255), angle: 0),
                    outline: (color: (255, 225, 235, 255), width: 2),
                    slant: 0.12,
                ),
            ),
            (
                name: "sound-label",
                parent: "sound",
                text: (key: "test-screen-sound", style: "menu", color: (255, 255, 255, 255)),
            ),
            (
                name: "display",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (shape: Slice(sprite: Button, corner: 14), fill: Color((40, 48, 92, 255)), slant: 0.12),
            ),
            (
                name: "display-label",
                parent: "display",
                text: (key: "test-screen-display", style: "menu", color: (225, 230, 255, 255)),
            ),
            (
                name: "language",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (shape: Slice(sprite: Button, corner: 14), fill: Color((40, 48, 92, 255)), slant: 0.12),
            ),
            (
                name: "language-label",
                parent: "language",
                text: (key: "test-screen-language", style: "menu", color: (225, 230, 255, 255)),
            ),
            (
                name: "controls",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (shape: Slice(sprite: Button, corner: 14), fill: Color((40, 48, 92, 255)), slant: 0.12),
                binds: [(to: Shown, path: "show_badge")],
            ),
            (
                name: "controls-label",
                parent: "controls",
                text: (key: "test-screen-controls", style: "menu", color: (225, 230, 255, 255)),
            ),
            (
                name: "panel",
                parent: "body",
                mask: true,
                layout: (direction: Column, gap: 12, grow: 1, width: Points(0), min_height: Points(0), padding: (left: 20, right: 20, top: 18, bottom: 18)),
                look: (
                    shape: Slice(sprite: Button, corner: 18),
                    fill: Gradient(from: (24, 30, 70, 255), to: (34, 24, 64, 255), angle: 90),
                    outline: (color: (110, 150, 230, 255), width: 1.5),
                ),
            ),
            (
                name: "health-row",
                parent: "panel",
                layout: (direction: Row, gap: 12, align: Center, shrink: 0),
            ),
            (
                name: "health-text",
                parent: "health-row",
                text: (
                    key: "test-screen-health",
                    style: "number",
                    color: (240, 245, 255, 255),
                    args: [(name: "hp", path: "hp"), (name: "max", path: "max_hp")],
                ),
            ),
            (
                name: "health-bar",
                parent: "health-row",
                layout: (grow: 1, height: Points(14)),
                look: (shape: Slice(sprite: Bar, corner: 7), fill: Color((30, 200, 160, 255))),
                binds: [(to: Fill, path: "health")],
            ),
            (
                name: "paragraph",
                parent: "panel",
                layout: (shrink: 0),
                text: (key: "test-screen-body", style: "body", color: (225, 225, 240, 255), wrap: true),
            ),
            (
                name: "window",
                parent: "panel",
                mask: true,
                layout: (direction: Column, height: Points(40), shrink: 0, padding: (left: 12, right: 12, top: 4)),
                look: (fill: Color((12, 14, 40, 255))),
            ),
            (
                name: "window-text",
                parent: "window",
                layout: (shrink: 0),
                text: (key: "test-screen-body", style: "body", color: (150, 215, 235, 255), wrap: true),
            ),
            (
                name: "coins",
                parent: "root",
                layout: (anchored: (right: Points(40), bottom: Points(4))),
                text: (
                    key: "test-screen-coins",
                    style: "number",
                    color: (255, 215, 120, 255),
                    args: [(name: "coins", path: "coins")],
                ),
            ),
        ],
    ),
)
