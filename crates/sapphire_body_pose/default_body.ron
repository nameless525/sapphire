// How a body places its feet and turns its head: `sapphire_body_pose::tuning`, compiled in as
// `BodyTuning::shipped`. The simulation's bodies run on these, and a replay's `tables_hash` takes them, so a
// change here moves every replay's hash; presentation's own IK runs on them too. Each field's docs are on
// its struct, in `ik/feet.rs` and `ik/look.rs`. Angles are in radians, with degrees in comments.
(
    type: "sapphire::body_pose::BodyTuning",
    version: 1,
    data: (
        feet: (
            reach_up: 0.5,
            reach_down: 0.4,
            min_normal_y: 0.5,
            max_tilt: 0.6981317, // 40°
            plant_height: 0.12,
            max_drop: 0.3,
            max_raise: 0.08,
            ground_half_life: 0.04,
            hips_half_life: 0.06,
            fade: 0.12,
            pop_speed: 5.5,
            soften: 0.985,
        ),
        look: (
            yaw_limit: 1.2217305, // 70°
            up_limit: 0.5235988, // 30°
            down_limit: 0.6981317, // 40°
            hold: 1.9198622, // 110°
            rate: 4.5,
            half_life: 0.07,
            eye_rate: 14.0,
            eye_half_life: 0.02,
            fade: 0.25,
        ),
    ),
)
