                moon: (direction: (-0.82, -0.18, -0.55), color: (0.62, 0.72, 1.0), intensity: 0.14),
                sky: (zenith: (0.025, 0.07, 0.26), horizon: (0.22, 0.38, 0.62), ground: (0.04, 0.06, 0.1)),
