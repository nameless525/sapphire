// What `hud.ui.ron`'s paths can read, generated from `game_ui::menus::HudModel`, which a test holds
// this to. A cook refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "banner", kind: Text),
            (path: "boss", kind: Text),
            (path: "can_skip", kind: Bool),
            (path: "enemy", kind: Text),
            (path: "fight_words", kind: Number),
            (path: "has_banner", kind: Bool),
            (path: "has_boss", kind: Bool),
            (path: "has_enemy", kind: Bool),
            (path: "has_objective", kind: Bool),
            (path: "has_speaker", kind: Bool),
            (path: "has_subtitle", kind: Bool),
            (path: "level", kind: Number),
            (path: "names_enemy", kind: Bool),
            (path: "objective", kind: Text),
            (path: "player", kind: Text),
            (path: "speaker", kind: Text),
            (path: "subtitle", kind: Text),
            (path: "touch", kind: Bool),
        ],
    ),
)
