// Sapphire's sample effects (M2 E2), compiled into `sapphire_vfx`:
// `EffectLibrary::default_effects`, whose module docs (`document`) have every field. A hit's spark,
// a sword's trail and a puff of dust, authored against the look-dev character in Jinzhou at noon
// and at night; then a heavy hit's spark and a fight's last blow (M2 E3), which go last so the IDs
// before them hold. Every number is a starting point for art direction, not a measurement.
//
// - An effect's emitters are modules (`spawn`, `source`, `motion`, `shape`, `facing`, `light`) and
//   curves over a particle's life: `(t, value)` keys, t from 0 to 1, linear between them.
// - Colors are linear. An emissive color is relative to the display, whatever the hour's exposure:
//   1.0 is about display white before the tone curve, and past it blooms.
// - `additive`: 1 is pure light added over what's behind, 0 a surface that covers it.
(
    type: "sapphire::vfx::EffectLibrary",
    version: 1,
    data: (
        effects: [
            (
                // A blade striking something: a flash on the frame it lands, a shock ring opening
                // around it, sparks thrown away from the surface (the effect's +Y) and a few motes
                // that hang on after them. Warm, so it reads against a blue trail.
                name: "hit_spark",
                emitters: [
                    (
                        name: "flash",
                        spawn: Burst(count: 1),
                        lifetime: (0.08, 0.1),
                        shape: Star,
                        facing: Camera(spin: (-1.5, 1.5)),
                        size: [(0.0, 0.04), (0.2, 0.24), (1.0, 0.07)],
                        color: [(0.0, (4.5, 3.6, 2.2)), (1.0, (2.4, 1.1, 0.4))],
                        alpha: [(0.0, 1.0), (0.45, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "ring",
                        spawn: Burst(count: 1),
                        lifetime: (0.16, 0.2),
                        shape: Ring,
                        size: [(0.0, 0.03), (0.4, 0.2), (1.0, 0.3)],
                        color: [(0.0, (2.2, 1.6, 0.9)), (1.0, (1.0, 0.4, 0.12))],
                        alpha: [(0.0, 0.8), (1.0, 0.0)],
                    ),
                    (
                        name: "sparks",
                        spawn: Burst(count: 18),
                        lifetime: (0.14, 0.32),
                        motion: (speed: (3.5, 9.5), spread: 75.0, gravity: 6.0, drag: 4.5),
                        shape: Streak,
                        facing: Velocity(stretch: 0.016),
                        size_scale: (0.7, 1.3),
                        size: [(0.0, 0.016), (1.0, 0.006)],
                        color: [(0.0, (5.0, 3.6, 1.8)), (0.5, (3.5, 1.6, 0.5)), (1.0, (1.4, 0.4, 0.1))],
                        alpha: [(0.0, 1.0), (0.7, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "motes",
                        spawn: Burst(count: 6),
                        source: Sphere(0.05),
                        lifetime: (0.3, 0.55),
                        motion: (speed: (0.6, 1.8), spread: 90.0, gravity: 1.0, drag: 3.0),
                        shape: SoftDot,
                        size_scale: (0.7, 1.4),
                        size: [(0.0, 0.016), (1.0, 0.006)],
                        color: [(0.0, (3.0, 2.0, 0.9)), (1.0, (1.4, 0.45, 0.12))],
                        alpha: [(0.0, 1.0), (0.6, 0.8), (1.0, 0.0)],
                    ),
                ],
            ),
            (
                // A sword's arc, sampled from the blade's base and tip: a crisp white-blue band
                // along the outer edge, the soft blue falling away from it toward the hilt, the
                // strip thinning toward the tip as it ages. Mostly light, with enough body that
                // the blue reads over white plaster at noon.
                name: "sword_trail",
                trail: Some((
                    lifetime: 0.2,
                    max_samples: 48,
                    width: [(0.0, 1.0), (0.5, 0.75), (1.0, 0.2)],
                    anchor: 1.0,
                    color: [(0.0, (0.1, 0.34, 1.0)), (0.5, (0.07, 0.2, 0.8)), (1.0, (0.08, 0.1, 0.5))],
                    alpha: [(0.0, 0.0), (0.05, 1.0), (0.5, 0.75), (1.0, 0.0)],
                    core: (
                        position: 0.95,
                        half_width: 0.018,
                        color: [(0.0, (3.5, 4.0, 4.5)), (0.5, (2.2, 3.0, 4.5)), (1.0, (0.6, 1.2, 3.0))],
                    ),
                    glow_reach: 0.5,
                    additive: 0.8,
                    start_fade: 0.05,
                )),
            ),
            (
                // Dust kicked up at the feet: a low soft puff, lit by the hour rather than glowing,
                // so it stays dim at night, and fading into the ground rather than cutting it.
                name: "dust_puff",
                emitters: [
                    (
                        name: "puff",
                        spawn: Burst(count: 10),
                        source: Disc(0.22),
                        lifetime: (0.5, 0.95),
                        motion: (speed: (0.25, 0.9), spread: 80.0, gravity: -0.15, drag: 3.2),
                        shape: SoftDot,
                        facing: Camera(spin: (-0.6, 0.6)),
                        light: Lit,
                        additive: 0.0,
                        soft: 0.25,
                        size_scale: (0.7, 1.3),
                        size: [(0.0, 0.08), (0.5, 0.26), (1.0, 0.36)],
                        color: [(0.0, (0.78, 0.72, 0.62))],
                        alpha: [(0.0, 0.0), (0.15, 0.5), (1.0, 0.0)],
                    ),
                ],
            ),
            (
                // A heavy blow: `hit_spark` with more behind it. A star that opens wider, two rings a
                // beat apart, more sparks thrown harder. Still small against the frame: the screen
                // effect over it carries the weight, and a big flash would only wash the character out.
                name: "heavy_spark",
                emitters: [
                    (
                        name: "flash",
                        spawn: Burst(count: 1),
                        lifetime: (0.11, 0.13),
                        shape: Star,
                        facing: Camera(spin: (-1.0, 1.0)),
                        size: [(0.0, 0.08), (0.15, 0.42), (1.0, 0.12)],
                        color: [(0.0, (4.5, 3.8, 2.6)), (1.0, (2.4, 1.0, 0.35))],
                        alpha: [(0.0, 1.0), (0.5, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "ring",
                        spawn: Burst(count: 1),
                        lifetime: (0.2, 0.24),
                        shape: Ring,
                        size: [(0.0, 0.05), (0.4, 0.36), (1.0, 0.5)],
                        color: [(0.0, (2.4, 1.8, 1.0)), (1.0, (1.0, 0.4, 0.12))],
                        alpha: [(0.0, 0.85), (1.0, 0.0)],
                    ),
                    (
                        name: "sparks",
                        spawn: Burst(count: 34),
                        lifetime: (0.18, 0.42),
                        motion: (speed: (5.0, 13.0), spread: 85.0, gravity: 7.0, drag: 4.5),
                        shape: Streak,
                        facing: Velocity(stretch: 0.02),
                        size_scale: (0.8, 1.5),
                        size: [(0.0, 0.02), (1.0, 0.007)],
                        color: [(0.0, (5.0, 3.6, 1.8)), (0.5, (3.5, 1.6, 0.5)), (1.0, (1.4, 0.4, 0.1))],
                        alpha: [(0.0, 1.0), (0.7, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "motes",
                        spawn: Burst(count: 10),
                        source: Sphere(0.08),
                        lifetime: (0.4, 0.75),
                        motion: (speed: (0.8, 2.4), spread: 100.0, gravity: 1.0, drag: 3.0),
                        shape: SoftDot,
                        size_scale: (0.7, 1.4),
                        size: [(0.0, 0.02), (1.0, 0.007)],
                        color: [(0.0, (3.0, 2.0, 0.9)), (1.0, (1.4, 0.45, 0.12))],
                        alpha: [(0.0, 1.0), (0.6, 0.8), (1.0, 0.0)],
                    ),
                ],
            ),
            (
                // A fight's last blow: a cross of cold light through the warm burst, as the world goes
                // to ink behind it, and sparks that fly long enough to outlast the freeze.
                name: "finish_burst",
                emitters: [
                    (
                        name: "flash",
                        spawn: Burst(count: 2),
                        lifetime: (0.14, 0.18),
                        shape: Star,
                        facing: Camera(spin: (-0.6, 0.6)),
                        size: [(0.0, 0.1), (0.15, 0.6), (1.0, 0.16)],
                        color: [(0.0, (3.0, 3.6, 4.5)), (1.0, (0.7, 1.0, 2.4))],
                        alpha: [(0.0, 1.0), (0.5, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "ring",
                        spawn: Burst(count: 1),
                        lifetime: (0.3, 0.34),
                        shape: Ring,
                        size: [(0.0, 0.08), (0.45, 0.62), (1.0, 0.85)],
                        color: [(0.0, (2.2, 2.4, 2.8)), (1.0, (0.4, 0.6, 1.3))],
                        alpha: [(0.0, 0.9), (1.0, 0.0)],
                    ),
                    (
                        name: "sparks",
                        spawn: Burst(count: 52),
                        lifetime: (0.3, 0.7),
                        motion: (speed: (5.0, 16.0), spread: 110.0, gravity: 5.0, drag: 3.5),
                        shape: Streak,
                        facing: Velocity(stretch: 0.022),
                        size_scale: (0.8, 1.6),
                        size: [(0.0, 0.022), (1.0, 0.007)],
                        color: [(0.0, (5.0, 4.2, 2.8)), (0.5, (3.5, 1.6, 0.5)), (1.0, (1.2, 0.35, 0.1))],
                        alpha: [(0.0, 1.0), (0.75, 1.0), (1.0, 0.0)],
                    ),
                    (
                        name: "motes",
                        spawn: Burst(count: 18),
                        source: Sphere(0.12),
                        lifetime: (0.6, 1.1),
                        motion: (speed: (0.8, 2.8), spread: 120.0, gravity: 0.6, drag: 2.6),
                        shape: SoftDot,
                        size_scale: (0.7, 1.5),
                        size: [(0.0, 0.022), (1.0, 0.007)],
                        color: [(0.0, (3.0, 2.2, 1.2)), (1.0, (1.2, 0.5, 0.2))],
                        alpha: [(0.0, 1.0), (0.6, 0.8), (1.0, 0.0)],
                    ),
                ],
            ),
        ],
    ),
)
