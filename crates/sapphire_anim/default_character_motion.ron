// How a character's hair and cloth take a fight, and how much of its IK shows: `sapphire_anim::motion`,
// compiled in as `CharacterMotion::shipped`. Presentation's only, so no replay takes these. How the feet and
// the look solve is the simulation's, in `sapphire_body_pose`'s `default_body.ron`. Each field's docs are on
// its struct, in `springs.rs`. Angles are in radians, with degrees in comments.
(
    type: "sapphire::anim::CharacterMotion",
    version: 2,
    data: (
        // Tuned by eye on the character's run, walk, idle, hit, dodge and strike against the reference
        // games, where hair lags and swings and keeps its shape.
        springs: (
            root_inertia: 0.25,
            anchor_inertia: 0.4,
            swing_limit: 0.87266463, // 50°
            bend_limit: 0.34906587, // 20°
        ),
        // How much of each IK shows, from when a character starts: 0 to 1.
        feet_weight: 1.0,
        look_weight: 1.0,
    ),
)
