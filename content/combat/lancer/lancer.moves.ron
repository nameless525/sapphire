                cues: [
                    (name: "telegraph", at: 0),
                    (name: "swing", at: 30),
                    (name: "lunge_land", at: 34),
                ],
            ),
            (
                // 533 ms. A hop back two metres out of reach, the spear kept between it and the foe: no blow,
                // and a brain picks it against someone swinging, or strings it after a stab.
                name: "backstep",
                startup: 0,
                active: 0,
                recovery: 32,
                motion: (
                    root: [
                        (at: 10, offset: (0.0, 0.0, -0.25)),
                        (at: 16, offset: (0.0, 0.0, -1.3)),
                        (at: 21, offset: (0.0, 0.0, -2.0)),
                    ],
                ),
            ),
            (
                // 400 ms: a flinch, the head snapping back and the spear jerking up, for a hit that doesn't
                // break its poise. Unlike the warrior's, any hit starts it over: it's light on its feet.
                name: "stagger_light",
                startup: 0,
                active: 0,
                recovery: 24,
                cues: [(name: "stagger", at: 0)],
            ),
            (
                // 733 ms: knocked reeling two stumbling steps back, for a hit that breaks it. A hit takes its
                // numbers and can't cut this short: it's the opening a break earns.
                name: "stagger_heavy",
                startup: 0,
                active: 0,
                recovery: 44,
                armour: [(from: 0, to: 44, threshold: 1000)],
                motion: (
                    root: [
                        (at: 6, offset: (0.0, 0.0, -0.12)),
                        (at: 10, offset: (0.0, 0.0, -0.18)),
                        (at: 16, offset: (0.0, 0.0, -0.3)),
                        (at: 24, offset: (0.0, 0.0, -0.4)),
                    ],
