// The warrior uses a planted guard and separate strides for pursuit, retreat and circling.
// The attack clips follow the existing move ticks and blade paths in warrior.moves.ron.
(
    type: "sapphire::assets::AnimGraph",
    version: 1,
    data: (
        clips: [
            (name: "guard", source: "5b2f5eb4-d350-5bab-8892-5f74d3339138"),
            (name: "advance", source: "00a3d384-2d31-5db4-9cb7-85a545fd3a83"),
            (name: "charge", source: "2281c91a-9ebb-541d-9504-e73d0925d266"),
            (name: "retreat", source: "43563f38-e8f2-5249-a358-c9147f5a766c"),
