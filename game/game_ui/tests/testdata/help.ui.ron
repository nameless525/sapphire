// A screen no Rust knows (M3 U9): `menus.rs`'s `a_new_screen_is_documents` puts it beside the game's own by a
// row of its menus document, and walks it. It reads the menus' own model, shows the language the settings
// hold, opens the settings, and goes back by its machine. Its keys are the tables' own, so it draws.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "menu.model.ron",
        styles: [
            (name: "title", role: "heading", size: 32, weight: 800),
            (name: "row", role: "body", size: 20, weight: 500),
            (name: "value", role: "body", size: 18, weight: 700),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, align: Center, justify: Center, safe_area: true),
                look: (fill: Color((6, 8, 14, 190))),
            ),
            (
                name: "panel",
                parent: "root",
                layout: (direction: Column, gap: 8, width: Points(480), max_width: Percent(92), max_height: Percent(96), padding: (left: 24, right: 24, top: 16, bottom: 16)),
                look: (shape: Slice(sprite: Button, corner: 16), fill: Color((20, 26, 60, 255))),
            ),
            (
                name: "title",
                parent: "panel",
                text: (key: "settings-language", style: "title", color: (240, 246, 255, 255)),
            ),
            (
                name: "language",
                parent: "panel",
                text: (
                    key: "settings-language-en",
                    style: "value",
                    color: (255, 192, 56, 255),
                    key_from: (path: "language", prefix: "settings-language-"),
                ),
            ),
            (
                name: "settings",
                parent: "panel",
                layout: (direction: Row, align: Center, min_height: Points(48), padding: (left: 16, right: 16, top: 4, bottom: 4), shrink: 0),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    down: "back",
                    focused: (shape: Slice(sprite: Button, corner: 8), fill: Color((64, 104, 196, 255))),
                ),
            ),
            (
                name: "settings-text",
                parent: "settings",
                text: (key: "pause-settings", style: "row", color: (240, 246, 255, 255)),
            ),
            (
                name: "back",
                parent: "panel",
                layout: (direction: Row, align: Center, min_height: Points(48), padding: (left: 16, right: 16, top: 4, bottom: 4), shrink: 0),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "settings",
                    fires: "back",
                    focused: (shape: Slice(sprite: Button, corner: 8), fill: Color((64, 104, 196, 255))),
                ),
            ),
            (
                name: "back-text",
                parent: "back",
                text: (key: "settings-back", style: "row", color: (240, 246, 255, 255)),
            ),
        ],
        timelines: [
            (name: "gone", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 0)])]),
            (name: "enter", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 0), (at: 0.2, value: 1)])]),
            (name: "leave", tracks: [(node: "panel", property: Opacity, keys: [(at: 0, value: 1), (at: 0.16, value: 0)])]),
        ],
        states: [
            (name: "hidden", play: "gone"),
            (name: "entering", play: "enter", then: "open"),
            (name: "open", input: true),
            (name: "leaving", play: "leave", then: "hidden"),
        ],
        transitions: [
            (from: "hidden", on: "open", to: "entering"),
            (from: "open", on: "back", to: "leaving"),
            (from: "open", on: "close", to: "leaving"),
        ],
    ),
)
