// The guide at the Lantern Ward (M3 Q2): a line with a voice, a choice that sets the flag a fight's script
// reads, a choice that shows only once the ward is lit, a branch, and a way out.
(
    type: "sapphire::dialogue::DialogueDocument",
    version: 1,
    data: (
        start: "greet",
        // As someone walks through the gate of the Lantern Ward's Temple Court (M3 Q2b).
        opens_on: "court_entered",
        nodes: [
            (name: "greet", say: (speaker: "dialogue-guide-name", line: "dialogue-guide-greet", vo: "guide_greet"), next: "ask"),
            (name: "ask", say: (speaker: "dialogue-guide-name", line: "dialogue-guide-ask"), choices: [
                (line: "dialogue-guide-choice-light", to: "lit", set: [("ward_lit", 1)]),
                (line: "dialogue-guide-choice-again", to: "again", when: "flag.ward_lit >= 1"),
                (line: "dialogue-guide-choice-leave"),
            ]),
            (name: "lit", say: (speaker: "dialogue-guide-name", line: "dialogue-guide-thanks"), set: [("met_guide", 1)], next: "again"),
            (name: "again", branch: [(when: "flag.met_guide == 0", to: "greet")], otherwise: "farewell"),
            (name: "farewell", say: (speaker: "dialogue-guide-name", line: "dialogue-guide-farewell")),
        ],
    ),
)
