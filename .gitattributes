# Text files are stored and checked out with LF on every OS. Tests compare `include_str!`
# output against `\n`, and gradlew and other shell scripts must keep LF to run.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries: never normalize, diff or merge. Git LFS (spec §7.1) is deferred until art outgrows
# plain Git: the generated samples and M1's third-party look-dev content (about 13 MB) don't,
# and every CI checkout would spend LFS bandwidth.
# Source art and media.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
*.hdr binary
*.psd binary
*.blend binary
*.fbx binary
*.glb binary
*.vrm binary
*.bin binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
# Cooked or GPU-ready formats.
*.ktx2 binary
*.smoves binary
*.snav binary
*.szone binary
*.scol binary
*.dds binary
*.astc binary
*.smesh binary
*.sreplay binary
*.sav binary
*.bank binary
# Platform packaging.
*.jar binary
*.icns binary
*.ico binary

# The documents the editor knows (sapphire_document's kinds, M6 T7) merge by property path through
# `sapphire_document merge`, in a clone whose config names the driver (docs/getting-started.md, "Merging
# documents"). Where it doesn't, git merges them by lines, as it always has. Material families share
# `.material.ron`; the driver reads the envelope and merges a family with no kind by lines.
*.moves.ron merge=sapphire-document
*.animgraph.ron merge=sapphire-document
*.cue.ron merge=sapphire-document
*_effects.ron merge=sapphire-document
*.timeline.ron merge=sapphire-document
*.ui.ron merge=sapphire-document
*.zone.ron merge=sapphire-document
*.material.ron merge=sapphire-document
*.ramp.ron merge=sapphire-document
*.assembly.ron merge=sapphire-document
*.encounter.ron merge=sapphire-document
*.dialogue.ron merge=sapphire-document
*_day.ron merge=sapphire-document
*_rigs.ron merge=sapphire-document
*.colliders.ron merge=sapphire-document
*.foliage.ron merge=sapphire-document
*_cues.ron merge=sapphire-document
# The world's screen effects are a library of another kind than the effects the editor opens, which share the
# suffix: git merges them by lines.
crates/sapphire_world/default_screen_effects.ron merge=text

# Third-party content stays byte for byte as downloaded (content/third_party/README.md); only
# the project's own provenance notes and sidecars there are normalized.
content/third_party/** -text
content/third_party/**/*.md text
content/third_party/**/*.meta text

# Cooked string tables committed as test fixtures, which a test holds to their sources.
*.sloc binary
