// The enemy's moves (M2 O4): the skeleton warrior, a head taller than the character, with a long
// blade in its right hand. Frame data in 60 Hz ticks, slower to come out than the player's, as the
// reference fights' common enemies are, so a dodge has something to read. Root and blade are keyed by
// hand: `warrior.animgraph.ron` names the clip each move plays, at the move's own ticks, so a move's blow
// goes where its clip's does. In root space +Z is forward and +X the warrior's left, and a blade's +Y
// runs grip to tip.
//
// A brain presses the attacks through `IntentRing::press` (M2 G6), so no intent has a button. It's
// the `brain` section here, so a replay's hash holds it and replacing the set replaces it.
// M2 G3 forces the reactions through `MoveRunner::force`, by name, from any phase: `stagger_light`,
// `stagger_heavy`, `knockdown`, `recover` and `death`. E3 hangs effects on the cues: `telegraph` opens
// a long wind-up, on a move's first tick, and `swing` is the blade starting to cut.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A heavy beats a quick one when a brain presses two at one instant.
            (name: "swipe", buffer: 10, priority: 1),
            (name: "overhead", buffer: 10, priority: 2),
            (name: "lunge", buffer: 10, priority: 2),
            // Getting up from a knockdown once it has lain there. Nothing starts it from neutral.
            (name: "rise", buffer: 15),
        ],
        neutral: [
            (intent: "swipe", move: "swipe"),
            (intent: "overhead", move: "overhead"),
            (intent: "lunge", move: "lunge"),
        ],
        fighter: (
            // A common enemy, to G3's numbers: about eight of the player's three-hit strings to fell, and
            // two to break. Five seconds without a hit that takes poise, and the meter is full again.
            health: 240,
            poise: 60,
            poise_refill: 300,
            hurtboxes: [
                // From the ground to about its crown at 1.87 m: the horns aren't something to hit.
                (name: "body", offset: (0.0, 0.95, 0.0), shape: Capsule(radius: 0.4, length: 1.1)),
            ],
            reactions: (
                light: "stagger_light",
                medium: "stagger_light",
                heavy: "knockdown",
                poise_break: "stagger_heavy",
                defeat: "death",
            ),
            // How this enemy moves. Save, and the next step moves by these, with no restart and no cook.
            // Metres, seconds and degrees. A number left out is the controller's default, and
            // sapphire_moves' `MOVEMENT_LIMITS` says what each may be. Its brain's `pace` below is how far it
            // tilts the stick, so its speeds on the ground come from these two together.
            movement: (
                run_speed: 6.0,
                walk_speed: 2.0,
                run_stick: 0.9,
                walk_stick: 0.5,
                acceleration: 90.0,
                deceleration: 60.0,
                // Its brain's `pace` turns slower than this while it faces a target.
                turn_rate_degrees: 1080.0,
                jump_speed: 7.0,
                gravity: 22.0,
                air_acceleration: 18.0,
                max_fall_speed: 30.0,
                coyote_ticks: 5,
                slope_limit_degrees: 50.0,
                step_height: 0.3,
                ground_snap: 0.3,
                stance_radius: 0.15,
                max_slide_speed: 8.0,
                // The capsule, smaller than the warrior's crown at 1.87 m: its hurtbox above is what a hit
                // reads, and this is only what it bumps into.
                height: 1.6,
                radius: 0.3,
                skin: 0.01,
            ),
        ),
        brain: (
            // A first guess at Zenless Zone Zero's common enemies, for Feel review 3 to move. It stands where
            // a swipe just reaches and an overhead reaches well, and walks in from further: at the far
            // edge it arrives with only the overhead in reach, and has to come closer for a swipe.
            spacing: (near: 1.6, far: 2.6),
            pace: (
                // About 4 m/s on the arena's profile, under a player's 6 m/s run: it can be outrun, which
                // is what the lunge is for.
                approach: 0.7,
                // A step back at 1.2 m/s, and a slow circle at 1.4 m/s.
                retreat: 0.3,
                circle: 0.35,
                circle_share: 0.7,
                // A third of the player's turn: a big thing, slow to come round.
                turn_rate_degrees: 300.0,
            ),
            // 0.7 to 2.2 s of keeping its distance before it looks for an attack.
            patience: (min: 40, max: 130),
            // 0.4 to 1.25 s standing after an attack ends: the opening an attack's recovery started.
            rest: (min: 24, max: 75),
            // A short beat after a reaction, before its stick moves. It keeps the patience it had, so being hit
            // doesn't put off its next attack.
            recover: (min: 2, max: 10),
            attacks: [
                (
                    // Quick and short: its answer to someone standing close or just finished swinging.
                    intent: "swipe",
                    reach: (near: 0.0, best: 1.5, far: 2.7),
                    against: (swinging: 0.7, opening: 1.6, reacting: 0.6, untouchable: 0.0),
                    recent: (ticks: 200, floor: 0.35),
                ),
                (
                    // The telegraphed heavy: rarely twice running, and best on someone already reeling.
                    intent: "overhead",
                    weight: 0.7,
                    reach: (near: 1.0, best: 2.3, far: 3.2),
                    against: (swinging: 0.4, reacting: 1.4, untouchable: 0.0),
                    recent: (ticks: 360, floor: 0.2),
                ),
                (
                    // The gap closer, from where nothing else reaches. Its warp gets it about 6.1 m on a
                    // target standing still, and less on one walking away.
                    intent: "lunge",
                    reach: (near: 3.0, best: 4.6, far: 6.0),
                    against: (swinging: 0.6, reacting: 0.7, untouchable: 0.0),
                    recent: (ticks: 240, floor: 0.3),
                ),
            ],
            // Up in the knockdown's last third, not always at its first moment.
            rise: (intent: "rise", during: "knockdown", from: 58, to: 72),
        ),
        moves: [
            (
                // 1 s. A flat cut from its right to its left at chest height, reaching about 2 m from
                // where it started: 400 ms of wind-up with the blade drawn back, and open to a hit
                // for half a second after. A brain can string it late in the recovery.
                name: "swipe",
                startup: 24,
                active: 5,
                recovery: 31,
                motion: (
                    root: [
                        (at: 24, offset: (0.0, 0.0, 0.1)),
                        (at: 29, offset: (0.0, 0.0, 0.55)),
                        (at: 40, offset: (0.0, 0.0, 0.6)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.55, 1.0, 0.1), rotation: (0.4056, -0.5793, 0.5793, 0.4056)),
                                (at: 24, offset: (-0.94, 1.05, 0.34), rotation: (0.5793, -0.4056, 0.4056, 0.5793)),
                                (at: 26, offset: (-0.24, 1.0, 0.97), rotation: (0.7018, -0.0862, 0.0862, 0.7018)),
                                (at: 28, offset: (0.67, 0.95, 0.74), rotation: (0.6601, 0.2534, -0.2534, 0.6601)),
                                (at: 29, offset: (0.94, 0.9, 0.34), rotation: (0.5793, 0.4056, -0.4056, 0.5793)),
                                (at: 60, offset: (0.35, 0.6, 0.45)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swipe_hit",
                        from: 24,
                        to: 29,
                        path: "blade",
                        shape: Capsule(radius: 0.18, length: 0.9),
                        attack: (damage: 20, poise: 12, weight: Light, hitstop: 5, knockback: (distance: 0.4, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 46, to: 60, allow: [
                        (intent: "swipe", move: "swipe"),
                        (intent: "overhead", move: "overhead"),
                        (intent: "lunge", move: "lunge"),
                    ]),
                ],
                warps: [
                    // It tracks through the wind-up, and the cut itself commits.
                    (from: 0, to: 24, max_distance: 0.5, max_turn: 0.9, keep: 1.4),
                ],
                cues: [
                    (name: "swing_windup", at: 0),
                    (name: "swing", at: 24),
                ],
            ),
            (
                // 1.67 s. The telegraphed heavy: 750 ms with the blade raised over its head, turning
                // to follow, then a chop straight down its front after the off hand releases, reaching about 2.3 m and
                // landing with the tip low. It lands as `Melee_2H_Attack_Chop`'s blade finishes coming
                // down, ticks 41 to 46 of 98, since a graph plays a clip at its move's own ticks. It can't
                // get out of the recovery: this is the opening.
                name: "overhead",
                startup: 45,
                active: 6,
                recovery: 49,
                // A hit under 20 poise lands and doesn't stop it, which leaves a dodge to answer it with.
                // Only the skill's big hit, or breaking its poise, cuts it short.
                armour: [(from: 0, to: 45, threshold: 20)],
                motion: (
                    root: [
                        (at: 37, offset: (0.0, 0.0, -0.1)),
                        (at: 45, offset: (0.0, 0.0, -0.1)),
                        (at: 51, offset: (0.0, 0.0, 0.7)),
                        (at: 59, offset: (0.0, 0.0, 0.8)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.3, 1.1, 0.25), rotation: (0.2588, 0.0, 0.0, 0.9659)),
                                (at: 37, offset: (-0.1, 2.15, -0.35), rotation: (-0.1736, 0.0, 0.0, 0.9848)),
                                (at: 45, offset: (0.0, 2.35, 0.0)),
                                (at: 47, offset: (0.0, 2.09, 0.71), rotation: (0.342, 0.0, 0.0, 0.9397)),
                                (at: 49, offset: (0.0, 1.44, 1.08), rotation: (0.6428, 0.0, 0.0, 0.766)),
                                (at: 51, offset: (0.0, 0.7, 0.95), rotation: (0.866, 0.0, 0.0, 0.5)),
                                (at: 100, offset: (0.2, 0.6, 0.5)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "overhead_hit",
                        from: 45,
                        to: 51,
                        path: "blade",
                        shape: Capsule(radius: 0.26, length: 0.9),
                        attack: (
                            damage: 60,
                            poise: 45,
                            weight: Heavy,
                            hitstop: 10,
                            knockback: (distance: 1.6, ticks: 18),
                            cue: "hit_heavy",
                        ),
                    ),
                ],
                warps: [
                    (from: 0, to: 45, max_distance: 0.8, max_turn: 1.6, keep: 1.6),
                ],
                cues: [
                    (name: "telegraph", at: 0),
                    (name: "swing", at: 45),
                    (name: "heavy_land", at: 50),
                ],
            ),
            (
                // 1.2 s. The gap closer: half a second gathered low with the blade held back, then a
                // thrust covering 3 m in 133 ms, which warp bends toward a target by up to 2.5 m
                // either way, stopping 1.4 m short of it. Without a target it reaches about 4.3 m.
                name: "lunge",
                startup: 30,
                active: 8,
                recovery: 34,
                // As the overhead's.
                armour: [(from: 0, to: 30, threshold: 20)],
                motion: (
                    root: [
                        (at: 26, offset: (0.0, 0.0, -0.15)),
                        (at: 30, offset: (0.0, 0.0, -0.15)),
                        (at: 38, offset: (0.0, 0.0, 3.0)),
                        (at: 46, offset: (0.0, 0.0, 3.3)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (-0.45, 1.0, -0.1), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                // The chamber clears the shoulder before root travel starts. The
                                // blade extends through the first four active ticks with the arm.
                                (at: 30, offset: (-0.44, 1.03, -0.05), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 32, offset: (-0.29, 1.04, 0.44), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 34, offset: (-0.18, 1.05, 0.79), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 38, offset: (-0.1, 1.05, 1.05), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 46, offset: (-0.1, 1.0, 1.0), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 72, offset: (0.3, 0.6, 0.4)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "lunge_hit",
                        from: 30,
                        to: 38,
                        path: "blade",
                        shape: Capsule(radius: 0.24, length: 0.9),
                        attack: (damage: 35, poise: 25, weight: Medium, hitstop: 7, knockback: (distance: 1.0, ticks: 12)),
                    ),
                ],
                warps: [
                    (from: 6, to: 38, max_distance: 2.5, max_turn: 1.4, keep: 1.4),
                ],
                cues: [
                    (name: "telegraph", at: 0),
                    (name: "swing", at: 30),
                    (name: "lunge_land", at: 38),
                ],
            ),
            (
                // 333 ms: a flinch that gives ground, for a hit that doesn't break its poise.
                name: "stagger_light",
                startup: 0,
                active: 0,
                recovery: 20,
                // A hit under 20 poise doesn't start it over: the light string lands a hit every 30
                // ticks or so, and would hold it here until it fell, swinging at nothing.
                armour: [(from: 0, to: 20, threshold: 20)],
                motion: (
                    root: [
                        (at: 6, offset: (0.0, 0.0, -0.22)),
                        (at: 14, offset: (0.0, 0.0, -0.3)),
                    ],
                ),
                cues: [(name: "stagger", at: 0)],
            ),
            (
                // 700 ms: rocked back on its heels, for a hit that breaks it. A hit takes its numbers and
                // can't cut this short: it's the opening a break earns.
                name: "stagger_heavy",
                startup: 0,
                active: 0,
                recovery: 42,
                armour: [(from: 0, to: 42, threshold: 1000)],
                motion: (
                    root: [
                        (at: 10, offset: (0.0, 0.0, -0.55)),
                        (at: 24, offset: (0.0, 0.0, -0.75)),
                    ],
                ),
                cues: [(name: "stagger_heavy", at: 0)],
            ),
            (
                // 1.3 s: thrown back and down, landing at 467 ms and lying there. It gets up when
                // `rise` is pressed in the last third or `recover` is forced; left alone, it ends lying
                // down, which a brain or G3 won't leave it doing. A hit takes its numbers and can't flinch
                // it back onto its feet.
                name: "knockdown",
                startup: 0,
                active: 0,
                recovery: 78,
                armour: [(from: 0, to: 78, threshold: 1000)],
                motion: (
                    root: [
                        (at: 16, offset: (0.0, 0.0, -1.1)),
                        (at: 30, offset: (0.0, 0.0, -1.4)),
                    ],
                ),
                cancels: [
                    (from: 58, to: 78, allow: [(intent: "rise", move: "recover")]),
                ],
                cues: [
                    (name: "knockdown", at: 0),
                    (name: "body_land", at: 28),
                ],
            ),
            (
                // 667 ms: back on its feet, untouchable until it nearly is.
                name: "recover",
                startup: 0,
                active: 0,
                recovery: 40,
                motion: (
                    root: [
                        (at: 30, offset: (0.0, 0.0, 0.1)),
                    ],
                ),
                invulnerable: [(from: 0, to: 28)],
                cues: [(name: "recover", at: 0)],
            ),
            (
                // 2.5 s: it falls apart, and nothing can hit it any more.
                name: "death",
                startup: 0,
                active: 0,
                recovery: 150,
                motion: (
                    root: [
                        (at: 18, offset: (0.0, 0.0, -0.5)),
                        (at: 36, offset: (0.0, 0.0, -0.6)),
                    ],
                ),
                hurtboxes: [
                    (name: "body", from: 0, to: 150, state: Off),
                ],
                invulnerable: [(from: 0, to: 150)],
                cues: [
                    (name: "death", at: 0),
                    (name: "body_land", at: 40),
                    (name: "death_fade", at: 120),
                ],
            ),
        ],
    ),
)
