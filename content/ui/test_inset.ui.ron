// The 3D inset's test screen (M3 U6): the character standing in a framed panel beside a menu, at any
// aspect, turned by a drag across it or a stick. Not a game's: U7 builds the character screen.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "test_screen.model.ron",
        styles: [
            (name: "title", role: "display", size: 48, weight: 700),
            (name: "subtitle", role: "display", size: 18, weight: 500),
            (name: "menu", role: "body", size: 20, weight: 500),
        ],
        nodes: [
            (
                name: "root",
                layout: (direction: Column, gap: 16, padding: (left: 40, right: 40, top: 28, bottom: 28), safe_area: true),
                look: (fill: Gradient(from: (12, 18, 44, 255), to: (58, 30, 92, 255), angle: 60)),
            ),
            (
                name: "header",
                parent: "root",
                layout: (direction: Row, align: End, justify: SpaceBetween),
            ),
            (
                name: "title",
                parent: "header",
                text: (key: "test-screen-title", style: "title", color: (245, 240, 255, 255)),
            ),
            (
                name: "subtitle",
                parent: "header",
                text: (
                    key: "test-screen-subtitle",
                    style: "subtitle",
                    color: (150, 215, 235, 255),
                    args: [(name: "level", path: "level")],
                ),
            ),
            (
                name: "body",
                parent: "root",
                layout: (direction: Row, gap: 24, grow: 1, min_height: Points(0)),
            ),
            (
                name: "stage",
                parent: "body",
                layout: (grow: 1, width: Points(0), min_height: Points(0), padding: (left: 6, right: 6, top: 6, bottom: 6)),
                look: (
                    shape: Slice(sprite: Button, corner: 18),
                    fill: Color((24, 30, 70, 255)),
                    outline: (color: (110, 150, 230, 255), width: 1.5),
                ),
            ),
            (
                name: "showcase",
                parent: "stage",
                layout: (grow: 1),
                inset: (inset: 0, look_at: 1.2, distance: 5.0),
            ),
            (
                name: "menu",
                parent: "body",
                layout: (direction: Column, gap: 10, width: Percent(30), min_width: Points(180), shrink: 0),
            ),
            (
                name: "sound",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (
                    shape: Slice(sprite: Button, corner: 14),
                    fill: Gradient(from: (232, 92, 130, 255), to: (120, 70, 200, 255), angle: 0),
                    outline: (color: (255, 225, 235, 255), width: 2),
                    slant: 0.12,
                ),
            ),
            (
                name: "sound-label",
                parent: "sound",
                text: (key: "test-screen-sound", style: "menu", color: (255, 255, 255, 255)),
            ),
            (
                name: "display",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (shape: Slice(sprite: Button, corner: 14), fill: Color((40, 48, 92, 255)), slant: 0.12),
            ),
            (
                name: "display-label",
                parent: "display",
                text: (key: "test-screen-display", style: "menu", color: (225, 230, 255, 255)),
            ),
            (
                name: "language",
                parent: "menu",
                layout: (padding: (left: 22, right: 22, top: 12, bottom: 12)),
                look: (shape: Slice(sprite: Button, corner: 14), fill: Color((40, 48, 92, 255)), slant: 0.12),
            ),
            (
                name: "language-label",
                parent: "language",
                text: (key: "test-screen-language", style: "menu", color: (225, 230, 255, 255)),
            ),
        ],
    ),
)
