// What the party's test content adds to `slice.moves.ron` (M2 G7): the swap intent, and three swap-in
// assists, one for each member, each of which becomes that member's `swap_in`. The party scenario merges
// these into the slice's document, so the three share a kit and differ in how they come in.
// (`sapphire_gameplay::replay::party_document`.)
//
// A swap press is buffered 12 ticks, as an attack's is. Each assist comes out at once and can be cancelled
// into an attack or a dodge, so a swap never takes the rhythm away for longer than a hit would.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            (name: "swap", button: Swap, buffer: 12, priority: 4),
        ],
        moves: [
            (
                // 433 ms: a quick cut from the side, untouchable until it has landed.
                name: "swap_in_cut",
                startup: 3,
                active: 5,
                recovery: 18,
                motion: (
                    root: [
                        (at: 3, offset: (0.0, 0.0, 0.3)),
                        (at: 8, offset: (0.0, 0.0, 0.9)),
                        (at: 12, offset: (0.0, 0.0, 1.0)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (0.8, 1.2, 0.3)),
                                (at: 3, offset: (0.7, 1.2, 0.8)),
                                (at: 8, offset: (-0.7, 1.0, 0.9)),
                                (at: 26, offset: (0.2, 0.9, 0.3)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swap_in_cut_hit",
                        from: 3,
                        to: 8,
                        path: "blade",
                        shape: Capsule(radius: 0.3, length: 1.0),
                        attack: (damage: 12, poise: 10, weight: Medium, hitstop: 5, knockback: (distance: 0.5, ticks: 10)),
                    ),
                ],
                invulnerable: [(from: 0, to: 8)],
                cancels: [
                    (from: 10, to: 26, allow: [
                        (intent: "light", move: "light_1"),
                        (intent: "dodge", move: "dodge"),
                    ]),
                ],
                cues: [(name: "swap_in", at: 0), (name: "swing", at: 3)],
            ),
            (
                // 500 ms: it crosses the ground to whoever it's aimed at, and takes a blow doing it.
                name: "swap_in_lunge",
                startup: 6,
                active: 4,
                recovery: 20,
                motion: (
                    root: [
                        (at: 6, offset: (0.0, 0.0, 1.2)),
                        (at: 10, offset: (0.0, 0.0, 2.0)),
                        (at: 14, offset: (0.0, 0.0, 2.1)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (0.5, 1.2, 0.2)),
                                (at: 6, offset: (0.3, 1.1, 1.0)),
                                (at: 10, offset: (-0.5, 1.0, 0.9)),
                                (at: 30, offset: (0.2, 0.9, 0.3)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swap_in_lunge_hit",
                        from: 6,
                        to: 10,
                        path: "blade",
                        shape: Capsule(radius: 0.3, length: 1.1),
                        attack: (damage: 16, poise: 14, weight: Medium, hitstop: 6, knockback: (distance: 0.6, ticks: 10)),
                    ),
                ],
                warps: [(from: 0, to: 10, max_distance: 3.0, max_turn: 1.5, keep: 1.1)],
                cancels: [
                    (from: 12, to: 30, allow: [
                        (intent: "light", move: "light_1"),
                        (intent: "dodge", move: "dodge"),
                    ]),
                ],
                cues: [(name: "swap_in", at: 0), (name: "swing", at: 6)],
            ),
            (
                // 667 ms: it comes in braced, through a light hit and on with its own blow, and pays for that
                // with a slower one.
                name: "swap_in_guard",
                startup: 10,
                active: 6,
                recovery: 24,
                motion: (
                    root: [
                        (at: 10, offset: (0.0, 0.0, 0.1)),
                        (at: 16, offset: (0.0, 0.0, 0.8)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (0.3, 1.7, 0.1)),
                                (at: 10, offset: (0.2, 1.9, 0.4)),
                                (at: 16, offset: (-0.1, 0.7, 1.3)),
                                (at: 40, offset: (0.2, 0.9, 0.3)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swap_in_guard_hit",
                        from: 10,
                        to: 16,
                        path: "blade",
                        shape: Capsule(radius: 0.35, length: 1.1),
                        attack: (damage: 20, poise: 24, weight: Heavy, hitstop: 8, knockback: (distance: 1.0, ticks: 12)),
                    ),
                ],
                armour: [(from: 0, to: 16, threshold: 15)],
                cancels: [
                    (from: 18, to: 40, allow: [
                        (intent: "light", move: "light_1"),
                        (intent: "dodge", move: "dodge"),
                    ]),
                ],
                cues: [(name: "swap_in", at: 0), (name: "swing", at: 10)],
            ),
        ],
    ),
)
