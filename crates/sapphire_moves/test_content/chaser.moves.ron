// Moves for a brain that only chases (M3 P3, the `nav-chase` scenario): a fighter who walks in and stands.
// Its one attack reaches 0.2 m, and it keeps 1.2 m off, so it never lands one, and a replay of it holds
// paths, a crowd and the controller with no fight to read past. It scores that attack every tick, as any
// brain whose patience has run out does, so what it costs is the whole of what a brain costs to pace.
// Its brain is its kind's, `chaser.enemy.ron` (M3 B3).
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            (name: "poke", buffer: 6, priority: 1),
        ],
        neutral: [
            (intent: "poke", move: "poke"),
        ],
        fighter: (
            health: 100,
            poise: 10,
            poise_refill: 240,
            hurtboxes: [
                (name: "body", offset: (0.0, 0.9, 0.0), shape: Capsule(radius: 0.3, length: 1.0)),
            ],
        ),
        moves: [
            (name: "poke", startup: 2, active: 2, recovery: 2),
        ],
    ),
)
