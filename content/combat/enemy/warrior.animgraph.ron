                        (clip: "circle_right", at: (-1.40, 0.0)),
                    ],
                    rate: (0.5, 1.6),
                ))),
            ],
        ),
        combat: (
            decay: 6,
            exit: 10,
            moves: [
                (move: "swipe", clip: "swipe", decay: 4),
                (move: "overhead", clip: "overhead", decay: 5),
                (move: "lunge", clip: "lunge", decay: 5),
                (move: "stagger_light", clip: "stagger_light", decay: 3),
