// An ambient figure of the benchmark's crowd (M5 B3): a porter in an orange tunic with a headband, bare forearms and a tall pack on their back. One material, at the
// crowd's row of about 3,000 triangles.
// It lists no joints: it shares `ambient_a`'s skeleton (`skeleton` in `bench/cast/cast.ron`), so one
// pose serves the crowd.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_e",
        name: "ambient_e",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [],
        regions: [
            (name: "skin", albedo: [(0.0, "#d8a888"), (1.0, "#a87458")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#1a1a1a"), (1.0, "#060606")], specular: 0.35, specular_size: 0.4),
            (name: "tunic", albedo: [(0.0, "#e8823a"), (1.0, "#8a3e14")], shadow_bias: 0.55),
            (name: "pants", albedo: [(0.0, "#4a4038"), (1.0, "#1e1a16")]),
            (name: "pack", albedo: [(0.0, "#9a8a6a"), (1.0, "#4a3e2a")], specular: 0.2),
            (name: "band", albedo: [(0.0, "#3a7ac8"), (1.0, "#163a6a")]),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "tunic", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "skin", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "skin", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "pants", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "pants", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "pants", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 12, arc: Some((-15.0, 195.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The tunic's hem, the headband, and the pack: a tall frame, its load and its straps.
            Loft((
                region: "tunic", bones: ["hips", "upperleg.l", "upperleg.r"], sides: 16, blend: 0.08, thickness: 0.01,
                from: (0.0, 0.84, 0.0), to: (0.0, 0.62, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.108)), (at: 1.0, radius: (0.18, 0.14))],
            )),
            Loft((
                region: "band", bones: ["head"], sides: 16,
                from: (0.0, 1.37, 0.01), to: (0.0, 1.4, 0.01),
                rings: [(at: 0.0, radius: (0.094, 0.104)), (at: 1.0, radius: (0.092, 0.102))],
            )),
            Loft((
                region: "pack", bones: ["chest", "spine"], sides: 14, blend: 0.1, faceted: true,
                from: (0.0, 0.88, -0.2), to: (0.0, 1.5, -0.2),
                rings: [(at: 0.0, radius: (0.14, 0.09)), (at: 0.2, radius: (0.16, 0.1)), (at: 0.8, radius: (0.15, 0.1)), (at: 1.0, radius: (0.11, 0.08))],
            )),
            Loft((
                region: "band", bones: ["chest", "spine"], sides: 14,
                from: (0.0, 1.25, -0.2), to: (0.0, 1.3, -0.2),
                rings: [(at: 0.0, radius: (0.162, 0.106)), (at: 1.0, radius: (0.162, 0.106))],
            )),
            Loft((
                region: "pack", bones: ["chest"], sides: 6, mirror: true,
                from: (0.1, 1.2, 0.09), to: (0.1, 1.2, -0.12),
                rings: [(at: 0.0, radius: (0.015, 0.006)), (at: 1.0, radius: (0.015, 0.006))],
            )),
        ],
    ),
)
