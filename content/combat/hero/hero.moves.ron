// Aster's moves (M5 C8): the second playable kind, unarmed. Frame data in 60 Hz ticks, on the scale the
// player's moves are tuned to. A short set: a punch and a kick for the attack button, a dodge, the swap-in
// assist a party's swap brings, and the five moves a hit forces. Only a party reads `swap` and `swap_in`.
//
// Root and fists are keyed by hand, as the Lancer's are, from the clips `hero.animgraph.ron` plays at each
// move's own ticks: the punch and the kick are her own key-pose documents beside this file, and the dodge
// and the swap-in play the heroine's (`content/combat/player/`), cooked for her rig, so their root keys are
// that clip's. In root space +Z is forward and +X her left. `fist` and `foot` are points at the striking
// hand's knuckles and the kicking foot's instep, and a hit is a capsule there along its +Y.
//
// The reactions have the heroine's names and lengths: a hit forces them, and her graph draws them from the
// heroine's reactions.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A dodge beats an attack when both could fire at one instant.
            (name: "light", button: Light, buffer: 14, priority: 1),
            (name: "dodge", button: Dodge, buffer: 8, priority: 3),
            (name: "swap", button: Swap, buffer: 12, priority: 4),
        ],
        neutral: [
            (intent: "light", move: "punch"),
            (intent: "dodge", move: "dodge"),
        ],
        fighter: (
            // A little lighter than the heroine's 300 and 60.
            health: 260,
            poise: 50,
            poise_refill: 240,
            hurtboxes: [
                // From the ground to the top of her hair at 1.66 m. A dodge turns it off.
                (name: "body", offset: (0.0, 0.83, 0.0), shape: Capsule(radius: 0.28, length: 1.1)),
            ],
            reactions: (
                light: "flinch",
                medium: "stagger",
                heavy: "knockdown",
                poise_break: "dazed",
                defeat: "defeat",
            ),
            // As the heroine moves, a little slower at the top: her graph strides at the walk's pace. Metres,
            // seconds and degrees, and sapphire_moves' `MOVEMENT_LIMITS` says what each may be.
            movement: (
                run_speed: 3.6,
                walk_speed: 2.0,
                run_stick: 0.9,
                walk_stick: 0.5,
                acceleration: 40.0,
                deceleration: 42.0,
                turn_rate_degrees: 720.0,
                jump_speed: 7.0,
                gravity: 22.0,
                air_acceleration: 18.0,
                max_fall_speed: 30.0,
                coyote_ticks: 5,
                slope_limit_degrees: 50.0,
                step_height: 0.3,
                ground_snap: 0.3,
                stance_radius: 0.15,
                max_slide_speed: 8.0,
                height: 1.6,
                radius: 0.28,
                skin: 0.01,
                // Traversal (M6 A14): read once the mantle, climbing, gliding and swimming land. No stamina.
                mantle_min_height: 0.5,
                mantle_max_height: 2.0,
                vault_max_height: 1.0,
                climb_speed: 1.5,
                climb_reach: 0.4,
                glide_min_height: 3.0,
                glide_speed: 6.0,
                glide_sink_speed: 2.0,
                swim_depth: 0.75,
                swim_speed: 2.5,
            ),
        ),
        moves: [
            (
                // 500 ms. A straight right from her guard: the fist drawn back to the ribs, a step in, and
                // the arm out at shoulder height to about 0.65 m. The next press takes over from tick 13.
                name: "punch",
                startup: 7,
                active: 4,
                recovery: 19,
                motion: (
                    root: [
                        (at: 5, offset: (0.0, 0.0, 0.0)),
                        (at: 9, offset: (0.0, 0.0, 0.22)),
                        (at: 14, offset: (0.0, 0.0, 0.28)),
                    ],
                    paths: [
                        (
                            name: "fist",
                            keys: [
                                (at: 0, offset: (-0.2, 1.12, 0.28), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 5, offset: (-0.24, 1.08, 0.02), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 7, offset: (-0.16, 1.24, 0.42), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 9, offset: (-0.1, 1.3, 0.66), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 12, offset: (-0.1, 1.3, 0.64), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 20, offset: (-0.18, 1.16, 0.34), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 30, offset: (-0.2, 1.12, 0.28), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "punch_hit",
                        from: 7,
                        to: 11,
                        path: "fist",
                        shape: Capsule(radius: 0.18, length: 0.3),
                        attack: (damage: 8, poise: 10, weight: Light, hitstop: 4, knockback: (distance: 0.3, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 30, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 13, to: 24, allow: [(intent: "light", move: "kick")]),
                ],
                warps: [
                    (from: 0, to: 7, max_distance: 1.0, max_turn: 1.2, keep: 0.9),
                ],
                cues: [
                    (name: "swing", at: 7),
                ],
            ),
            (
                // 600 ms. A front kick out of the punch: the right knee up, the foot driven out at the
                // chest to about 0.8 m on a skip forward, and back down to her guard.
                name: "kick",
                startup: 10,
                active: 4,
                recovery: 22,
                motion: (
                    root: [
                        (at: 8, offset: (0.0, 0.0, 0.0)),
                        (at: 12, offset: (0.0, 0.0, 0.3)),
                        (at: 18, offset: (0.0, 0.0, 0.38)),
                    ],
                    paths: [
                        (
                            name: "foot",
                            keys: [
                                (at: 0, offset: (-0.1, 0.1, 0.0), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 8, offset: (-0.1, 0.62, 0.22), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 10, offset: (-0.1, 0.9, 0.6), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 12, offset: (-0.1, 1.0, 0.8), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 14, offset: (-0.1, 0.98, 0.78), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 24, offset: (-0.1, 0.3, 0.3), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 36, offset: (-0.1, 0.1, 0.0), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "kick_hit",
                        from: 10,
                        to: 14,
                        path: "foot",
                        shape: Capsule(radius: 0.2, length: 0.4),
                        attack: (damage: 12, poise: 18, weight: Medium, hitstop: 6, knockback: (distance: 0.6, ticks: 10)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 36, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 24, to: 36, allow: [(intent: "light", move: "punch")]),
                ],
                warps: [
                    (from: 0, to: 10, max_distance: 1.2, max_turn: 1.2, keep: 1.0),
                ],
                cues: [
                    (name: "swing", at: 10),
                    (name: "step", at: 24),
                ],
            ),
            (
                // 400 ms: the heroine's low leap straight back, 2.4 m in 16 ticks, untouchable for 13.
                name: "dodge",
                startup: 1,
                active: 13,
                recovery: 10,
                motion: (
                    root: [
                        (at: 0, offset: (0.0, 0.0, 0.0)),
                        (at: 1, offset: (0.0, 0.0, -0.105)),
                        (at: 2, offset: (0.0, 0.0, -0.26)),
                        (at: 4, offset: (0.0, 0.0, -0.7)),
                        (at: 6, offset: (0.0, 0.0, -1.2)),
                        (at: 8, offset: (0.0, 0.0, -1.63)),
                        (at: 10, offset: (0.0, 0.0, -2.0)),
                        (at: 12, offset: (0.0, 0.0, -2.257)),
                        (at: 16, offset: (0.0, 0.0, -2.4)),
                    ],
                ),
                hurtboxes: [
                    (name: "body", from: 1, to: 14, state: Off),
                ],
                invulnerable: [(from: 1, to: 14)],
                cancels: [
                    (from: 16, to: 24, allow: [(intent: "light", move: "punch")]),
                ],
                cues: [
                    (name: "dodge_start", at: 0),
                    (name: "skid", at: 10),
                ],
            ),
            (
                // 300 ms: a light hit's. A dodge gets out of its end.
                name: "flinch",
                startup: 0,
                active: 6,
                recovery: 12,
                cancels: [(from: 10, to: 18, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 500 ms: a medium hit's.
                name: "stagger",
                startup: 0,
                active: 10,
                recovery: 20,
                cancels: [(from: 22, to: 30, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 1,167 ms: a heavy hit's, down and up again, untouchable throughout.
                name: "knockdown",
                startup: 0,
                active: 30,
                recovery: 40,
                invulnerable: [(from: 0, to: 70)],
                cancels: [(from: 60, to: 70, allow: [(intent: "dodge", move: "dodge")])],
                cues: [(name: "knocked_down", at: 0)],
            ),
            (
                // 1,500 ms: a broken poise's, open to punishment: hits land and it stays dazed.
                name: "dazed",
                startup: 0,
                active: 60,
                recovery: 30,
                armour: [(from: 0, to: 90, threshold: 1000)],
                cues: [(name: "reaction", at: 0)],
            ),
            (
                // 2 s, with no way out: the fight's over for her.
                name: "defeat",
                startup: 0,
                active: 30,
                recovery: 90,
                cues: [(name: "falls", at: 0)],
            ),
            (
                // 567 ms: arriving from a party's swap on the heroine's dash attack, thrown forward low, the
                // right fist leading across, untouchable until it's about to land. Its aim is whoever left's.
                name: "swap_in",
                startup: 5,
                active: 5,
                recovery: 24,
                motion: (
                    root: [
                        (at: 0, offset: (0.0, 0.0, 0.0)),
                        (at: 1, offset: (0.0, 0.0, 0.09)),
                        (at: 3, offset: (0.0, 0.0, 0.42)),
                        (at: 5, offset: (0.0, 0.0, 1.0)),
                        (at: 7, offset: (0.0, 0.0, 1.72)),
                        (at: 9, offset: (0.0, 0.0, 2.17)),
                        (at: 11, offset: (0.0, 0.0, 2.45)),
                        (at: 14, offset: (0.0, 0.0, 2.6)),
                        (at: 22, offset: (0.0, 0.0, 2.64)),
                    ],
                    paths: [
                        (
                            name: "fist",
                            keys: [
                                (at: 0, offset: (-0.3, 0.9, 0.2), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 5, offset: (-0.25, 1.0, 0.6), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 10, offset: (0.2, 1.0, 0.65), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                                (at: 34, offset: (-0.2, 1.12, 0.28), rotation: (0.7071, 0.0, 0.0, 0.7071)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "swap_hit",
                        from: 5,
                        to: 10,
                        path: "fist",
                        shape: Capsule(radius: 0.3, length: 0.6),
                        attack: (damage: 10, poise: 12, weight: Medium, hitstop: 5, knockback: (distance: 0.5, ticks: 10)),
                    ),
                ],
                invulnerable: [(from: 0, to: 5)],
                cancels: [
                    (from: 18, to: 34, allow: [
                        (intent: "dodge", move: "dodge"),
                        (intent: "light", move: "punch"),
                    ]),
                ],
                warps: [
                    (from: 0, to: 10, max_distance: 2.0, max_turn: 1.2, keep: 1.1),
                ],
                cues: [
                    (name: "swap_in", at: 0),
                    (name: "swing", at: 5),
                    (name: "skid", at: 10),
                ],
            ),
        ],
    ),
)
