// What `test_menu.ui.ron`'s paths can read, generated from `sapphire_stage::screen::TestMenuModel`, which a
// test holds this to. A cook refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "line", kind: Text),
        ],
    ),
)
