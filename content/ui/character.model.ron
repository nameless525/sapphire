// What `character.ui.ron`'s paths can read, generated from `game_ui::menus::CharacterModel`, which a test holds
// this to. A cook refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "attack", kind: Number),
            (path: "crit", kind: Number),
            (path: "defense", kind: Number),
            (path: "detail", kind: Text),
            (path: "hp", kind: Number),
            (path: "level", kind: Number),
            (path: "max_hp", kind: Number),
            (path: "name", kind: Text),
        ],
    ),
)
