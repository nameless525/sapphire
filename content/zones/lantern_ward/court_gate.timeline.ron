// The Temple Court's gate (M3 Q3): the warden who keeps the court stands in the way, and the player's character
// takes a guard. It plays as the character reaches the court's checkpoint, before the court's fight, and holds
// that fight at a step's edge until it ends or someone skips it.
//
// Space: the zone's own, so every place here is a place in `lantern_ward.zone.ron`. The character comes in at
// `checkpoint_court` (0, 0, -63) facing up the court, and the warden waits at `court_spawn_e` (0, 0, -90)
// facing back, with the temple's terrace behind it. Nobody's moved by a track: the simulation says where they
// stand, and the shots frame where that is.
//
// Four shots: up the court over the character's shoulder, the warden close, the character from below drawing,
// and the two of them down the court as the view goes back to the fight's camera behind the character. Lines
// are keys of `content/loc/*/cutscenes.ftl`, in English and Japanese.
(
    type: "sapphire::timeline::TimelineDocument",
    version: 1,
    data: (
        length: 9.0,
        clock: Real,
        camera: Some((
            // In and out of the fight's camera behind the character, which the first and last shots stand near.
            blend_in: 0.3,
            blend_out: 0.35,
            eye: Exact,
            keys: [
                (at: 0.0, eye: (2.6, 2.7, -57.0), look_at: (0.0, 1.9, -88.0), fov_degrees: 46.0),
                (at: 2.48, eye: (1.8, 2.3, -60.0), look_at: (0.0, 1.8, -88.0), fov_degrees: 40.0, ease: Smooth),
                // The warden, close and a little from below, the terrace's lanterns behind it.
                (at: 2.5, eye: (1.9, 1.3, -84.6), look_at: (0.0, 1.85, -89.5), roll_degrees: -3.0, fov_degrees: 36.0, ease: Cut),
                (at: 4.98, eye: (2.5, 1.2, -84.0), look_at: (0.0, 1.9, -89.5), roll_degrees: -4.0, fov_degrees: 33.0, ease: Smooth),
                // The character, from in front and below, taking a guard.
                (at: 5.0, eye: (-1.5, 0.95, -67.2), look_at: (0.0, 1.35, -63.0), roll_degrees: 2.0, fov_degrees: 38.0, ease: Cut),
                (at: 7.38, eye: (-1.9, 1.05, -67.6), look_at: (0.0, 1.4, -63.0), roll_degrees: 3.0, fov_degrees: 34.0, ease: Smooth),
                // The two of them down the court, from behind the character: where the fight's camera takes it back.
                (at: 7.4, eye: (1.1, 2.1, -58.2), look_at: (0.0, 1.4, -76.0), fov_degrees: 44.0, ease: Cut),
                (at: 9.0, eye: (0.8, 2.2, -57.6), look_at: (0.0, 1.4, -76.0), fov_degrees: 46.0, ease: Smooth),
            ],
        )),
        characters: [
            // `hero` is whoever the fight's player is, `foe` whoever they're facing: the timeline names roles,
            // and what plays it says who.
            (role: "hero", plays: [(row: "court_guard", from: 5.0, to: 8.4)]),
            (role: "foe", plays: [(row: "overhead", from: 2.6, to: 4.25)]),
        ],
        cues: [
            // The warden's blade comes down on the paving as it's seen.
            (at: 3.7, cue: "court_stomp", place: Some((0.0, 0.0, -89.2))),
            // The character's blade turning into guard.
            (at: 5.9, cue: "court_draw", place: Some((0.3, 1.3, -63.4))),
        ],
        post: [
            // A little darker on the warden, and back.
            (parameter: Exposure, keys: [(at: 0.0, value: 0.0), (at: 2.4, value: 0.0), (at: 2.6, value: -0.3), (at: 4.8, value: -0.3), (at: 5.2, value: 0.0), (at: 9.0, value: 0.0)]),
            // A frame closing in for the length of it, gone by the time the fight's back.
            (parameter: Vignette, keys: [(at: 0.0, value: 0.0), (at: 1.0, value: 0.35), (at: 8.0, value: 0.35), (at: 9.0, value: 0.0)]),
            // The blade catching the light as it's drawn.
            (parameter: Bloom, keys: [(at: 0.0, value: 0.0), (at: 5.6, value: 0.0), (at: 6.0, value: 0.25), (at: 7.2, value: 0.0)]),
        ],
        subtitles: [
            (from: 0.8, to: 2.4, key: "subtitle-court-gate-quiet", speaker: Some("speaker-wanderer")),
            (from: 2.9, to: 4.9, key: "subtitle-court-gate-warning", speaker: Some("speaker-warden")),
            (from: 5.4, to: 7.3, key: "subtitle-court-gate-answer", speaker: Some("speaker-wanderer")),
        ],
        // Told to the court's fight as it's let go, for whatever starts there to hear.
        events: [(at: 9.0, event: "court_gate_seen")],
    ),
)
