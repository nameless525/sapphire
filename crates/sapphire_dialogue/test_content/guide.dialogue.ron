// The guide at the ward: every kind of node, a choice that hides, a branch, and a way out.
(
    type: "sapphire::dialogue::DialogueDocument",
    version: 1,
    data: (
        start: "greet",
        nodes: [
            (name: "greet", say: (speaker: "guide-name", line: "guide-greet", vo: "guide_greet"), next: "ask"),
            (name: "ask", say: (speaker: "guide-name", line: "guide-ask"), choices: [
                (line: "choice-light-ward", to: "lit", set: [("ward_lit", 1)]),
                (line: "choice-ask-again", to: "again", when: "flag.ward_lit >= 1"),
                (line: "choice-leave"),
            ]),
            (name: "lit", say: (speaker: "guide-name", line: "guide-thanks"), set: [("met_guide", 1)], next: "again"),
            (name: "again", branch: [(when: "flag.met_guide == 0", to: "greet")], otherwise: "farewell"),
            (name: "farewell", say: (speaker: "guide-name", line: "guide-farewell")),
        ],
    ),
)
