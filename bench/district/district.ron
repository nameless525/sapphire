// The benchmark's district (M5 B2): a hub district of `cells` × `cells` blocks about the origin, generated by
// `sapphire_pipeline::bench::district`, whose module docs say how. Streets run along every cell's edge: an
// avenue on each axis through the plaza (the four cells about the origin), streets and lanes between, and a
// boundary wall round it all. Each block is a row of buildings facing every street it borders, a courtyard
// behind them, and street furniture, stalls and lantern posts in front; walls close some lanes, so some views
// are long and some end a block away. The plaza's fight, its spawners and its volume are code
// (`sapphire_synthetic_zone::district`). Every number here is a benchmark's, not an artist's.
//
// The budget preset is 8 × 8 cells, 256 m square, at 160 texture sets of three 2K maps: 16 MiB a set in BC7
// and BC5 with full mips, 2.5 GiB, the desktop pool. `double` is the same district at twice the pool, for the
// streamer's proof; nothing cooks it unless asked.
(
    type: "sapphire::pipeline::BenchDistrict",
    version: 2,
    data: (
        cell_size: 32.0,
        // Widths in metres; `edge` is the alley between the outer blocks and the boundary wall.
        streets: (avenue: 12.0, street: 8.0, lane: 5.0, edge: 2.5),
        // The share of lane segments between two blocks that a wall closes.
        closures: 0.4,
        buildings: (
            variants: 40,
            // Width along the street and depth, in metres; a variant's footprint, storeys and roof are its
            // number's remainders by each list's length, so lengths with no common factor give distinct ones.
            footprints: [(6.0, 5.0), (7.6, 5.6), (5.0, 4.6), (9.6, 6.2), (6.8, 6.6)],
            storeys: [1, 2, 3],
            roofs: [Gable, Hip, HipGable(0.55), HipGable(0.4)],
            storey_height: 3.4,
            // Between neighbours in a row, in metres, least and most.
            gap: (1.2, 2.6),
        ),
        // Every prop prefab the district places, by its file's stem in `prefabs/`, with half the rectangle it
        // keeps clear about its origin along its own X and Z (its front faces +Z), in metres.
        props: {
            "lantern_post": (clear: (0.3, 0.3)),
            "crates": (clear: (1.1, 0.5)),
            "barrels": (clear: (1.0, 0.7)),
            "cart": (clear: (0.85, 1.4)),
            "planter": (clear: (0.65, 0.65)),
            "bench_seat": (clear: (0.85, 0.3)),
            "stall": (clear: (1.7, 1.2)),
            "jars": (clear: (0.5, 0.25)),
            "sacks": (clear: (0.6, 0.4)),
            "boundary_wall": (clear: (4.0, 0.3)),
        },
        // A post a metre into the street every `spacing` metres along each block's side and round the plaza,
        // each with a point light `height` up: what lights the district after dusk.
        lanterns: (
            prefab: "lantern_post",
            spacing: 9.0,
            light: (height: 2.52, color: (1.0, 0.62, 0.3), intensity: 1.2, range: 9.0),
        ),
        dressing: (
            // Against each building's front, either side of its door, and between the lantern posts.
            frontage: ["crates", "barrels", "planter", "bench_seat", "jars", "sacks"],
            per_building: 4,
            // In front of this share of the buildings on avenues and streets, to one side of the door.
            stall: "stall",
            stalls: 0.35,
            // On a grid this many metres apart in each courtyard, this share of its points.
            courtyard: ["jars", "sacks", "crates", "jars", "barrels", "sacks", "planter", "jars", "cart", "sacks"],
            courtyard_spacing: 1.3,
            courtyard_fill: 0.9,
            // Round the plaza's rim, between its lanterns.
            plaza: ["bench_seat", "planter"],
            boundary: "boundary_wall",
            boundary_length: 8.0,
        ),
        // Texture sets a cell's props and ground draw from: a cell's merged mesh has at most this many
        // materials, and its ground the first.
        palette: 16,
        // Its look: the day in this folder (a dusk key and a night key), and its own air.
        day: "district_day.ron",
        wind: Some((direction: (0.8, 0.0, 0.6), strength: 0.4, gustiness: 0.3)),
        fog: Some((density: 1.2)),
        presets: (
            ci: (cells: 4, texture_sets: 4, texture_size: 256),
            budget: (cells: 8, texture_sets: 160, texture_size: 2048),
            double: Some((cells: 8, texture_sets: 320, texture_size: 2048)),
        ),
    ),
)
