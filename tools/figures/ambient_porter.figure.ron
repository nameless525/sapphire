            Loft((
                region: "pack", bones: ["chest", "spine"], sides: 14, blend: 0.1, faceted: true,
                from: (0.0, 0.88, -0.2), to: (0.0, 1.5, -0.2),
                rings: [(at: 0.0, radius: (0.154, 0.099)), (at: 0.2, radius: (0.176, 0.11)), (at: 0.8, radius: (0.165, 0.11)), (at: 1.0, radius: (0.121, 0.088))],
