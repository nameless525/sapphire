// What a menu's paths can read (M3 U9): the title's, the pause's, the settings' and any screen's whose row in
// `menus.ron` reads `Menu`. Generated from `game_ui::menus::MenuModel`, which a test holds this to: its
// fields, and under `remap.gamepad` and `remap.keyboard` a glyph for each binding a player may remap in
// `combat_bindings.ron` (M4 X4). A cook refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "auto_target", kind: Text),
            (path: "battery_saver", kind: Text),
            (path: "camera_motion", kind: Number),
            (path: "can_continue", kind: Bool),
            (path: "can_leave", kind: Bool),
            (path: "can_mark", kind: Bool),
            (path: "dynamic_resolution", kind: Text),
            (path: "effects", kind: Number),
            (path: "flashes", kind: Text),
            (path: "frame_cap", kind: Text),
            (path: "hold_dodge", kind: Text),
            (path: "hold_heavy", kind: Text),
            (path: "hold_light", kind: Text),
            (path: "hold_lock_on", kind: Text),
            (path: "hold_skill", kind: Text),
            (path: "language", kind: Text),
            (path: "mono", kind: Text),
            (path: "music", kind: Number),
            (path: "quality", kind: Text),
            (path: "remap.binding", kind: Text),
            (path: "remap.cancel", kind: Text),
            (path: "remap.gamepad.dodge", kind: Text),
            (path: "remap.gamepad.heavy", kind: Text),
            (path: "remap.gamepad.jump", kind: Text),
            (path: "remap.gamepad.light", kind: Text),
            (path: "remap.gamepad.lock_on", kind: Text),
            (path: "remap.gamepad.skill", kind: Text),
            (path: "remap.gamepad.swap", kind: Text),
            (path: "remap.gamepad.ultimate", kind: Text),
            (path: "remap.kept", kind: Bool),
            (path: "remap.keyboard.dodge", kind: Text),
            (path: "remap.keyboard.heavy", kind: Text),
            (path: "remap.keyboard.jump", kind: Text),
            (path: "remap.keyboard.light", kind: Text),
            (path: "remap.keyboard.lock_on", kind: Text),
            (path: "remap.keyboard.move_back", kind: Text),
            (path: "remap.keyboard.move_forward", kind: Text),
            (path: "remap.keyboard.move_left", kind: Text),
            (path: "remap.keyboard.move_right", kind: Text),
            (path: "remap.keyboard.skill", kind: Text),
            (path: "remap.keyboard.swap", kind: Text),
            (path: "remap.keyboard.ultimate", kind: Text),
            (path: "remap.press", kind: Text),
            (path: "remap.pressed", kind: Text),
            (path: "remap.taken_by", kind: Text),
            (path: "rumble", kind: Text),
            (path: "shake", kind: Number),
            (path: "size", kind: Text),
            (path: "sound", kind: Number),
            (path: "speakers", kind: Text),
            (path: "subtitle_background", kind: Text),
            (path: "subtitle_size", kind: Text),
            (path: "subtitles", kind: Text),
            (path: "text_size", kind: Text),
            (path: "timing_assist", kind: Text),
            (path: "voice", kind: Number),
        ],
    ),
)
