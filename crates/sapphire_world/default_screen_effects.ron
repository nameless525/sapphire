// Sapphire's sample screen effect presets (M1 P3), compiled into `sapphire_world`:
// `EffectLibrary::default_effects`, whose module docs (`screen_effects`) say how a preset plays.
// One per effect, and `impact_frame`, all of them at once as a heavy hit lands; then combat's own
// (M2 E3), which `sapphire_cues`' table pushes: `light_hit`, `medium_hit`, `heavy_hit`, `poise_break`,
// `finish` and `perfect_dodge`; then the effects pack's (M5 L9), one per effect and the game's
// `ultimate_raise`, `ultimate_chop` and `phase_shift`. Packs (A4) will carry presets as content.
//
// - A layer sets exactly one effect: `radial_blur`, `chromatic_aberration`, `inversion`,
//   `duotone`, `speed_lines`, `desaturation`, `halftone`, `flash`, `glitch` or `crt`. Fields it leaves
//   out take the effect's defaults.
// - Envelopes are in seconds: `Pulse(attack, hold, release)`, `Sustain(attack, release)` held
//   until gameplay releases it, or `Keys([(seconds, weight), ...])`, linear between keys, where
//   two keys at one time cut. A layer may start after a `delay`.
// - `clock: Real` plays at full speed through slow motion: impact frames authored in frames
//   (1/60 s each) last those frames. The default, `World`, slows with the world.
// - Positions are texture coordinates, (0, 0) the top left; sizes are frame heights; colors are
//   linear RGB.
// - `mask: World` leaves characters as they are (an impact frame that keeps them colored, lines
//   behind them); `Characters` covers them alone.
// - Every number is a starting point for art direction, not a measurement.
(
    type: "sapphire::world::EffectLibrary",
    version: 1,
    data: (
        presets: [
            (
                // A zoom blur from the middle of the frame: a dash, a heavy swing's weight.
                name: "radial_blur",
                layers: [
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.12),
                        envelope: Pulse(attack: 0.02, hold: 0.08, release: 0.35),
                    ),
                ],
            ),
            (
                // An RGB split pulse: the frame shudders as a hit lands.
                name: "chromatic_aberration",
                layers: [
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.06),
                        envelope: Pulse(hold: 0.05, release: 0.3),
                    ),
                ],
            ),
            (
                // A negative flash, three frames long.
                name: "inversion",
                layers: [
                    (
                        inversion: (amount: 1.0),
                        envelope: Keys([(0.0, 1.0), (0.05, 1.0)]),
                        clock: Real,
                    ),
                ],
            ),
            (
                // The two-tone impact frame: the world in ink and paper for four frames, the
                // characters kept in their colors.
                name: "duotone",
                layers: [
                    (
                        duotone: (
                            dark: (0.005, 0.004, 0.012),
                            light: (1.0, 0.95, 0.85),
                            threshold: 0.45,
                            softness: 0.04,
                            mask: World,
                        ),
                        envelope: Keys([(0.0, 1.0), (0.067, 1.0)]),
                        clock: Real,
                    ),
                ],
            ),
            (
                // Focus lines behind the characters, redrawn fifteen times a second: a charge,
                // an ultimate's wind-up.
                name: "speed_lines",
                layers: [
                    (
                        speed_lines: (
                            opacity: 0.85,
                            count: 120,
                            width: 0.35,
                            inner_radius: 0.32,
                            spread: 0.25,
                            color: (1.0, 1.0, 1.0),
                            rate: 15.0,
                            mask: World,
                        ),
                        envelope: Pulse(attack: 0.05, hold: 0.6, release: 0.25),
                    ),
                ],
            ),
            (
                // A heavy hit: six frames of a two-tone world with the characters in color, ink
                // focus lines, and a blur and an RGB split that fade out after the flash.
                name: "impact_frame",
                layers: [
                    (
                        duotone: (
                            dark: (0.005, 0.004, 0.012),
                            light: (1.0, 0.95, 0.85),
                            threshold: 0.45,
                            softness: 0.04,
                            mask: World,
                        ),
                        envelope: Keys([(0.0, 1.0), (0.1, 1.0)]),
                        clock: Real,
                    ),
                    (
                        speed_lines: (
                            opacity: 1.0,
                            count: 140,
                            width: 0.4,
                            inner_radius: 0.3,
                            spread: 0.3,
                            color: (0.005, 0.004, 0.012),
                            rate: 20.0,
                            mask: World,
                        ),
                        envelope: Pulse(hold: 0.25, release: 0.3),
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.1),
                        envelope: Pulse(hold: 0.1, release: 0.4),
                    ),
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.04),
                        envelope: Pulse(hold: 0.1, release: 0.3),
                    ),
                ],
            ),
            // Combat's (M2 E3), each pushed by `sapphire_cues` at the hit's point on screen, which
            // takes the place of the centers here. A step up in weight adds a kind of effect, so the
            // eye learns the grammar: a light hit shudders; a medium one pulls in as well; a heavy
            // one takes the world to ink for its first frames; a poise break flashes as well; a
            // finish holds. Impact frames are on `Real`, in frames (1/60 s).
            //
            // The ink is dark, not paper: with its threshold high, most of a sunlit town falls below
            // it, so a character in color and a spark's light stand out against it, where a world of
            // paper floods the frame with its brightest tone. Blurs and splits stay small and brief,
            // since they cover characters too, and a hit you can't read the fighter through is worse
            // than a quiet one.
            (
                // Barely there, so a string of them doesn't tire: a split a few frames long.
                name: "light_hit",
                layers: [
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.005),
                        envelope: Pulse(hold: 0.033, release: 0.08),
                    ),
                ],
            ),
            (
                // A pull toward the hit, and a heavier split.
                name: "medium_hit",
                layers: [
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.008),
                        envelope: Pulse(hold: 0.05, release: 0.12),
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.012),
                        envelope: Pulse(hold: 0.033, release: 0.1),
                    ),
                ],
            ),
            (
                // Three frames of ink behind characters kept in their colors, then pale lines and a
                // blur fading through the rest of its hitstop.
                name: "heavy_hit",
                layers: [
                    (
                        duotone: (
                            dark: (0.012, 0.012, 0.035),
                            light: (0.95, 0.9, 0.82),
                            threshold: 0.74,
                            softness: 0.04,
                            mask: World,
                        ),
                        envelope: Keys([(0.0, 1.0), (0.05, 1.0)]),
                        clock: Real,
                    ),
                    (
                        speed_lines: (
                            opacity: 0.75,
                            count: 90,
                            width: 0.3,
                            inner_radius: 0.36,
                            spread: 0.28,
                            color: (1.0, 0.96, 0.88),
                            rate: 20.0,
                            mask: World,
                        ),
                        envelope: Pulse(hold: 0.08, release: 0.1),
                        clock: Real,
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.018),
                        envelope: Pulse(hold: 0.05, release: 0.12),
                    ),
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.01),
                        envelope: Pulse(hold: 0.067, release: 0.12),
                    ),
                ],
            ),
            (
                // A guard giving way: ink gone warm, the lines bursting from the point of the break, and
                // a frame of negative on the characters, which keep their colors otherwise.
                name: "poise_break",
                layers: [
                    (
                        duotone: (
                            dark: (0.035, 0.008, 0.012),
                            light: (1.0, 0.68, 0.36),
                            threshold: 0.72,
                            softness: 0.05,
                            mask: World,
                        ),
                        envelope: Keys([(0.0, 1.0), (0.1, 1.0)]),
                        clock: Real,
                    ),
                    (
                        inversion: (amount: 1.0, mask: Characters),
                        envelope: Keys([(0.0, 1.0), (0.017, 1.0)]),
                        clock: Real,
                    ),
                    (
                        speed_lines: (
                            opacity: 0.85,
                            count: 110,
                            width: 0.34,
                            inner_radius: 0.3,
                            spread: 0.3,
                            color: (1.0, 0.86, 0.62),
                            rate: 20.0,
                            mask: World,
                        ),
                        envelope: Pulse(hold: 0.12, release: 0.14),
                        clock: Real,
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.024),
                        envelope: Pulse(hold: 0.07, release: 0.16),
                    ),
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.012),
                        envelope: Pulse(hold: 0.08, release: 0.16),
                    ),
                ],
            ),
            (
                // The last blow: the world in ink and paper for as long as a freeze lasts, the lines
                // redrawn across it, and a slow fall back into color.
                name: "finish",
                layers: [
                    (
                        duotone: (
                            dark: (0.008, 0.006, 0.02),
                            light: (0.98, 0.93, 0.84),
                            threshold: 0.7,
                            softness: 0.03,
                            mask: World,
                        ),
                        envelope: Keys([(0.0, 1.0), (0.3, 1.0), (0.3, 0.8), (0.7, 0.0)]),
                        clock: Real,
                    ),
                    (
                        speed_lines: (
                            opacity: 0.95,
                            count: 130,
                            width: 0.4,
                            inner_radius: 0.26,
                            spread: 0.32,
                            color: (0.98, 0.94, 0.86),
                            rate: 15.0,
                            mask: World,
                        ),
                        envelope: Pulse(hold: 0.3, release: 0.3),
                        clock: Real,
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.03),
                        envelope: Pulse(hold: 0.1, release: 0.4),
                        clock: Real,
                    ),
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.014),
                        envelope: Pulse(hold: 0.13, release: 0.35),
                        clock: Real,
                    ),
                ],
            ),
            (
                // Time drawn out: the world drained of its color and cooled behind characters kept in
                // theirs (M5 L9), with thin lines rushing past, held on real time as long as slow motion
                // usually runs. Its light stays, but its reds turn grey, so it counts as a flash.
                name: "perfect_dodge",
                layers: [
                    (
                        desaturation: (amount: 0.85, tint: (0.78, 0.88, 1.0), mask: World),
                        envelope: Pulse(attack: 0.05, hold: 0.45, release: 0.25),
                        clock: Real,
                    ),
                    (
                        speed_lines: (
                            opacity: 0.35,
                            count: 80,
                            width: 0.2,
                            inner_radius: 0.4,
                            spread: 0.3,
                            color: (0.85, 0.95, 1.0),
                            rate: 12.0,
                            mask: World,
                        ),
                        envelope: Pulse(attack: 0.03, hold: 0.4, release: 0.2),
                        clock: Real,
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.02),
                        envelope: Pulse(hold: 0.03, release: 0.25),
                        clock: Real,
                    ),
                ],
            ),
            (
                // A skill beginning, before anything lands: a quick pull inward and thin lines, gone
                // before the blow, so the ink stays the hit's own.
                name: "skill_flash",
                layers: [
                    (
                        speed_lines: (
                            opacity: 0.3,
                            count: 70,
                            width: 0.2,
                            inner_radius: 0.5,
                            spread: 0.3,
                            color: (1.0, 0.95, 0.85),
                            rate: 14.0,
                            mask: World,
                        ),
                        envelope: Pulse(attack: 0.017, hold: 0.05, release: 0.12),
                    ),
                    (
                        radial_blur: (center: (0.5, 0.5), strength: 0.012),
                        envelope: Pulse(hold: 0.02, release: 0.12),
                    ),
                    (
                        chromatic_aberration: (center: (0.5, 0.5), strength: 0.005),
                        envelope: Pulse(hold: 0.033, release: 0.1),
                    ),
                ],
            ),
            // The effects pack (M5 L9): a sample of each, then the game's. A flash, a glitch and a
            // desaturation (whose reds turn grey) are full-screen flashes to the cue dispatcher, as an
            // inversion and a duotone are; the halftone and the CRT are looks, which fade in over tenths
            // of a second.
            (
                // The world in grey behind characters kept in their colors.
                name: "desaturation",
                layers: [
                    (
                        desaturation: (amount: 1.0, tint: (1.0, 1.0, 1.0), mask: World),
                        envelope: Pulse(attack: 0.05, hold: 0.5, release: 0.3),
                    ),
                ],
            ),
            (
                // A comic print's screen over the world's shadows, the characters left clean.
                name: "halftone",
                layers: [
                    (
                        halftone: (
                            amount: 0.9,
                            cell: 0.012,
                            angle_degrees: 45.0,
                            ink: (0.01, 0.01, 0.03),
                            mask: World,
                        ),
                        envelope: Pulse(attack: 0.1, hold: 0.5, release: 0.2),
                    ),
                ],
            ),
            (
                // A warm white burst, two frames full, then falling away.
                name: "flash",
                layers: [
                    (
                        flash: (amount: 0.85, color: (1.0, 0.96, 0.88)),
                        envelope: Keys([(0.0, 1.0), (0.033, 1.0), (0.25, 0.0)]),
                        clock: Real,
                    ),
                ],
            ),
            (
                // A signal breaking up: bands torn sideways and the colors read apart, jumping twelve
                // times a second.
                name: "glitch",
                layers: [
                    (
                        glitch: (bands: 24, share: 0.3, shift: 0.04, split: 0.004, rate: 12.0),
                        envelope: Keys([(0.0, 1.0), (0.2, 1.0)]),
                        clock: Real,
                    ),
                ],
            ),
            (
                // The frame on an old television: scanlines, the grille's stripes, rounded corners.
                name: "crt",
                layers: [
                    (
                        crt: (lines: 240.0, depth: 0.35, grille: 0.15, corner: 0.05),
                        envelope: Pulse(attack: 0.15, hold: 0.8, release: 0.3),
                    ),
                ],
            ),
            (
                // The ultimate's sword rising and held (its timeline's cue): the world printed in ink
                // dots behind the character, a comic panel, gone as the blade comes down. On real time,
                // since the ultimate slows the world to a fifth.
                name: "ultimate_raise",
                layers: [
                    (
                        halftone: (
                            amount: 0.75,
                            cell: 0.011,
                            angle_degrees: 30.0,
                            ink: (0.01, 0.012, 0.04),
                            mask: World,
                        ),
                        envelope: Pulse(attack: 0.3, hold: 0.32, release: 0.1),
                        clock: Real,
                    ),
                ],
            ),
            (
                // The ultimate's chop (its timeline's cue): the world burnt white behind the character,
                // falling away with the landing.
                name: "ultimate_chop",
                layers: [
                    (
                        flash: (amount: 0.7, color: (1.0, 0.96, 0.88), mask: World),
                        envelope: Keys([(0.0, 1.0), (0.05, 1.0), (0.35, 0.0)]),
                        clock: Real,
                    ),
                ],
            ),
            (
                // A boss crossing into a named phase: the picture tears for a fifth of a second, and the
                // television's lines fade out after it, Zenless Zone Zero's broadcast look.
                name: "phase_shift",
                layers: [
                    (
                        glitch: (bands: 18, share: 0.35, shift: 0.05, split: 0.006, rate: 15.0),
                        envelope: Keys([(0.0, 1.0), (0.2, 1.0)]),
                        clock: Real,
                    ),
                    (
                        crt: (lines: 240.0, depth: 0.4, grille: 0.2, corner: 0.05),
                        envelope: Pulse(attack: 0.05, hold: 0.2, release: 0.45),
                        clock: Real,
                    ),
                ],
            ),
        ],
    ),
)
