// The court's gate cutscene, the first of `ward-court`'s timelines, half a second in, with the player
// standing at the checkpoint and the warrior not yet near, and the fight after it to the warrior's defeat or
// near it. Only the scripts go by this tick: a game plays the gate from its flow's beat (M3 G1), when the
// court's encounter starts.
(
    type: "sapphire::gameplay::InputsDocument",
    version: 1,
    data: (
        about: "`ward-court-watched`, skipped 3.1 s in: it must reach all the same checksums",
        ticks: 1200,
        like: "fight-back",
        commands: [
            (30, PlayTimeline(0)),
            (30, SkipTimeline(at_ms: 3100)),
        ],
    ),
)
