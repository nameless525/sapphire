// What `settings.ui.ron`'s paths can read, generated from `game_ui::menus::SettingsModel`, which a test holds
// this to. A cook refuses a path that isn't here.
(
    type: "sapphire::assets::UiModel",
    version: 1,
    data: (
        fields: [
            (path: "language", kind: Text),
            (path: "rumble", kind: Text),
            (path: "size", kind: Text),
            (path: "sound", kind: Number),
        ],
    ),
)
