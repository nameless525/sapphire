// The combat slice's moves for tests: frame data plausible for Zenless Zone Zero's rhythm, in 60 Hz
// ticks, with motion keyed by hand. The real moves are in content/combat/ (M2 O3, O4), and the older
// scenarios stay on these. A press reaches a moving frame the tick after it lands; attacks commit for
// a third of a second; a dodge's i-frames last nearly a quarter of a second, the first 100 ms of them
// perfect, and a swing dodged in those slows the world and opens a counter.
// A light hit freezes both fighters for 50 ms and a heavy one for 167; a poise meter takes about seven
// light hits or two heavy ones to break, and its break is a second and a half to punish.
(
    type: "sapphire::moves::MoveSetDocument",
    version: 1,
    data: (
        intents: [
            // A dodge beats a skill beats an attack when two could fire at one instant.
            (name: "light", button: Light, buffer: 12, priority: 1),
            (name: "heavy", button: Heavy, buffer: 10, priority: 1),
            (name: "spin", button: Ultimate, buffer: 10, priority: 2),
            (name: "skill", button: Skill, buffer: 10, priority: 2),
            (name: "dodge", button: Dodge, buffer: 8, priority: 3),
        ],
        neutral: [
            (intent: "light", move: "light_1"),
            (intent: "heavy", move: "heavy"),
            (intent: "spin", move: "spin"),
            (intent: "skill", move: "skill"),
            (intent: "dodge", move: "dodge"),
        ],
        fighter: (
            health: 300,
            poise: 60,
            // Four seconds without a hit that takes poise, and the meter is full again.
            poise_refill: 240,
            hurtboxes: [
                (name: "body", offset: (0.0, 0.9, 0.0), shape: Capsule(radius: 0.35, length: 1.0)),
            ],
            reactions: (
                light: "flinch",
                medium: "stagger",
                heavy: "knockdown",
                poise_break: "dazed",
                defeat: "defeat",
            ),
        ),
        moves: [
            (
                // 433 ms. Quick to come out and quick to chain.
                name: "light_1",
                startup: 5,
                active: 3,
                recovery: 18,
                motion: (
                    root: [
                        (at: 5, offset: (0.0, 0.0, 0.18)),
                        (at: 8, offset: (0.0, 0.0, 0.62)),
                        (at: 14, offset: (0.0, 0.0, 0.7)),
                    ],
                    paths: [
                        (
                            name: "blade",
                            keys: [
                                (at: 0, offset: (0.5, 1.1, 0.2)),
                                (at: 5, offset: (0.7, 1.35, 0.5), rotation: (0.0, 0.3826834, 0.0, 0.9238795)),
                                (at: 8, offset: (-0.6, 1.0, 0.9), rotation: (0.0, -0.3826834, 0.0, 0.9238795)),
                                (at: 26, offset: (0.2, 0.9, 0.3)),
                            ],
                        ),
                    ],
                ),
                hitboxes: [
                    (
                        name: "light_1_hit",
                        from: 5,
                        to: 8,
                        path: "blade",
                        shape: Capsule(radius: 0.25, length: 0.9),
                        attack: (damage: 6, poise: 8, weight: Light, hitstop: 3, knockback: (distance: 0.25, ticks: 8)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 26, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 10, to: 24, allow: [
                        (intent: "light", move: "light_2"),
                        (intent: "skill", move: "skill"),
                    ]),
                ],
                cues: [
                    (name: "swing_windup", at: 0),
                    (name: "swing", at: 5),
                ],
            ),
            (
                // 500 ms.
                name: "light_2",
                startup: 6,
                active: 4,
                recovery: 20,
                motion: (
                    root: [
                        (at: 6, offset: (0.0, 0.0, 0.2)),
                        (at: 10, offset: (0.0, 0.0, 0.85)),
                        (at: 16, offset: (0.0, 0.0, 0.95)),
                    ],
                    paths: [
