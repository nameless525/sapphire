                parent: "dodge",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.dodge")],
                ),
            ),
            (
                name: "skill",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "dodge",
                    down: "ultimate",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "skill-text",
                parent: "skill",
                text: (
                    key: "remap-action-skill",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "skill-value",
                parent: "skill",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.skill")],
                ),
            ),
            (
                name: "ultimate",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "skill",
                    down: "swap",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "ultimate-text",
                parent: "ultimate",
                text: (
                    key: "remap-action-ultimate",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "ultimate-value",
                parent: "ultimate",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.ultimate")],
                ),
            ),
            (
                name: "swap",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "ultimate",
                    down: "lock-on",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "swap-text",
                parent: "swap",
                text: (
                    key: "remap-action-swap",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "swap-value",
                parent: "swap",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.swap")],
                ),
            ),
            (
                name: "lock-on",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "swap",
                    down: "jump",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "lock-on-text",
                parent: "lock-on",
                text: (
                    key: "remap-action-lock-on",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "lock-on-value",
                parent: "lock-on",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.lock_on")],
                ),
            ),
            (
                name: "jump",
                parent: "list",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: SpaceBetween,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "lock-on",
                    down: "reset",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Color((180, 204, 250, 255)),
                    ),
                ),
            ),
            (
                name: "jump-text",
                parent: "jump",
                text: (
                    key: "remap-action-jump",
                    style: "row",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "jump-value",
                parent: "jump",
                text: (
                    key: "remap-glyph",
                    style: "value",
                    color: (255, 192, 56, 255),
                    args: [(name: "glyph", path: "remap.gamepad.jump")],
                ),
            ),
            (
                name: "foot",
                parent: "panel",
                layout: (direction: Row, gap: 8, shrink: 0, padding: (left: 4, right: 4)),
            ),
            (
                name: "reset",
                parent: "foot",
                layout: (
                    direction: Row,
                    align: Center,
                    justify: Center,
                    gap: 16,
                    min_height: Points(48),
                    padding: (left: 16, right: 16, top: 4, bottom: 4),
                    shrink: 0,
                    grow: 1,
                ),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((36, 44, 92, 255))),
                focus: (
                    up: "jump",
                    right: "back",
                    focused: (
                        shape: Slice(sprite: Button, corner: 8),
                        fill: Gradient(from: (64, 104, 196, 255), to: (116, 68, 188, 255), angle: 0),
                        outline: (color: (230, 240, 255, 255), width: 2),
                    ),
                    pressed: (
