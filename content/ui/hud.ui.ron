// What the HUD says in words (M3 U7): names, the objective, a pause for what has no key to press, and a
// cutscene's subtitles (M3 Q4). Its bars, buttons and numbers animate every frame, and `sapphire_ui::CombatHud`
// draws those.
(
    type: "sapphire::assets::UiDocument",
    version: 2,
    data: (
        model: "hud.model.ron",
        styles: [
            (name: "name", role: "body", size: 16, weight: 700),
            (name: "small", role: "body", size: 14, weight: 700),
            (name: "banner", role: "display", size: 32, weight: 700),
            (name: "subtitle", role: "body", size: 20, weight: 500, line_height: 1.4),
            (name: "speaker", role: "body", size: 16, weight: 700),
        ],
        nodes: [
            (
                name: "root",
                layout: (safe_area: true),
            ),
            (
                name: "player",
                parent: "root",
                layout: (anchored: (left: Points(16), top: Points(76)), direction: Row, align: Center, gap: 8),
                binds: [(to: Opacity, path: "fight_words")],
            ),
            (
                name: "player-name",
                parent: "player",
                text: (
                    key: "character-name-wanderer",
                    style: "name",
                    color: (240, 246, 255, 255),
                    key_from: (path: "player", prefix: "character-name-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "player-level",
                parent: "player",
                text: (
                    key: "hud-level",
                    style: "name",
                    color: (255, 192, 56, 255),
                    args: [(name: "level", path: "level")],
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "enemy",
                parent: "root",
                layout: (anchored: (left: Points(0), right: Points(0), top: Points(58)), direction: Column, align: Center),
                binds: [(to: Shown, path: "has_enemy"), (to: Opacity, path: "fight_words")],
            ),
            (
                name: "enemy-name",
                parent: "enemy",
                binds: [(to: Shown, path: "names_enemy")],
                text: (
                    key: "enemy-warrior",
                    style: "name",
                    color: (240, 246, 255, 255),
                    key_from: (path: "enemy", prefix: "enemy-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            // A boss's bar is named by its kind of enemy (M3 Z3e), in the enemy's name's place.
            (
                name: "boss-name",
                parent: "enemy",
                binds: [(to: Shown, path: "has_boss")],
                text: (
                    key: "boss-captain",
                    style: "name",
                    color: (240, 246, 255, 255),
                    key_from: (path: "boss", prefix: "boss-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "objective",
                parent: "root",
                layout: (anchored: (right: Points(16), top: Points(64)), direction: Column, align: End, gap: 2, max_width: Percent(38)),
                binds: [(to: Shown, path: "has_objective"), (to: Opacity, path: "fight_words")],
            ),
            (
                name: "objective-label",
                parent: "objective",
                text: (
                    key: "hud-objective",
                    style: "small",
                    color: (255, 192, 56, 255),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "objective-text",
                parent: "objective",
                text: (
                    key: "hud-objective-arena",
                    style: "name",
                    color: (240, 246, 255, 255),
                    key_from: (path: "objective", prefix: "hud-objective-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            // The corner's buttons, for a finger or a pointer: a cutscene's way out, and the pause.
            (
                name: "corner",
                parent: "root",
                layout: (anchored: (right: Points(16), top: Points(14)), direction: Row, align: Center, gap: 8),
            ),
            (
                name: "skip",
                parent: "corner",
                layout: (direction: Row, align: Center, justify: Center, min_width: Points(72), height: Points(44), padding: (left: 12, right: 12)),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((9, 12, 20, 235)), outline: (color: (226, 234, 240, 255), width: 1.5)),
                binds: [(to: Shown, path: "can_skip")],
                focus: (pressed: (shape: Slice(sprite: Button, corner: 8), fill: Color((180, 204, 250, 255)))),
            ),
            (
                name: "skip-text",
                parent: "skip",
                text: (
                    key: "hud-skip",
                    style: "small",
                    color: (240, 246, 255, 255),
                ),
            ),
            (
                name: "pause",
                parent: "corner",
                layout: (direction: Row, align: Center, justify: Center, min_width: Points(72), height: Points(44), padding: (left: 12, right: 12)),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((9, 12, 20, 235)), outline: (color: (226, 234, 240, 255), width: 1.5)),
                binds: [(to: Shown, path: "touch")],
                focus: (pressed: (shape: Slice(sprite: Button, corner: 8), fill: Color((180, 204, 250, 255)))),
            ),
            (
                name: "pause-text",
                parent: "pause",
                text: (
                    key: "hud-pause",
                    style: "small",
                    color: (240, 246, 255, 255),
                ),
            ),
            // What the flow says for a moment: a checkpoint reached, a victory, a defeat.
            (
                name: "banner",
                parent: "root",
                layout: (anchored: (left: Points(0), right: Points(0), top: Points(120)), direction: Column, align: Center),
                binds: [(to: Shown, path: "has_banner")],
            ),
            (
                name: "banner-band",
                parent: "banner",
                layout: (direction: Row, align: Center, justify: Center, padding: (left: 32, right: 32, top: 6, bottom: 6)),
                look: (fill: Color((9, 12, 20, 170))),
            ),
            (
                name: "banner-text",
                parent: "banner-band",
                text: (
                    key: "hud-banner-checkpoint",
                    style: "banner",
                    color: (255, 224, 150, 255),
                    key_from: (path: "banner", prefix: "hud-banner-"),
                    shadow: (color: (0, 0, 0, 235), offset: (2, 2)),
                ),
            ),
            // What a cutscene or a fight's voice says (M3 Q4, M4 A2): who speaks and the line, low and centered,
            // on a band that keeps it readable over the ward's white plaster. Its timeline's subtitles, or the
            // fight's line, choose both keys, and the player's settings their size and the band: as authored, a
            // fainter one, none, or an opaque one under it.
            (
                name: "subtitle",
                parent: "root",
                layout: (anchored: (left: Points(0), right: Points(0), bottom: Points(40)), direction: Column, align: Center, padding: (left: 24, right: 24)),
                binds: [(to: Shown, path: "has_subtitle")],
            ),
            (
                name: "subtitle-band",
                parent: "subtitle",
                layout: (direction: Column, align: Center, gap: 2, max_width: Points(880), padding: (left: 24, right: 24, top: 8, bottom: 10)),
            ),
            (
                name: "subtitle-solid",
                parent: "subtitle-band",
                layout: (anchored: (left: Points(0), right: Points(0), top: Points(0), bottom: Points(0))),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((9, 12, 20, 255))),
                binds: [(to: Shown, path: "subtitle_solid")],
            ),
            (
                name: "subtitle-box",
                parent: "subtitle-band",
                layout: (anchored: (left: Points(0), right: Points(0), top: Points(0), bottom: Points(0))),
                look: (shape: Slice(sprite: Button, corner: 8), fill: Color((9, 12, 20, 150))),
                binds: [(to: Opacity, path: "subtitle_band")],
            ),
            // A fight's line said before the newest and still up (M4 A8), above it on the same band: lines said
            // together stack rather than one hiding the other.
            (
                name: "subtitle-earlier-speaker",
                parent: "subtitle-band",
                binds: [(to: Shown, path: "has_earlier_speaker"), (to: TextScale, path: "subtitle_scale")],
                text: (
                    key: "speaker-wanderer",
                    style: "speaker",
                    color: (255, 192, 56, 255),
                    key_from: (path: "earlier_speaker", prefix: "speaker-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "subtitle-earlier",
                parent: "subtitle-band",
                layout: (shrink: 0),
                binds: [(to: Shown, path: "has_earlier"), (to: TextScale, path: "subtitle_scale")],
                text: (
                    key: "subtitle-perfect-dodge",
                    style: "subtitle",
                    color: (240, 246, 255, 255),
                    wrap: true,
                    key_from: (path: "earlier", prefix: "subtitle-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "subtitle-speaker",
                parent: "subtitle-band",
                binds: [(to: Shown, path: "has_speaker"), (to: TextScale, path: "subtitle_scale")],
                text: (
                    key: "speaker-wanderer",
                    style: "speaker",
                    color: (255, 192, 56, 255),
                    key_from: (path: "speaker", prefix: "speaker-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
            (
                name: "subtitle-line",
                parent: "subtitle-band",
                layout: (shrink: 0),
                binds: [(to: TextScale, path: "subtitle_scale")],
                text: (
                    key: "subtitle-court-gate-quiet",
                    style: "subtitle",
                    color: (240, 246, 255, 255),
                    wrap: true,
                    key_from: (path: "subtitle", prefix: "subtitle-"),
                    shadow: (color: (0, 0, 0, 235), offset: (1, 1)),
                ),
            ),
        ],
    ),
)
