// A VRM character's sidecar as it starts (M6 C5): what `new-character`, and a cook meeting a new .vrm,
// copy into its sidecar. The mesh settings are the cook's own, which are a character's: levels at a
// half, a quarter and an eighth of the triangles, within 4 mm, 2 cm and 6 cm on a 2 m figure, the
// phones starting at the first. `check` holds it to the hero row of spec §3.4; `new-character --role`
// casts it otherwise. A sidecar keeps what it was given: editing this changes only sidecars made after.
(
    type: "sapphire::pipeline::ImportPreset",
    version: 1,
    data: (
        importer: Vrm((
            mesh: (
                outline: (
                    weld_tolerance: 0.0001,
                ),
                lods: (
                    levels: [
                        (
                            triangle_ratio: 0.5,
                            max_error: 0.002,
                        ),
                        (
                            triangle_ratio: 0.25,
                            max_error: 0.01,
                        ),
                        (
                            triangle_ratio: 0.125,
                            max_error: 0.03,
                        ),
                    ],
                    mobile_skip: 1,
                ),
                position_format: Unorm16,
                materials: {},
            ),
            version: None,
        )),
        budget: (
            role: Hero,
        ),
    ),
)
