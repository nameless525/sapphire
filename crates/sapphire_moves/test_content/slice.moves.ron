                        from: 4,
                        to: 8,
                        path: "blade",
                        shape: Capsule(radius: 0.3, length: 1.0),
                        attack: (damage: 10, poise: 12, weight: Medium, hitstop: 5, knockback: (distance: 0.5, ticks: 10)),
                    ),
                ],
                cancels: [
                    (from: 2, to: 28, allow: [(intent: "dodge", move: "dodge")]),
                    (from: 18, to: 28, allow: [(intent: "light", move: "light_1")]),
                ],
                warps: [
                    (from: 0, to: 8, max_distance: 2.0, max_turn: 1.2, keep: 1.1),
