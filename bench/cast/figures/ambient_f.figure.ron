// An ambient figure of the benchmark's crowd (M5 B3): a scholar in indigo with wide sleeves, a tall black hat and a scroll under one arm. One material, at the
// crowd's row of about 3,000 triangles.
// It lists no joints: it shares `ambient_a`'s skeleton (`skeleton` in `bench/cast/cast.ron`), so one
// pose serves the crowd.
// Metres, +Y up, facing +Z, its left toward +X, in a T-pose. The cast writes it under its own folder,
// so `dir` is replaced.
(
    type: "sapphire::pipeline::Figure",
    version: 2,
    data: (
        dir: "cast/ambient_f",
        name: "ambient_f",
        max_triangles: 3200,
        maps: Some((size: 256, grain: 0.04)),
        joints: [],
        regions: [
            (name: "skin", albedo: [(0.0, "#f8e8dc"), (1.0, "#e0c4b0")], specular: 0.15, specular_size: 0.3),
            (name: "hair", albedo: [(0.0, "#3a3640"), (1.0, "#141218")], specular: 0.35, specular_size: 0.4),
            (name: "gown", albedo: [(0.0, "#3a4a9a"), (1.0, "#161c48")], shadow_bias: 0.55),
            (name: "hat", albedo: [(0.0, "#3a3a44"), (1.0, "#0c0c12")], specular: 0.5, specular_size: 0.5),
            (name: "gold", albedo: [(0.0, "#f6e2a2"), (1.0, "#a07c30")], specular: 1.0, specular_size: 0.8, matcap: 1.0),
            (name: "paper", albedo: [(0.0, "#f8f2e0"), (1.0, "#cab894")]),
        ],
        shapes: [
            // The head, the torso, arms and hands, legs and feet.
            Loft((
                region: "skin", bones: ["head"], sides: 26,
                from: (0.0, 1.25, 0.01), to: (0.0, 1.46, 0.01),
                rings: [(at: 0.0, radius: (0.04, 0.045)), (at: 0.15, radius: (0.068, 0.078), shift: (0.0, -0.01)), (at: 0.45, radius: (0.086, 0.098), shift: (0.0, -0.01)), (at: 0.75, radius: (0.083, 0.094), shift: (0.0, -0.005)), (at: 0.95, radius: (0.05, 0.055)), (at: 1.0, radius: (0.012, 0.012))],
            )),
            Loft((
                region: "gown", bones: ["hips", "spine", "chest"], sides: 28, blend: 0.06, v: (0.9, 0.1),
                from: (0.0, 0.8, 0.0), to: (0.0, 1.22, 0.0),
                rings: [(at: 0.0, radius: (0.13, 0.1)), (at: 0.2, radius: (0.114, 0.086)), (at: 0.55, radius: (0.136, 0.094)), (at: 0.8, radius: (0.148, 0.094)), (at: 0.93, radius: (0.12, 0.08)), (at: 1.0, radius: (0.07, 0.065))],
            )),
            Loft((
                region: "gown", bones: ["upperarm.l", "lowerarm.l"], sides: 22, blend: 0.05, mirror: true,
                from: (0.14, 1.2, -0.01), to: (0.42, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.052, 0.052)), (at: 1.0, radius: (0.042, 0.044))],
            )),
            Loft((
                region: "gown", bones: ["lowerarm.l", "wrist.l"], sides: 22, mirror: true,
                from: (0.41, 1.2, -0.01), to: (0.635, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.042, 0.044)), (at: 1.0, radius: (0.034, 0.034))],
            )),
            Loft((
                region: "skin", bones: ["wrist.l", "hand.l"], sides: 8, mirror: true,
                from: (0.625, 1.2, -0.01), to: (0.765, 1.2, 0.0),
                rings: [(at: 0.0, radius: (0.03, 0.028)), (at: 0.45, radius: (0.04, 0.032)), (at: 1.0, radius: (0.026, 0.024))],
            )),
            Loft((
                region: "gown", bones: ["upperleg.l", "lowerleg.l"], sides: 22, mirror: true,
                from: (0.085, 0.82, 0.0), to: (0.085, 0.43, 0.01),
                rings: [(at: 0.0, radius: (0.078, 0.078)), (at: 0.5, radius: (0.064, 0.064)), (at: 1.0, radius: (0.05, 0.052))],
            )),
            Loft((
                region: "gown", bones: ["lowerleg.l", "foot.l"], sides: 22, mirror: true,
                from: (0.085, 0.43, 0.01), to: (0.085, 0.08, -0.005),
                rings: [(at: 0.0, radius: (0.05, 0.052)), (at: 0.4, radius: (0.048, 0.05)), (at: 1.0, radius: (0.04, 0.042))],
            )),
            Loft((
                region: "hat", bones: ["foot.l", "toes.l"], sides: 22, mirror: true, v: (0.4, 0.9),
                from: (0.085, 0.055, -0.06), to: (0.085, 0.03, 0.16),
                rings: [(at: 0.0, radius: (0.042, 0.055)), (at: 0.3, radius: (0.05, 0.05)), (at: 0.8, radius: (0.04, 0.035)), (at: 1.0, radius: (0.02, 0.015))],
            )),
            Loft((
                region: "hair", bones: ["head"], sides: 12, arc: Some((-15.0, 195.0)), thickness: 0.02,
                from: (0.0, 1.3, 0.0), to: (0.0, 1.47, 0.0),
                rings: [(at: 0.0, radius: (0.08, 0.09)), (at: 0.4, radius: (0.096, 0.108)), (at: 0.8, radius: (0.09, 0.1)), (at: 1.0, radius: (0.06, 0.065))],
            )),
            // The gown's skirt, wide sleeves with gold cuffs, the hat and the scroll.
            Loft((
                region: "gown", bones: ["hips", "upperleg.l", "upperleg.r", "lowerleg.l", "lowerleg.r"], sides: 18, blend: 0.1, v: (0.2, 1.0), thickness: 0.01,
                from: (0.0, 0.86, 0.0), to: (0.0, 0.06, 0.0),
                rings: [(at: 0.0, radius: (0.14, 0.11)), (at: 0.5, radius: (0.19, 0.16)), (at: 1.0, radius: (0.23, 0.2))],
            )),
            Loft((
                region: "gown", bones: ["upperarm.l", "lowerarm.l"], sides: 14, blend: 0.06, mirror: true, thickness: 0.01,
                from: (0.16, 1.2, -0.01), to: (0.52, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.066, 0.066)), (at: 0.6, radius: (0.11, 0.12), shift: (0.0, 0.02)), (at: 1.0, radius: (0.14, 0.16), shift: (0.0, 0.04))],
            )),
            Loft((
                region: "gold", bones: ["lowerarm.l"], sides: 14, mirror: true, thickness: 0.012,
                from: (0.515, 1.2, -0.01), to: (0.53, 1.2, -0.01),
                rings: [(at: 0.0, radius: (0.142, 0.162), shift: (0.0, 0.04)), (at: 1.0, radius: (0.143, 0.163), shift: (0.0, 0.04))],
            )),
            Loft((
                region: "hat", bones: ["head"], sides: 16, faceted: true,
                from: (0.0, 1.4, 0.0), to: (0.0, 1.66, -0.01),
                rings: [(at: 0.0, radius: (0.1, 0.11)), (at: 0.15, radius: (0.092, 0.1)), (at: 1.0, radius: (0.08, 0.085))],
            )),
            Loft((
                region: "gold", bones: ["head"], sides: 16,
                from: (0.0, 1.43, 0.0), to: (0.0, 1.45, 0.0),
                rings: [(at: 0.0, radius: (0.101, 0.111)), (at: 1.0, radius: (0.098, 0.108))],
            )),
            Loft((
                region: "paper", bones: ["upperarm.l", "chest"], sides: 12, blend: 0.08,
                from: (0.2, 1.08, -0.18), to: (0.2, 1.08, 0.18),
                rings: [(at: 0.0, radius: (0.03, 0.03)), (at: 1.0, radius: (0.03, 0.03))],
            )),
        ],
    ),
)
