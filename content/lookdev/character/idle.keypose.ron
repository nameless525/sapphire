            }),

            // A smaller breath, looking back toward the middle.
            (tick: 190, hips: (-0.027, -0.003, 0), pose: {
                Spine: (x: 0.7, z: 2.7),
                UpperChest: (x: -2, z: 1),
                Head: (x: 2.6, y: -6, z: -2),
