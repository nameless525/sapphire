            (name: "wrist.r", parent: Some("lowerarm.r"), at: (-0.63, 1.2, -0.01)),
            (name: "hand.r", parent: Some("wrist.r"), at: (-0.68, 1.2, -0.01)),
            (name: "handslot.r", parent: Some("hand.r"), at: (-0.72, 1.2, 0.0), aim: Some((-0.72, 1.2, 1.0))),
            (name: "upperleg.l", parent: Some("hips"), at: (0.085, 0.78, 0.0)),
            (name: "lowerleg.l", parent: Some("upperleg.l"), at: (0.085, 0.43, 0.01)),
            (name: "foot.l", parent: Some("lowerleg.l"), at: (0.085, 0.075, -0.01)),
            (name: "toes.l", parent: Some("foot.l"), at: (0.085, 0.02, 0.11), aim: Some((0.085, 0.015, 0.17))),
            (name: "upperleg.r", parent: Some("hips"), at: (-0.085, 0.78, 0.0)),
            (name: "lowerleg.r", parent: Some("upperleg.r"), at: (-0.085, 0.43, 0.01)),
            (name: "foot.r", parent: Some("lowerleg.r"), at: (-0.085, 0.075, -0.01)),
            (name: "toes.r", parent: Some("foot.r"), at: (-0.085, 0.02, 0.11), aim: Some((-0.085, 0.015, 0.17))),
        ],
